#!/bin/bash
#PBS -N rgzacc
#PBS -l select=1:ncpus=1:mpiprocs=1
#PBS -l walltime=00:30:00
#PBS -j oe

cd /home/cychou/TLTM || exit 1
module load compiler/2025.3.0
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export QN_S1_PROBE_MAX_ITER=28
export QN_S1_NEAR_FULL_MAX_ITER=100
export QN_S1_NONNEAR_CHEAP_MAX_ITER=36
export QN_S1_NEAR_RESCUE_ENABLED=0
export QN_S1_NONNEAR_RESCUE_ENABLED=0
export QN_POST_NEWTON_REFINE_ENABLED=0
export QN_POST_NEWTON_REFINE_MAX_ITER=40
export QN_REVERSE_GATE_ENABLED=1
export QN_REVERSE_GATE_TOL=1e-8
export CONSTRAINT_FAIL_CAPTURE_START_SAMPLE=50
export CONSTRAINT_FAIL_CAPTURE_LIMIT=50
python3 scripts/run_stage3_3_multiseed.py --config docs/stage_3_4_t035_paired_5000.json --methods fb --max-seeds 1 --seed-offset 16 --output-subdir output/tests/stage3_4/single_seed_p28_reverse_gate_reject_cases_zacc/seed_20261973 --logs-subdir output/logs/stage3_4_single_seed_p28_reverse_gate_reject_cases_zacc/seed_20261973 --log-prefix stage3_4_t035_single_seed_p28_rg_reject_cases_zacc --report-title "TLTM Stage-3.4 Single Seed p28 Reverse Gate Reject Cases (zacc)" --skip-build
