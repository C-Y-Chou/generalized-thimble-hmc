#!/bin/bash
#PBS -N s34_1k_qn14
#PBS -q C8
#PBS -l select=1:ncpus=20:mpiprocs=20:mem=8gb
#PBS -l walltime=08:00:00
#PBS -o /lustre1/home/cychou/TLTM/output/logs/stage3_4_post_refine_fail_replay_capture/seed_batch10_1k_nt1e13_qn1e14.pbs.out
#PBS -e /lustre1/home/cychou/TLTM/output/logs/stage3_4_post_refine_fail_replay_capture/seed_batch10_1k_nt1e13_qn1e14.pbs.err

set -euo pipefail
module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OMP_PROC_BIND=true
export OMP_PLACES=cores
export CONSTRAINT_FAIL_CAPTURE_START_SAMPLE=2147483647

export TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE=1e-13
export QN_QUASI_TOL_OVERRIDE=1e-14
export QN_POST_NEWTON_REFINE_ENABLED=1
export QN_POST_NEWTON_REFINE_MAX_ITER=20
export QN_REVERSE_GATE_ENABLED=1
export QN_REVERSE_GATE_TOL=1e-8
export QN_S1_NEAR_RESCUE_ENABLED=0
export QN_S1_NONNEAR_RESCUE_ENABLED=0
export QN_QUASI_GLOBAL_FALLBACK_ENABLED=0

cd /lustre1/home/cychou/TLTM

OUT_SUBDIR="output/tests/stage3_4/post_refine_fail_replay_capture/seed_batch10_1k_nt1e13_qn1e14"
LOG_SUBDIR="output/logs/stage3_4_post_refine_fail_replay_capture/seed_batch10_1k_nt1e13_qn1e14"
rm -rf "${OUT_SUBDIR}" "${LOG_SUBDIR}"
mkdir -p "${LOG_SUBDIR}"

python3 run_stage3_3_multiseed.py \
  --repo-root . \
  --config docs/stage_3_4_t035_paired_1000.json \
  --methods fb \
  --max-seeds 10 \
  --output-subdir "${OUT_SUBDIR}" \
  --logs-subdir "${LOG_SUBDIR}" \
  --report-title "TLTM Stage-3.4 t=0.35 post_refine_fail_capture seed_batch10_1k nt1e13 qn1e14" \
  --schedule task \
  --task-method-order fb_first \
  --jobs 20 \
  --stage2-threads 1 \
  --eval-threads 1 \
  --skip-build
