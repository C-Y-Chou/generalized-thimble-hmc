#!/bin/bash
#PBS -N s34_preval_fbnr
#PBS -q C12
#PBS -l select=1:ncpus=12:mpiprocs=12:mem=16gb
#PBS -l walltime=04:00:00
#PBS -o /lustre1/home/cychou/TLTM/output/logs/stage3_4_preprod_validation/preprod_validation_20260508_10seed_10k_p28_rg_fb_norefine.pbs.out
#PBS -e /lustre1/home/cychou/TLTM/output/logs/stage3_4_preprod_validation/preprod_validation_20260508_10seed_10k_p28_rg_fb_norefine.pbs.err

set -euo pipefail

module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

cd /lustre1/home/cychou/TLTM

EXPECTED_BRANCH="codex/preprod-hardening"
EXPECTED_COMMIT="${TLTM_EXPECTED_GIT_COMMIT:?TLTM_EXPECTED_GIT_COMMIT is required}"
CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
CURRENT_COMMIT="$(git rev-parse HEAD)"
if [ "${CURRENT_BRANCH}" != "${EXPECTED_BRANCH}" ]; then
  echo "[ERROR] expected branch ${EXPECTED_BRANCH}, got ${CURRENT_BRANCH}" >&2
  exit 2
fi
if [ "${CURRENT_COMMIT}" != "${EXPECTED_COMMIT}" ]; then
  echo "[ERROR] expected commit ${EXPECTED_COMMIT}, got ${CURRENT_COMMIT}" >&2
  exit 2
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "[ERROR] working tree is dirty; refusing validation run" >&2
  git status --short >&2
  exit 2
fi

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OMP_PROC_BIND=true
export OMP_PLACES=cores
export CONSTRAINT_FAIL_CAPTURE_START_SAMPLE=2147483647

export TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE=1e-13
export QN_REVERSE_GATE_ENABLED=1
export QN_REVERSE_GATE_TOL=1e-8
export QN_S1_PROBE_MAX_ITER=28
export QN_S1_NEAR_RESCUE_ENABLED=0
export QN_S1_NONNEAR_RESCUE_ENABLED=0
export QN_QUASI_GLOBAL_FALLBACK_ENABLED=0
export QN_QUASI_TOL_OVERRIDE=1e-13

OUT_SUBDIR="output/tests/stage3_4/preprod_validation_20260508_10seed_10k_p28_rg_fb_norefine"
LOG_SUBDIR="output/logs/stage3_4_preprod_validation/preprod_validation_20260508_10seed_10k_p28_rg_fb_norefine"
rm -rf "${OUT_SUBDIR}" "${LOG_SUBDIR}"
mkdir -p "${LOG_SUBDIR}"

{
  echo "RUN_DATE=$(date -Is)"
  echo "RUNNER=codex"
  echo "GIT_BRANCH=${CURRENT_BRANCH}"
  echo "GIT_COMMIT=${CURRENT_COMMIT}"
  echo "CONFIG_JSON=docs/stage_3_4_t035_paired_10k_10seed.json"
  echo "METHODS=fb_norefine"
  echo "OUTPUT_SUBDIR=${OUT_SUBDIR}"
  echo "LOG_SUBDIR=${LOG_SUBDIR}"
  echo "TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE=${TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE}"
  echo "QN_REVERSE_GATE_ENABLED=${QN_REVERSE_GATE_ENABLED}"
  echo "QN_REVERSE_GATE_TOL=${QN_REVERSE_GATE_TOL}"
  echo "QN_S1_PROBE_MAX_ITER=${QN_S1_PROBE_MAX_ITER}"
  echo "QN_QUASI_TOL_OVERRIDE=${QN_QUASI_TOL_OVERRIDE}"
  echo "QN_POST_NEWTON_REFINE_ENABLED=0"
} > "${OUT_SUBDIR}.manifest.env"

python3 scripts/run_stage3_3_multiseed.py \
  --repo-root . \
  --config docs/stage_3_4_t035_paired_10k_10seed.json \
  --methods fb_norefine \
  --max-seeds 10 \
  --output-subdir "${OUT_SUBDIR}" \
  --logs-subdir "${LOG_SUBDIR}" \
  --log-prefix "s34_preprod_validation_20260508_p28_rg_fb_norefine" \
  --report-title "TLTM Stage-3.4 pre-production validation 10seed 10k p28 RG fb norefine" \
  --schedule paired \
  --pair-order fb_first \
  --jobs 10 \
  --stage2-threads 1 \
  --eval-threads 1 \
  --skip-build
