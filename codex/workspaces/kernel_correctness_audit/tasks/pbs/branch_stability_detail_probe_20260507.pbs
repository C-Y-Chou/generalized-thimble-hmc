#!/bin/bash
#PBS -N kbrdet
#PBS -q C8
#PBS -l select=1:ncpus=4:mpiprocs=4:mem=8gb
#PBS -l walltime=01:00:00
#PBS -o /lustre1/home/cychou/TLTM/output/logs/kernel_correctness_audit/branch_stability_detail_probe_20260507.pbs.out
#PBS -e /lustre1/home/cychou/TLTM/output/logs/kernel_correctness_audit/branch_stability_detail_probe_20260507.pbs.err

set -euo pipefail

module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OMP_PROC_BIND=true
export OMP_PLACES=cores

export QN_REVERSE_GATE_ENABLED=1
export QN_REVERSE_GATE_TOL=1e-8
export QN_S1_PROBE_MAX_ITER=28
export QN_S1_NEAR_RESCUE_ENABLED=0
export QN_S1_NONNEAR_RESCUE_ENABLED=0
export QN_QUASI_GLOBAL_FALLBACK_ENABLED=0
export QN_QUASI_TOL_OVERRIDE=1e-13
export QN_POST_NEWTON_REFINE_ENABLED=1
export QN_POST_NEWTON_REFINE_MAX_ITER=20
export CONSTRAINT_FAIL_CAPTURE_START_SAMPLE=2147483647

cd /lustre1/home/cychou/TLTM

TLTM_ROOT=$(pwd)
AUDIT_ROOT="output/tests/kernel_correctness_audit/branch_stability_detail_probe_20260507"
LOG_ROOT="output/logs/kernel_correctness_audit/branch_stability_detail_probe_20260507"
WORK_DIR="${AUDIT_ROOT}/work"

rm -rf "${AUDIT_ROOT}" "${LOG_ROOT}"
mkdir -p "${WORK_DIR}/data" "${LOG_ROOT}"

python3 - <<'PY'
from pathlib import Path

src = Path("data/parameters.dat")
dst = Path("output/tests/kernel_correctness_audit/branch_stability_detail_probe_20260507/work/data/parameters.dat")
updates = {
    "trajectory_length": "2",
    "integration_steps": "20",
    "initial_flow_time": "0.35",
    "constraint_tol": "1.0d-13",
    "enable_quasi_fallback": "true",
    "x_history_file": "./output/x_history.dat",
    "z_history_file": "./output/z_history.dat",
    "phi_history_file": "./output/phi_history.dat",
}
lines = []
seen = set()
for raw in src.read_text().splitlines():
    stripped = raw.strip()
    if "=" not in stripped or stripped.startswith("#"):
        lines.append(raw)
        continue
    key, _ = stripped.split("=", 1)
    key = key.strip()
    if key in updates:
        lines.append(f"{key} = {updates[key]}")
        seen.add(key)
    else:
        lines.append(raw)
for key, value in updates.items():
    if key not in seen:
        lines.append(f"{key} = {value}")
dst.write_text("\n".join(lines) + "\n")
PY

make -C build OMP=0 ../bin/probe_hmc_volume > "${LOG_ROOT}/build_probe_hmc_volume.log" 2>&1

for eps in 1e-5 1e-6 1e-7; do
  label=$(echo "${eps}" | sed 's/+//g; s/-/m/g; s/\./p/g')
  (
    cd "${WORK_DIR}"
    HMC_VOLUME_OUT_CSV="${TLTM_ROOT}/${AUDIT_ROOT}/branch_stability_eps_${label}.csv" \
    HMC_VOLUME_DETAIL_CSV="${TLTM_ROOT}/${AUDIT_ROOT}/branch_detail_eps_${label}.csv" \
    HMC_VOLUME_SAMPLE_LIMIT=300 \
    HMC_VOLUME_CANDIDATE_LIMIT=1200 \
    HMC_VOLUME_FD_EPS="${eps}" \
    HMC_VOLUME_FLOW_TIME=0.35 \
    HMC_VOLUME_Q_SPAN=1.5 \
    HMC_VOLUME_C_SPAN=1.0 \
    "${TLTM_ROOT}/bin/probe_hmc_volume" \
      > "${TLTM_ROOT}/${LOG_ROOT}/branch_stability_eps_${label}.out" \
      2> "${TLTM_ROOT}/${LOG_ROOT}/branch_stability_eps_${label}.err"
  )
done

python3 - <<'PY'
import csv
import json
import math
from collections import Counter, defaultdict
from pathlib import Path

root = Path("output/tests/kernel_correctness_audit/branch_stability_detail_probe_20260507")

counter_cols = [
    "newton_delta",
    "quasi_delta",
    "failed_delta",
    "post_refine_attempt_delta",
    "post_refine_skip_delta",
    "post_refine_success_delta",
    "post_refine_fail_delta",
    "rg_candidate_delta",
    "rg_pass_delta",
    "rg_reject_delta",
]

real_cols = ["q_in", "c_in", "raw_det", "metric_logvol", "q_out", "c_out", "jac_out_abs"]

def truth(row, key):
    return row.get(key) == "T"

def parse_main(path):
    rows = []
    with path.open(newline="") as fobj:
        reader = csv.DictReader(fobj)
        for row in reader:
            for key in ("case_idx", "attempt"):
                row[key] = int(row[key])
            for key in ("metric_logvol", "raw_logabsdet"):
                row[key] = float(row[key].replace("D", "E"))
            rows.append(row)
    return rows

def parse_detail(path):
    rows = []
    with path.open(newline="") as fobj:
        reader = csv.DictReader(fobj)
        for row in reader:
            for key in ("case_idx", "attempt"):
                row[key] = int(row[key])
            for key in counter_cols:
                row[key] = int(row[key])
            for key in real_cols:
                row[key] = float(row[key].replace("D", "E"))
            rows.append(row)
    return rows

summary = {}
detail_summary = {}
detail_examples = {}

for main_path in sorted(root.glob("branch_stability_eps_*.csv")):
    eps_label = main_path.stem.replace("branch_stability_eps_", "")
    rows = parse_main(main_path)
    fd_ok = [r for r in rows if truth(r, "fd_ok")]
    qn_fd = [r for r in fd_ok if truth(r, "base_used_quasi")]
    qn_weak = [r for r in qn_fd if truth(r, "branch_stable")]
    qn_strong = [r for r in qn_fd if truth(r, "strong_branch_stable")]
    qn_unstable = [r for r in qn_weak if not truth(r, "strong_branch_stable")]
    summary[eps_label] = {
        "rows": len(rows),
        "fd_ok": len(fd_ok),
        "qn_fd_ok": len(qn_fd),
        "qn_weak_stable": len(qn_weak),
        "qn_strong_stable": len(qn_strong),
        "qn_strong_unstable": len(qn_unstable),
        "max_abs_metric_qn_unstable": max(
            (abs(r["metric_logvol"]) for r in qn_unstable if math.isfinite(r["metric_logvol"])),
            default=math.nan,
        ),
    }

    detail_path = root / f"branch_detail_eps_{eps_label}.csv"
    detail_rows = parse_detail(detail_path) if detail_path.exists() else []
    groups = defaultdict(list)
    for row in detail_rows:
        groups[(row["case_idx"], row["attempt"])].append(row)

    changed_counter_counts = Counter()
    examples = []
    for (case_idx, attempt), group in sorted(groups.items(), key=lambda item: item[0]):
        base_rows = [r for r in group if r["point_label"] == "base"]
        if not base_rows:
            continue
        base = base_rows[0]
        changes_for_group = []
        for row in group:
            if row["point_label"] == "base":
                continue
            changed = [col for col in counter_cols if row[col] != base[col]]
            for col in changed:
                changed_counter_counts[col] += 1
            if changed:
                changes_for_group.append({
                    "point_label": row["point_label"],
                    "changed": changed,
                    "base": {col: base[col] for col in changed},
                    "point": {col: row[col] for col in changed},
                })
        if changes_for_group and len(examples) < 12:
            examples.append({
                "case_idx": case_idx,
                "attempt": attempt,
                "metric_logvol": base["metric_logvol"],
                "base_q_out": base["q_out"],
                "base_c_out": base["c_out"],
                "changes": changes_for_group,
            })

    detail_summary[eps_label] = {
        "detail_rows": len(detail_rows),
        "detail_groups": len(groups),
        "changed_counter_counts": dict(changed_counter_counts),
    }
    detail_examples[eps_label] = examples

payload = {
    "status": "DIAGNOSTIC",
    "summary": summary,
    "detail_summary": detail_summary,
    "detail_examples": detail_examples,
}
root.joinpath("branch_stability_detail_probe_results.json").write_text(json.dumps(payload, indent=2), encoding="utf-8")

lines = [
    "# Branch Stability Detail Probe Report",
    "",
    "status: `DIAGNOSTIC`",
    "",
    "## Scope",
    "- Detail capture for QN rows where weak branch stability holds but aggregate route counters differ.",
    "- Each detail group contains `base`, `q_plus`, `q_minus`, `c_plus`, and `c_minus` rows.",
    "- The goal is to identify which route counters change under tiny perturbations.",
    "",
    "## Summary",
]
for eps_label, item in sorted(summary.items()):
    detail = detail_summary.get(eps_label, {})
    lines.append(
        "- {eps}: rows={rows} qn_fd_ok={qn_fd_ok} qn_weak={qn_weak_stable} "
        "qn_strong={qn_strong_stable} qn_unstable={qn_strong_unstable} "
        "max_abs_metric_qn_unstable={max_abs_metric_qn_unstable:.3e} "
        "detail_groups={detail_groups} changed_counter_counts={changed_counter_counts}".format(
            eps=eps_label,
            detail_groups=detail.get("detail_groups", 0),
            changed_counter_counts=detail.get("changed_counter_counts", {}),
            **item,
        )
    )

lines.extend(["", "## First Detail Examples"])
for eps_label, examples in sorted(detail_examples.items()):
    lines.append(f"- {eps_label}:")
    if not examples:
        lines.append("  - none")
    for example in examples[:6]:
        lines.append(
            "  - attempt={attempt} case={case_idx} metric={metric_logvol:.3e} "
            "q_out={base_q_out:.3e} c_out={base_c_out:.3e}".format(**example)
        )
        for change in example["changes"]:
            lines.append(
                "    - {point}: {changed} base={base} point={point_values}".format(
                    point=change["point_label"],
                    changed=",".join(change["changed"]),
                    base=change["base"],
                    point_values=change["point"],
                )
            )

root.joinpath("branch_stability_detail_probe_report.md").write_text("\n".join(lines) + "\n", encoding="utf-8")
PY
