#!/bin/bash
#PBS -N krevF
#PBS -q C8
#PBS -l select=1:ncpus=4:mpiprocs=4:mem=8gb
#PBS -l walltime=00:30:00
#PBS -o /lustre1/home/cychou/TLTM/output/logs/kernel_correctness_audit/reversibility_probe_20260507.pbs.out
#PBS -e /lustre1/home/cychou/TLTM/output/logs/kernel_correctness_audit/reversibility_probe_20260507.pbs.err

set -euo pipefail

module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OMP_PROC_BIND=true
export OMP_PLACES=cores

export QN_REPLAY_REV_ENABLED=1
export QN_REVERSE_GATE_ENABLED=1
export QN_REVERSE_GATE_TOL=1e-8
export QN_S1_PROBE_MAX_ITER=28
export QN_S1_NEAR_RESCUE_ENABLED=0
export QN_S1_NONNEAR_RESCUE_ENABLED=0
export QN_QUASI_GLOBAL_FALLBACK_ENABLED=0
export QN_POST_NEWTON_REFINE_ENABLED=1
export QN_POST_NEWTON_REFINE_MAX_ITER=20

cd /lustre1/home/cychou/TLTM

TLTM_ROOT=$(pwd)
AUDIT_ROOT="output/tests/kernel_correctness_audit/reversibility_probe_20260507"
LOG_ROOT="output/logs/kernel_correctness_audit/reversibility_probe_20260507"
SRC_ROOT="output/tests/stage3_4/post_refine_fail_replay_capture"

rm -rf "${AUDIT_ROOT}" "${LOG_ROOT}"
mkdir -p "${AUDIT_ROOT}" "${LOG_ROOT}"

run_campaign() {
  local campaign="$1"
  local method="$2"
  local qn_tol="$3"
  local out_campaign="${AUDIT_ROOT}/${campaign}"
  mkdir -p "${out_campaign}"
  export QN_QUASI_TOL_OVERRIDE="${qn_tol}"

  for capture_dir in "${SRC_ROOT}/${campaign}/${method}"/seed_*/output; do
    [ -d "${capture_dir}" ] || continue
    [ -f "${capture_dir}/constraint_solver_fail_z0.dat" ] || continue
    local seed
    seed=$(basename "$(dirname "${capture_dir}")")
    local work_dir="${out_campaign}/${seed}_work"
    mkdir -p "${work_dir}/data"
    cp "${SRC_ROOT}/${campaign}/_work/${method}/${seed}/data/parameters.dat" "${work_dir}/data/parameters.dat"
    (
      cd "${work_dir}"
      "${TLTM_ROOT}/bin/replay_quasi_failures" \
        "${qn_tol}" 28 \
        "${TLTM_ROOT}/${capture_dir}/constraint_solver_fail_z0.dat" \
        "${TLTM_ROOT}/${capture_dir}/constraint_solver_fail_delz.dat" \
        "${TLTM_ROOT}/${capture_dir}/constraint_solver_fail_x0.dat" \
        "${TLTM_ROOT}/${out_campaign}/${seed}_rev_replay.csv" \
        > "${TLTM_ROOT}/${LOG_ROOT}/${campaign}_${seed}_replay.out" \
        2> "${TLTM_ROOT}/${LOG_ROOT}/${campaign}_${seed}_replay.err"
    )
  done
}

run_campaign "withfb_p28_refine_rg_ct1e13_qn1e13_10seed_10k" "fb" "1e-13"
run_campaign "withfb_p28_refine_rg_ct1e13_qn1e14_10seed_10k" "fb" "1e-14"

python3 - <<'PY'
import csv
import json
import math
from pathlib import Path

root = Path("output/tests/kernel_correctness_audit/reversibility_probe_20260507")
rev_tol = 1.0e-8
rows = []

for path in sorted(root.glob("*/*_rev_replay.csv")):
    campaign = path.parent.name
    seed = path.name.replace("_rev_replay.csv", "")
    with path.open(newline="") as fobj:
        reader = csv.DictReader(fobj)
        for row in reader:
            def f(name):
                try:
                    return float(row.get(name, "nan"))
                except ValueError:
                    return math.nan
            rows.append({
                "campaign": campaign,
                "seed": seed,
                "sample_idx": int(float(row["sample_idx"])),
                "success": int(float(row["success"])),
                "rev_ok": int(float(row["rev_ok"])),
                "rev_dx": f("rev_dx"),
                "rev_dz": f("rev_dz"),
                "rev_dp": f("rev_dp"),
                "nt_loss_norm": f("nt_loss_norm"),
            })

checked = [r for r in rows if r["success"] == 1]
rev_ok_rows = [r for r in checked if r["rev_ok"] == 1]
bad_status = [r for r in checked if r["rev_ok"] != 1]

def finite(x):
    return math.isfinite(x)

def max_field(name):
    vals = [r[name] for r in rev_ok_rows if finite(r[name])]
    return max(vals) if vals else math.nan

threshold_bad = []
for r in rev_ok_rows:
    local_max = max(abs(r["rev_dx"]), abs(r["rev_dz"]), abs(r["rev_dp"]))
    if (not math.isfinite(local_max)) or local_max > rev_tol:
        rr = dict(r)
        rr["rev_max"] = local_max
        threshold_bad.append(rr)

campaign_summary = {}
for r in rows:
    item = campaign_summary.setdefault(r["campaign"], {
        "rows": 0,
        "success": 0,
        "rev_ok": 0,
        "bad_status": 0,
        "threshold_bad": 0,
        "max_rev_dx": 0.0,
        "max_rev_dz": 0.0,
        "max_rev_dp": 0.0,
    })
    item["rows"] += 1
    if r["success"] == 1:
        item["success"] += 1
        if r["rev_ok"] == 1:
            item["rev_ok"] += 1
            for key in ("rev_dx", "rev_dz", "rev_dp"):
                if finite(r[key]):
                    item["max_" + key] = max(item["max_" + key], abs(r[key]))
        else:
            item["bad_status"] += 1

for r in threshold_bad:
    campaign_summary[r["campaign"]]["threshold_bad"] += 1

status = "PASS"
if not rows or not checked:
    status = "INCONCLUSIVE"
elif bad_status or threshold_bad:
    status = "FAIL"

payload = {
    "status": status,
    "rev_tol": rev_tol,
    "total_rows": len(rows),
    "solver_success_rows": len(checked),
    "rev_ok_rows": len(rev_ok_rows),
    "bad_status_rows": len(bad_status),
    "threshold_bad_rows": len(threshold_bad),
    "max_rev_dx": max_field("rev_dx"),
    "max_rev_dz": max_field("rev_dz"),
    "max_rev_dp": max_field("rev_dp"),
    "campaign_summary": campaign_summary,
    "bad_status_examples": bad_status[:10],
    "threshold_bad_examples": threshold_bad[:10],
}
root.joinpath("reversibility_probe_results.json").write_text(json.dumps(payload, indent=2), encoding="utf-8")

lines = [
    "# Reversibility Probe Report",
    "",
    f"status: `{status}`",
    f"rev_tol: `{rev_tol:.1e}`",
    "",
    "## Scope",
    "- Captured-case replay with `QN_REPLAY_REV_ENABLED=1`.",
    "- Tests whether replay-success cases return to the original state under one forward and one reverse `rattle_step_core` call.",
    "- This is a local reversibility audit on captured difficult cases, not a volume/proposal-density audit.",
    "",
    "## Totals",
    f"- input rows: {len(rows)}",
    f"- solver success rows: {len(checked)}",
    f"- rev_ok rows: {len(rev_ok_rows)}",
    f"- bad rev status rows: {len(bad_status)}",
    f"- rows above tolerance: {len(threshold_bad)}",
    f"- max rev_dx: {max_field('rev_dx'):.16e}",
    f"- max rev_dz: {max_field('rev_dz'):.16e}",
    f"- max rev_dp: {max_field('rev_dp'):.16e}",
    "",
    "## Campaign Summary",
]
for name, item in sorted(campaign_summary.items()):
    lines.append(
        "- {name}: rows={rows} success={success} rev_ok={rev_ok} bad_status={bad_status} threshold_bad={threshold_bad} "
        "max_dx={max_rev_dx:.3e} max_dz={max_rev_dz:.3e} max_dp={max_rev_dp:.3e}".format(name=name, **item)
    )

if bad_status or threshold_bad:
    lines.append("")
    lines.append("## First Bad Examples")
    for r in (bad_status + threshold_bad)[:10]:
        lines.append("- {campaign} {seed} sample={sample_idx} success={success} rev_ok={rev_ok} dx={rev_dx:.3e} dz={rev_dz:.3e} dp={rev_dp:.3e}".format(**r))

root.joinpath("reversibility_probe_report.md").write_text("\n".join(lines) + "\n", encoding="utf-8")

if status == "FAIL":
    raise SystemExit(2)
if status == "INCONCLUSIVE":
    raise SystemExit(3)
PY
