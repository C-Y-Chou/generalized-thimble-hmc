#!/bin/bash
#PBS -N krgId
#PBS -q C8
#PBS -l select=1:ncpus=4:mpiprocs=4:mem=8gb
#PBS -l walltime=02:00:00
#PBS -o /lustre1/home/cychou/TLTM/output/logs/kernel_correctness_audit/rg_reject_identity_probe_20260507.pbs.out
#PBS -e /lustre1/home/cychou/TLTM/output/logs/kernel_correctness_audit/rg_reject_identity_probe_20260507.pbs.err

set -euo pipefail

module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OMP_PROC_BIND=true
export OMP_PLACES=cores

export CONSTRAINT_FAIL_CAPTURE_START_SAMPLE=2147483647
export TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE=1e-13
export QN_REVERSE_GATE_ENABLED=1
export QN_REVERSE_GATE_TOL=1e-8
export QN_S1_PROBE_MAX_ITER=28
export QN_S1_NEAR_RESCUE_ENABLED=0
export QN_S1_NONNEAR_RESCUE_ENABLED=0
export QN_QUASI_GLOBAL_FALLBACK_ENABLED=0
export QN_QUASI_TOL_OVERRIDE=1e-13
export QN_POST_NEWTON_REFINE_ENABLED=1
export QN_POST_NEWTON_REFINE_MAX_ITER=20

cd /lustre1/home/cychou/TLTM

AUDIT_ROOT="output/tests/kernel_correctness_audit/rg_reject_identity_probe_20260507"
LOG_ROOT="output/logs/kernel_correctness_audit/rg_reject_identity_probe_20260507"

rm -rf "${AUDIT_ROOT}" "${LOG_ROOT}"
mkdir -p "${AUDIT_ROOT}" "${LOG_ROOT}"

export TLTM_RG_REJECT_AUDIT_FILE="${PWD}/${AUDIT_ROOT}/rg_reject_audit.csv"

python3 scripts/run_stage3_3_multiseed.py \
  --repo-root . \
  --config docs/stage_3_4_t035_paired_10k_10seed.json \
  --methods fb \
  --max-seeds 1 \
  --output-subdir "${AUDIT_ROOT}/full_run" \
  --logs-subdir "${LOG_ROOT}/full_run" \
  --log-prefix "rg_reject_identity" \
  --report-title "Kernel RG reject identity probe" \
  --schedule task \
  --task-method-order fb_first \
  --jobs 1 \
  --stage2-threads 1 \
  --eval-threads 1

python3 - <<'PY'
import csv
import json
import math
import re
from pathlib import Path

root = Path("output/tests/kernel_correctness_audit/rg_reject_identity_probe_20260507")
audit_csv = root / "rg_reject_audit.csv"
summary_paths = sorted((root / "full_run").glob("fb/seed_*/tltm_stage2_summary.dat"))

rows = []
if audit_csv.exists():
    with audit_csv.open(newline="") as fobj:
        reader = csv.DictReader(fobj)
        for row in reader:
            parsed = dict(row)
            for key in ("cycle", "slot_id", "update_idx", "rg_candidate_delta", "rg_pass_delta", "rg_reject_delta"):
                parsed[key] = int(parsed[key])
            for key in ("slot_dx", "slot_dz", "slot_dj", "proposal_dx", "proposal_dz", "proposal_dj"):
                parsed[key] = float(parsed[key].replace("D", "E"))
            rows.append(parsed)

rg_rows = [r for r in rows if r["rg_reject_delta"] > 0]
proposal_failed_rows = [r for r in rows if r["proposal_failed"] == "T"]

def max_field(items, name):
    vals = [abs(float(r[name])) for r in items if math.isfinite(float(r[name]))]
    return max(vals) if vals else math.nan

def sum_field(items, name):
    return sum(int(r[name]) for r in items)

summary_reject_total = None
summary_candidate_total = None
summary_pass_total = None
summary_text = ""
for path in summary_paths:
    text = path.read_text(errors="replace")
    summary_text += text + "\n"
    m_rej = re.search(r"# reverse_gate_route_reject total=(\d+)", text)
    m_cand = re.search(r"# reverse_gate_route_candidates total=(\d+)", text)
    m_pass = re.search(r"# reverse_gate_route_pass total=(\d+)", text)
    if m_rej:
        summary_reject_total = int(m_rej.group(1))
    if m_cand:
        summary_candidate_total = int(m_cand.group(1))
    if m_pass:
        summary_pass_total = int(m_pass.group(1))

bad_rows = []
for row in rg_rows:
    if row["accepted"] != "F":
        bad_rows.append({**row, "reason": "rg_reject_row_accepted"})
    if row["proposal_failed"] != "T":
        bad_rows.append({**row, "reason": "rg_reject_row_not_failed"})
    if max(row["slot_dx"], row["slot_dz"], row["slot_dj"]) != 0.0:
        bad_rows.append({**row, "reason": "slot_state_changed"})

rg_delta_sum = sum_field(rg_rows, "rg_reject_delta")
status = "PASS"
if not rg_rows:
    status = "INCONCLUSIVE"
elif bad_rows:
    status = "FAIL"
elif summary_reject_total is not None and rg_delta_sum != summary_reject_total:
    status = "FAIL"

payload = {
    "status": status,
    "audit_rows": len(rows),
    "proposal_failed_rows": len(proposal_failed_rows),
    "rg_reject_rows": len(rg_rows),
    "rg_reject_delta_sum": rg_delta_sum,
    "summary_reject_total": summary_reject_total,
    "summary_candidate_total": summary_candidate_total,
    "summary_pass_total": summary_pass_total,
    "bad_rows": bad_rows[:20],
    "max_slot_dx_rg_rows": max_field(rg_rows, "slot_dx"),
    "max_slot_dz_rg_rows": max_field(rg_rows, "slot_dz"),
    "max_slot_dj_rg_rows": max_field(rg_rows, "slot_dj"),
    "max_proposal_dx_rg_rows": max_field(rg_rows, "proposal_dx"),
    "max_proposal_dz_rg_rows": max_field(rg_rows, "proposal_dz"),
    "max_proposal_dj_rg_rows": max_field(rg_rows, "proposal_dj"),
    "first_rg_rows": rg_rows[:10],
}
root.joinpath("rg_reject_identity_probe_results.json").write_text(json.dumps(payload, indent=2), encoding="utf-8")

lines = [
    "# RG-Reject Identity Probe Report",
    "",
    f"status: `{status}`",
    "",
    "## Scope",
    "- Runs one 10k-cycle withfb p28 RG seed with production `QN_REVERSE_GATE_TOL=1e-8`.",
    "- Uses `TLTM_RG_REJECT_AUDIT_FILE` to record every local update with a projection failure or RG reject.",
    "- Checks that every positive `rg_reject_delta` row is rejected, marked `proposal_failed`, and leaves the Stage2 slot state unchanged.",
    "",
    "## Totals",
    f"- audit CSV rows: {len(rows)}",
    f"- proposal_failed rows: {len(proposal_failed_rows)}",
    f"- RG reject rows: {len(rg_rows)}",
    f"- sum rg_reject_delta: {rg_delta_sum}",
    f"- summary reverse_gate_route_reject total: {summary_reject_total}",
    f"- summary reverse_gate_route_candidates total: {summary_candidate_total}",
    f"- summary reverse_gate_route_pass total: {summary_pass_total}",
    f"- bad rows: {len(bad_rows)}",
    "",
    "## State-Diff Maxima For RG Reject Rows",
    f"- max slot_dx: {max_field(rg_rows, 'slot_dx'):.16e}",
    f"- max slot_dz: {max_field(rg_rows, 'slot_dz'):.16e}",
    f"- max slot_dj: {max_field(rg_rows, 'slot_dj'):.16e}",
    f"- max proposal_dx_buffer: {max_field(rg_rows, 'proposal_dx'):.16e}",
    f"- max proposal_dz_buffer: {max_field(rg_rows, 'proposal_dz'):.16e}",
    f"- max proposal_dj_buffer: {max_field(rg_rows, 'proposal_dj'):.16e}",
]
if bad_rows:
    lines.extend(["", "## First Bad Rows"])
    for row in bad_rows[:10]:
        lines.append(json.dumps(row, sort_keys=True))
root.joinpath("rg_reject_identity_probe_report.md").write_text("\n".join(lines) + "\n", encoding="utf-8")

if status == "FAIL":
    raise SystemExit(2)
if status == "INCONCLUSIVE":
    raise SystemExit(3)
PY
