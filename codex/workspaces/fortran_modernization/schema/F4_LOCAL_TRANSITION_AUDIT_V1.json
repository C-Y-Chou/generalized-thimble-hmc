{
  "schema_name": "local_transition_audit",
  "schema_version": "F4_LOCAL_TRANSITION_AUDIT_V1",
  "updated_jst": "2026-05-12",
  "producer": "src/sampler/tltm_stage2_driver.f90",
  "typed_event_source": "src/sampler/tltm_types.f90:tltm_local_transition_event_t",
  "enable_env": "TLTM_LOCAL_TRANSITION_AUDIT_FILE",
  "base_dir_env": "TLTM_LOCAL_TRANSITION_AUDIT_BASE_DIR",
  "max_rows_env": "TLTM_LOCAL_TRANSITION_AUDIT_MAX_ROWS",
  "event_context": {
    "context_id": "local_transition",
    "source_route_fields": [
      "newton_delta",
      "quasi_delta",
      "probe_attempt_delta",
      "probe_success_delta",
      "full_attempt_delta",
      "full_success_delta",
      "class_local_delta",
      "class_mid_delta",
      "class_global_delta",
      "far_skip_delta",
      "far_light_delta",
      "far_anchor_delta",
      "near_attempt_delta",
      "near_success_delta",
      "rg_candidate_delta",
      "rg_pass_delta",
      "rg_reject_delta"
    ],
    "acceptance_role_fields": ["accepted", "proposal_failed", "transition_status"],
    "counter_denominator": "one Stage2 local Metropolis transition row",
    "counter_derivation": "record_tltm_local_transition constructs tltm_local_transition_event_t and derives local counters from that event"
  },
  "transition_status_codes": {
    "0": "accepted",
    "1": "metropolis_rejected",
    "2": "proposal_failed",
    "3": "reverse_gate_rejected",
    "4": "hamiltonian_invalid",
    "5": "delta_h_invalid",
    "6": "output_size_mismatch"
  },
  "columns": [
    "cycle",
    "slot_id",
    "update_idx",
    "accepted",
    "proposal_failed",
    "transition_status",
    "h_initial",
    "h_final",
    "delta_h",
    "accept_probability",
    "q_initial",
    "c_initial",
    "q_proposal",
    "c_proposal",
    "q_after",
    "newton_delta",
    "quasi_delta",
    "probe_attempt_delta",
    "probe_success_delta",
    "full_attempt_delta",
    "full_success_delta",
    "class_local_delta",
    "class_mid_delta",
    "class_global_delta",
    "far_skip_delta",
    "far_light_delta",
    "far_anchor_delta",
    "near_attempt_delta",
    "near_success_delta",
    "rg_candidate_delta",
    "rg_pass_delta",
    "rg_reject_delta",
    "row_index"
  ],
  "required_row_invariants": [
    "row_index is sequential from 1 within each file",
    "accepted=T implies transition_status=0 and proposal_failed=F",
    "proposal_failed=T implies transition_status is one of 2,3,4,5,6",
    "rg_candidate_delta equals rg_pass_delta plus rg_reject_delta",
    "all route/counter delta fields are nonnegative integers"
  ]
}
