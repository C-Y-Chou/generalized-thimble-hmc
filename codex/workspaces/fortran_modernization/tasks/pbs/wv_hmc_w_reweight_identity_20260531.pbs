#!/bin/bash
#PBS -N wvwident
#PBS -q C16
#PBS -l select=1:ncpus=16:mpiprocs=16:mem=32gb
#PBS -l walltime=01:00:00
#PBS -j oe

set -euo pipefail

if [ -f /etc/profile.d/modules.sh ]; then
  # shellcheck source=/dev/null
  . /etc/profile.d/modules.sh
fi
if [ -f /usr/share/Modules/init/bash ]; then
  # shellcheck source=/dev/null
  . /usr/share/Modules/init/bash
fi
module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

: "${TLTM_WORKTREE:?TLTM_WORKTREE is required}"
: "${TLTM_RUN_NAME:=wv_hmc_w_reweight_identity_20260531}"
: "${TLTM_OUTPUT_ROOT:=/lustre1/home/cychou/TLTM_worktrees/fortran_modernization/output/wv_hmc_observable_validation_20260530}"
: "${TLTM_LOG_ROOT:=/lustre1/home/cychou/TLTM_worktrees/fortran_modernization/output/logs/wv_hmc_w_reweight_identity_20260531/${TLTM_RUN_NAME}}"
: "${TLTM_PARAMETERS_FILE:=data/parameters_stephanov_n2_smoke.dat}"
: "${WV_WIDENT_GH_ORDER:=3}"
: "${WV_WIDENT_T_ORDER:=3}"
: "${WV_WIDENT_T0:=1.0e-4}"
: "${WV_WIDENT_T1:=1.0e-3}"
: "${WV_WIDENT_D0:=1.0e-4}"
: "${WV_WIDENT_D1:=2.5e-4}"
: "${WV_WIDENT_GAMMAS:=0,0.02,0.2,20}"
: "${WV_WIDENT_ALLOW_MISSING:=0}"
: "${WV_WIDENT_SKIP_BUILD:=0}"
: "${TLTM_ODE_BACKEND:=dop853}"
: "${TLTM_DOP853_HINIT_ENABLED:=1}"
: "${TLTM_DOP853_STIFFNESS_CHECK_ENABLED:=1}"
: "${TLTM_DOP853_STIFFNESS_CHECK_INTERVAL:=1000}"
: "${TLTM_DOP853_STIFFNESS_MAX_HITS:=15}"
: "${TLTM_DOP853_STIFFNESS_THRESHOLD:=6.1}"
export TLTM_ODE_BACKEND
export TLTM_DOP853_HINIT_ENABLED
export TLTM_DOP853_STIFFNESS_CHECK_ENABLED
export TLTM_DOP853_STIFFNESS_CHECK_INTERVAL
export TLTM_DOP853_STIFFNESS_MAX_HITS
export TLTM_DOP853_STIFFNESS_THRESHOLD

cd "${TLTM_WORKTREE}"
mkdir -p "${TLTM_LOG_ROOT}"
exec > "${TLTM_LOG_ROOT}/pbs_boot_${PBS_JOBID:-manual}.log" 2>&1

echo "RUN_DATE=$(date -Is)"
echo "HOSTNAME=$(hostname)"
echo "PBS_JOBID=${PBS_JOBID:-manual}"
echo "PBS_QUEUE=${PBS_QUEUE:-unknown}"
echo "TLTM_WORKTREE=${TLTM_WORKTREE}"
echo "TLTM_RUN_NAME=${TLTM_RUN_NAME}"
echo "TLTM_PARAMETERS_FILE=${TLTM_PARAMETERS_FILE}"
echo "WV_WIDENT_GH_ORDER=${WV_WIDENT_GH_ORDER}"
echo "WV_WIDENT_T_ORDER=${WV_WIDENT_T_ORDER}"
echo "WV_WIDENT_T0=${WV_WIDENT_T0}"
echo "WV_WIDENT_T1=${WV_WIDENT_T1}"
echo "WV_WIDENT_D0=${WV_WIDENT_D0}"
echo "WV_WIDENT_D1=${WV_WIDENT_D1}"
echo "WV_WIDENT_GAMMAS=${WV_WIDENT_GAMMAS}"
echo "WV_WIDENT_ALLOW_MISSING=${WV_WIDENT_ALLOW_MISSING}"
echo "WV_WIDENT_SKIP_BUILD=${WV_WIDENT_SKIP_BUILD}"
echo "TLTM_ODE_BACKEND=${TLTM_ODE_BACKEND}"
echo "GIT_BRANCH=$(git rev-parse --abbrev-ref HEAD)"
echo "GIT_COMMIT=$(git rev-parse HEAD)"
echo "GIT_STATUS_START"
git status --short || true
echo "GIT_STATUS_END"

if [ -x .venv-dfols/bin/python ]; then
  DFOLS_SITE_PACKAGES="$(.venv-dfols/bin/python - <<'PY'
import sysconfig
print(sysconfig.get_paths()["purelib"])
PY
)"
  export TLTM_OFFICIAL_DFOLS_PYTHONPATH="${DFOLS_SITE_PACKAGES}${TLTM_OFFICIAL_DFOLS_PYTHONPATH:+:${TLTM_OFFICIAL_DFOLS_PYTHONPATH}}"
fi

# shellcheck source=/dev/null
. codex/workspaces/fortran_modernization/tasks/scripts/python_embed_env.sh

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export OMP_DYNAMIC=FALSE
export MKL_DYNAMIC=FALSE

make -C build OMP=1 PYTHON="${PYTHON}" PYTHON_EMBED_CFLAGS="${PYTHON_EMBED_CFLAGS}" \
  PYTHON_EMBED_LDFLAGS="${PYTHON_EMBED_LDFLAGS}" build_flow_bank_dense

RUN_ROOT="${TLTM_OUTPUT_ROOT}/${TLTM_RUN_NAME}_${PBS_JOBID:-manual}"
mkdir -p "${RUN_ROOT}"

EXTRA_ARGS=()
if [ "${WV_WIDENT_SKIP_BUILD}" = "1" ]; then
  EXTRA_ARGS+=(--skip-build)
fi
if [ "${WV_WIDENT_ALLOW_MISSING}" = "1" ]; then
  EXTRA_ARGS+=(--allow-missing)
fi

/usr/bin/time -p python3 codex/workspaces/fortran_modernization/tasks/scripts/run_stephanov_n2_wv_reweight_identity_20260531.py \
  --binary bin/build_flow_bank_dense \
  --parameters-file "${TLTM_PARAMETERS_FILE}" \
  --output-root "${RUN_ROOT}" \
  --order "${WV_WIDENT_GH_ORDER}" \
  --t-order "${WV_WIDENT_T_ORDER}" \
  --t0 "${WV_WIDENT_T0}" \
  --t1 "${WV_WIDENT_T1}" \
  --d0 "${WV_WIDENT_D0}" \
  --d1 "${WV_WIDENT_D1}" \
  --gamma-values "${WV_WIDENT_GAMMAS}" \
  "${EXTRA_ARGS[@]}"

echo "RUN_ROOT=${RUN_ROOT}"
echo "WV_HMC_W_REWEIGHT_IDENTITY_COMPLETE"
