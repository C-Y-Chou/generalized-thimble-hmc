#!/bin/bash
#PBS -N wvposgate
#PBS -q C17
#PBS -l select=1:ncpus=16:mpiprocs=16:mem=32gb
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail

if [ -f /etc/profile.d/modules.sh ]; then
  # shellcheck source=/dev/null
  . /etc/profile.d/modules.sh
fi
if [ -f /usr/share/Modules/init/bash ]; then
  # shellcheck source=/dev/null
  . /usr/share/Modules/init/bash
fi
module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

: "${TLTM_WORKTREE:?TLTM_WORKTREE is required}"
: "${TLTM_SOURCE_PIN_FILE:=}"
: "${TLTM_REQUIRE_SOURCE_PIN:=1}"
: "${TLTM_EXPECTED_SOURCE_PIN_ID:=}"
: "${TLTM_RUN_NAME:=wv_hmc_positive_target_invariant_n2_t001_20260602}"
: "${TLTM_OUTPUT_ROOT:=/lustre1/home/cychou/TLTM_worktrees/fortran_modernization/output/wv_hmc_positive_target_invariant_20260602}"
: "${TLTM_LOG_ROOT:=/lustre1/home/cychou/TLTM_worktrees/fortran_modernization/output/logs/wv_hmc_positive_target_invariant_20260602/${TLTM_RUN_NAME}}"
: "${TLTM_PARAMETERS_FILE:=data/parameters_stephanov_n2_smoke.dat}"
: "${WV_GATE_SEED_START:=9930001}"
: "${WV_GATE_SEED_COUNT:=64}"
: "${WV_GATE_CYCLES:=3000}"
: "${WV_GATE_MEASUREMENT_START_CYCLE:=1001}"
: "${WV_GATE_STEP_SIZE:=0.003}"
: "${WV_GATE_NUM_STEPS:=20}"
: "${WV_GATE_INIT_MODE:=state_bank}"
: "${WV_GATE_INIT_BANK_FILE:=/lustre1/home/cychou/TLTM_worktrees/fortran_modernization/output/wv_hmc_n2_t001_clean_20260602/state_bank_from_t001_late_final_20260602/state_bank_t001_final128.bin}"
: "${WV_GATE_INIT_BANK_RECORD:=-1}"
: "${WV_GATE_JOBS:=16}"
: "${WV_GATE_TIMEOUT_SEC:=3600}"
: "${WV_GATE_T0:=0.0}"
: "${WV_GATE_T1:=0.01}"
: "${WV_GATE_D0:=0.0001}"
: "${WV_GATE_D1:=0.0025}"
: "${WV_GATE_MEASUREMENT_T0:=0.0}"
: "${WV_GATE_MEASUREMENT_T1:=0.01}"
: "${WV_GATE_FLOW_TIME:=0.0}"
: "${WV_GATE_W_PROFILE:=paper_wall}"
: "${WV_GATE_W_GAMMA:=0.0}"
: "${WV_GATE_W_C0:=1.0}"
: "${WV_GATE_W_C1:=1.0}"
: "${WV_GATE_BOUNDARY_POLICY:=paper_full_flip}"
: "${WV_GATE_CONSTRAINT_TOL:=1.0e-10}"
: "${WV_GATE_CONSTRAINT_MAX_ITER:=96}"
: "${WV_GATE_REVERSE_GATE_STATE_TOL:=1.0e-5}"
: "${WV_GATE_REVERSE_GATE_MOMENTUM_TOL:=1.0e-3}"
: "${WV_GATE_ORACLE_ORDER:=3}"
: "${WV_GATE_ORACLE_T_ORDER:=5}"
: "${WV_GATE_Z_WARN:=3.0}"
: "${WV_GATE_Z_FAIL:=4.0}"
: "${WV_GATE_RUN_SAMPLE:=1}"
: "${WV_GATE_RUN_ANALYSIS:=1}"
: "${WV_GATE_SKIP_ORACLE_BUILD:=0}"
: "${WV_GATE_ALLOW_MISSING_ORACLE_SLOTS:=0}"
: "${TLTM_ODE_BACKEND:=dop853}"
: "${TLTM_DOP853_HINIT_ENABLED:=1}"
: "${TLTM_DOP853_STIFFNESS_CHECK_ENABLED:=1}"
: "${TLTM_DOP853_STIFFNESS_CHECK_INTERVAL:=1000}"
: "${TLTM_DOP853_STIFFNESS_MAX_HITS:=15}"
: "${TLTM_DOP853_STIFFNESS_THRESHOLD:=6.1}"
export TLTM_ODE_BACKEND
export TLTM_DOP853_HINIT_ENABLED
export TLTM_DOP853_STIFFNESS_CHECK_ENABLED
export TLTM_DOP853_STIFFNESS_CHECK_INTERVAL
export TLTM_DOP853_STIFFNESS_MAX_HITS
export TLTM_DOP853_STIFFNESS_THRESHOLD

cd "${TLTM_WORKTREE}"
mkdir -p "${TLTM_LOG_ROOT}"
exec > "${TLTM_LOG_ROOT}/pbs_boot_${PBS_JOBID:-manual}.log" 2>&1

echo "RUN_DATE=$(date -Is)"
echo "HOSTNAME=$(hostname)"
echo "PBS_JOBID=${PBS_JOBID:-manual}"
echo "PBS_QUEUE=${PBS_QUEUE:-unknown}"
echo "TLTM_WORKTREE=${TLTM_WORKTREE}"
echo "TLTM_RUN_NAME=${TLTM_RUN_NAME}"
echo "TLTM_OUTPUT_ROOT=${TLTM_OUTPUT_ROOT}"
echo "TLTM_LOG_ROOT=${TLTM_LOG_ROOT}"
echo "TLTM_SOURCE_PIN_FILE=${TLTM_SOURCE_PIN_FILE}"
echo "TLTM_REQUIRE_SOURCE_PIN=${TLTM_REQUIRE_SOURCE_PIN}"
echo "TLTM_EXPECTED_SOURCE_PIN_ID=${TLTM_EXPECTED_SOURCE_PIN_ID}"
echo "TLTM_PARAMETERS_FILE=${TLTM_PARAMETERS_FILE}"
echo "WV_GATE_SEED_START=${WV_GATE_SEED_START}"
echo "WV_GATE_SEED_COUNT=${WV_GATE_SEED_COUNT}"
echo "WV_GATE_CYCLES=${WV_GATE_CYCLES}"
echo "WV_GATE_MEASUREMENT_START_CYCLE=${WV_GATE_MEASUREMENT_START_CYCLE}"
echo "WV_GATE_STEP_SIZE=${WV_GATE_STEP_SIZE}"
echo "WV_GATE_NUM_STEPS=${WV_GATE_NUM_STEPS}"
echo "WV_GATE_INIT_MODE=${WV_GATE_INIT_MODE}"
echo "WV_GATE_INIT_BANK_FILE=${WV_GATE_INIT_BANK_FILE}"
echo "WV_GATE_T0=${WV_GATE_T0}"
echo "WV_GATE_T1=${WV_GATE_T1}"
echo "WV_GATE_D0=${WV_GATE_D0}"
echo "WV_GATE_D1=${WV_GATE_D1}"
echo "WV_GATE_W_PROFILE=${WV_GATE_W_PROFILE}"
echo "WV_GATE_W_GAMMA=${WV_GATE_W_GAMMA}"
echo "WV_GATE_ORACLE_ORDER=${WV_GATE_ORACLE_ORDER}"
echo "WV_GATE_ORACLE_T_ORDER=${WV_GATE_ORACLE_T_ORDER}"
echo "WV_GATE_RUN_SAMPLE=${WV_GATE_RUN_SAMPLE}"
echo "WV_GATE_RUN_ANALYSIS=${WV_GATE_RUN_ANALYSIS}"
echo "WV_GATE_SKIP_ORACLE_BUILD=${WV_GATE_SKIP_ORACLE_BUILD}"
echo "WV_GATE_ALLOW_MISSING_ORACLE_SLOTS=${WV_GATE_ALLOW_MISSING_ORACLE_SLOTS}"
echo "TLTM_ODE_BACKEND=${TLTM_ODE_BACKEND}"

if [ -z "${TLTM_SOURCE_PIN_FILE}" ] && [ -f "${TLTM_WORKTREE}/codex/workspaces/fortran_modernization/state/CLUSTER02_SOURCE_PIN.env" ]; then
  TLTM_SOURCE_PIN_FILE="${TLTM_WORKTREE}/codex/workspaces/fortran_modernization/state/CLUSTER02_SOURCE_PIN.env"
fi
if [ -n "${TLTM_SOURCE_PIN_FILE}" ]; then
  if [ ! -f "${TLTM_SOURCE_PIN_FILE}" ]; then
    echo "[ERROR] TLTM_SOURCE_PIN_FILE does not exist: ${TLTM_SOURCE_PIN_FILE}" >&2
    exit 2
  fi
  echo "SOURCE_PIN_START"
  sed 's/^/SOURCE_PIN_FILE: /' "${TLTM_SOURCE_PIN_FILE}"
  echo "SOURCE_PIN_END"
  # shellcheck source=/dev/null
  . "${TLTM_SOURCE_PIN_FILE}"
  echo "TLTM_SOURCE_PIN_ID=${TLTM_SOURCE_PIN_ID:-}"
  echo "TLTM_SOURCE_PIN_COMMIT=${TLTM_SOURCE_PIN_COMMIT:-}"
  echo "TLTM_SOURCE_PIN_DIRTY_COUNT=${TLTM_SOURCE_PIN_DIRTY_COUNT:-}"
  if [ -n "${TLTM_EXPECTED_SOURCE_PIN_ID}" ] && [ "${TLTM_SOURCE_PIN_ID:-}" != "${TLTM_EXPECTED_SOURCE_PIN_ID}" ]; then
    echo "[ERROR] expected source pin ${TLTM_EXPECTED_SOURCE_PIN_ID}, got ${TLTM_SOURCE_PIN_ID:-missing}" >&2
    exit 2
  fi
elif [ "${TLTM_REQUIRE_SOURCE_PIN}" = "1" ]; then
  echo "[ERROR] TLTM_REQUIRE_SOURCE_PIN=1 but no source pin file was provided or found." >&2
  exit 2
fi

if [ -x .venv-dfols/bin/python ]; then
  DFOLS_SITE_PACKAGES="$(.venv-dfols/bin/python - <<'PY'
import sysconfig
print(sysconfig.get_paths()["purelib"])
PY
)"
  export TLTM_OFFICIAL_DFOLS_PYTHONPATH="${DFOLS_SITE_PACKAGES}${TLTM_OFFICIAL_DFOLS_PYTHONPATH:+:${TLTM_OFFICIAL_DFOLS_PYTHONPATH}}"
fi

# shellcheck source=/dev/null
. codex/workspaces/fortran_modernization/tasks/scripts/python_embed_env.sh

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export OMP_DYNAMIC=FALSE
export MKL_DYNAMIC=FALSE

test -f build/makefile
make -C build -j "${WV_GATE_JOBS}" OMP=1 PYTHON="${PYTHON}" PYTHON_EMBED_CFLAGS="${PYTHON_EMBED_CFLAGS}" \
  PYTHON_EMBED_LDFLAGS="${PYTHON_EMBED_LDFLAGS}" ../bin/run_wv_hmc ../bin/build_flow_bank_dense

RUN_ROOT="${TLTM_OUTPUT_ROOT}/${TLTM_RUN_NAME}/sample"
ORACLE_WORK_DIR="${TLTM_OUTPUT_ROOT}/${TLTM_RUN_NAME}/oracle_work"
READBACK_DIR="${TLTM_OUTPUT_ROOT}/${TLTM_RUN_NAME}/readback"
mkdir -p "${RUN_ROOT}" "${ORACLE_WORK_DIR}" "${READBACK_DIR}"

if [ "${WV_GATE_RUN_SAMPLE}" = "1" ]; then
/usr/bin/time -p "${PYTHON}" codex/workspaces/fortran_modernization/tasks/scripts/run_wv_hmc_dense_observable_validation_20260529.py \
  --binary bin/run_wv_hmc \
  --parameters-file "${TLTM_PARAMETERS_FILE}" \
  --output-root "${RUN_ROOT}" \
  --seed-start "${WV_GATE_SEED_START}" \
  --seed-count "${WV_GATE_SEED_COUNT}" \
  --cycles "${WV_GATE_CYCLES}" \
  --measurement-start-cycle "${WV_GATE_MEASUREMENT_START_CYCLE}" \
  --step-size "${WV_GATE_STEP_SIZE}" \
  --num-steps "${WV_GATE_NUM_STEPS}" \
  --init-mode "${WV_GATE_INIT_MODE}" \
  --init-bank-file "${WV_GATE_INIT_BANK_FILE}" \
  --init-bank-record "${WV_GATE_INIT_BANK_RECORD}" \
  --reverse-gate-state-tol "${WV_GATE_REVERSE_GATE_STATE_TOL}" \
  --reverse-gate-momentum-tol "${WV_GATE_REVERSE_GATE_MOMENTUM_TOL}" \
  --constraint-tol "${WV_GATE_CONSTRAINT_TOL}" \
  --constraint-max-iter "${WV_GATE_CONSTRAINT_MAX_ITER}" \
  --adaptive-newton-stop-enabled 0 \
  --sampler-t0 "${WV_GATE_T0}" \
  --sampler-t1 "${WV_GATE_T1}" \
  --d0 "${WV_GATE_D0}" \
  --d1 "${WV_GATE_D1}" \
  --measurement-t0 "${WV_GATE_MEASUREMENT_T0}" \
  --measurement-t1 "${WV_GATE_MEASUREMENT_T1}" \
  --initial-flow-time "${WV_GATE_FLOW_TIME}" \
  --w-profile "${WV_GATE_W_PROFILE}" \
  --boundary-policy "${WV_GATE_BOUNDARY_POLICY}" \
  --w-gamma "${WV_GATE_W_GAMMA}" \
  --w-c0 "${WV_GATE_W_C0}" \
  --w-c1 "${WV_GATE_W_C1}" \
  --jobs "${WV_GATE_JOBS}" \
  --timeout-sec "${WV_GATE_TIMEOUT_SEC}" \
  --history-stride 1 \
  --write-observable-history \
  --write-state-history \
  --write-final-state
else
  echo "WV_GATE_SAMPLE_SKIPPED=1"
fi

if [ "${WV_GATE_RUN_ANALYSIS}" = "1" ]; then
ANALYSIS_EXTRA_ARGS=()
if [ "${WV_GATE_SKIP_ORACLE_BUILD}" = "1" ]; then
  ANALYSIS_EXTRA_ARGS+=(--skip-oracle-build)
fi
if [ "${WV_GATE_ALLOW_MISSING_ORACLE_SLOTS}" = "1" ]; then
  ANALYSIS_EXTRA_ARGS+=(--allow-missing-oracle-slots)
fi
/usr/bin/time -p "${PYTHON}" codex/workspaces/fortran_modernization/tasks/scripts/analyze_wv_hmc_positive_target_invariant_20260602.py \
  --run-root "${RUN_ROOT}" \
  --output-root "${READBACK_DIR}" \
  --oracle-work-dir "${ORACLE_WORK_DIR}" \
  --parameters-file "${TLTM_PARAMETERS_FILE}" \
  --flow-bank-binary bin/build_flow_bank_dense \
  --order "${WV_GATE_ORACLE_ORDER}" \
  --t-order "${WV_GATE_ORACLE_T_ORDER}" \
  --t0 "${WV_GATE_MEASUREMENT_T0}" \
  --t1 "${WV_GATE_MEASUREMENT_T1}" \
  --d0 "${WV_GATE_D0}" \
  --d1 "${WV_GATE_D1}" \
  --gamma "${WV_GATE_W_GAMMA}" \
  --c0 "${WV_GATE_W_C0}" \
  --c1 "${WV_GATE_W_C1}" \
  --z-warn-threshold "${WV_GATE_Z_WARN}" \
  --z-fail-threshold "${WV_GATE_Z_FAIL}" \
  "${ANALYSIS_EXTRA_ARGS[@]}"
else
  echo "WV_GATE_ANALYSIS_SKIPPED=1"
fi

echo "RUN_ROOT=${RUN_ROOT}"
echo "READBACK_DIR=${READBACK_DIR}"
echo "WV_HMC_POSITIVE_TARGET_INVARIANT_GATE_COMPLETE"
