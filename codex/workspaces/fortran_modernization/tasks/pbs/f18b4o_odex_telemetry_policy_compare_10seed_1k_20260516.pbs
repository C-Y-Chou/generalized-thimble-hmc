#!/bin/bash
#PBS -N f18b4o
#PBS -q C16
#PBS -l select=1:ncpus=20:mpiprocs=20:mem=24gb
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail

if [ -f /etc/profile.d/modules.sh ]; then
  . /etc/profile.d/modules.sh
fi
if [ -f /usr/share/Modules/init/bash ]; then
  . /usr/share/Modules/init/bash
fi
module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

: "${TLTM_WORKTREE:=/lustre1/home/cychou/TLTM_worktrees/fortran_modernization}"
: "${TLTM_EXPECTED_GIT_BRANCH:=codex/fortran-modernization}"
: "${TLTM_BASE_GIT_COMMIT:=243c09ceb99fd435b83b570db805174e6fa965ef}"
: "${TLTM_CONFIG_JSON:=docs/production_comparison_official_dfols_20260511_10seed_1k_nofb_withfb.json}"
: "${TLTM_MAX_SEEDS:=10}"
: "${TLTM_SEED_OFFSET:=0}"
: "${TLTM_RUN_JOBS_PER_POLICY:=10}"
: "${TLTM_CYCLES_PER_SEED_LABEL:=1000}"
: "${TLTM_METHODS:=no_fb_fbnorefine}"
: "${TLTM_SCHEDULE:=paired}"
: "${TLTM_PAIR_ORDER:=alternating}"
: "${TLTM_TASK_METHOD_ORDER:=no_fb_first}"

cd "${TLTM_WORKTREE}"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
CURRENT_COMMIT="$(git rev-parse HEAD)"
CURRENT_SHORT="$(git rev-parse --short=12 HEAD)"
if [ "${CURRENT_BRANCH}" != "${TLTM_EXPECTED_GIT_BRANCH}" ]; then
  echo "[ERROR] expected branch ${TLTM_EXPECTED_GIT_BRANCH}, got ${CURRENT_BRANCH}" >&2
  exit 2
fi
if [ "${CURRENT_COMMIT}" != "${TLTM_BASE_GIT_COMMIT}" ]; then
  echo "[ERROR] expected base commit ${TLTM_BASE_GIT_COMMIT}, got ${CURRENT_COMMIT}" >&2
  exit 2
fi

PYTHON_FOR_DFOLS="${TLTM_DFOLS_PYTHON:-}"
if [ -z "${PYTHON_FOR_DFOLS}" ]; then
  if command -v python3.11 >/dev/null 2>&1; then
    PYTHON_FOR_DFOLS="$(command -v python3.11)"
  elif command -v python3.9 >/dev/null 2>&1; then
    PYTHON_FOR_DFOLS="$(command -v python3.9)"
  else
    echo "[ERROR] Need python3.9+ for official DFO-LS package." >&2
    exit 4
  fi
fi

PY_DEVEL_ROOT="${TLTM_PYTHON_DEVEL_ROOT:-${PWD}/.deps/python-devel-3.11}"
if [ -z "${PYTHON_EMBED_CFLAGS:-}" ] && [ -f "${PY_DEVEL_ROOT}/usr/include/python3.11/Python.h" ]; then
  PYTHON_EMBED_CFLAGS="-I${PY_DEVEL_ROOT}/usr/include/python3.11"
  if [ -d /usr/include/python3.11 ]; then
    PYTHON_EMBED_CFLAGS="${PYTHON_EMBED_CFLAGS} -I/usr/include/python3.11"
  fi
  export PYTHON_EMBED_CFLAGS
fi
if [ -z "${PYTHON_EMBED_LDFLAGS:-}" ] && [ -f "${PY_DEVEL_ROOT}/usr/lib64/libpython3.11.so" ]; then
  export PYTHON_EMBED_LDFLAGS="${PY_DEVEL_ROOT}/usr/lib64/libpython3.11.so -lpthread -ldl -lutil -lm"
  export LD_LIBRARY_PATH="${PY_DEVEL_ROOT}/usr/lib64${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
elif [ -z "${PYTHON_EMBED_LDFLAGS:-}" ] && [ -f /usr/lib64/libpython3.11.so.1.0 ]; then
  export PYTHON_EMBED_LDFLAGS="/usr/lib64/libpython3.11.so.1.0 -lpthread -ldl -lutil -lm"
fi

if [ ! -x .venv-dfols/bin/python ]; then
  echo "[ERROR] missing .venv-dfols" >&2
  exit 4
fi

DFOLS_SITE_PACKAGES="$(.venv-dfols/bin/python - <<'PY'
import dfols, sysconfig
print(sysconfig.get_paths()["purelib"])
PY
)"

RUN_STAMP="${TLTM_RUN_STAMP:-$(date +%Y%m%dT%H%M%S)}"
: "${TLTM_CAMPAIGN:=f18b4o_odex_telemetry_policy_compare_npt5_r0055_10seed_1k_${RUN_STAMP}_${CURRENT_SHORT}}"
export TLTM_CAMPAIGN

ROOT_SUBDIR="output/tests/${TLTM_CAMPAIGN}"
ROOT_LOG_SUBDIR="output/logs/${TLTM_CAMPAIGN}"
BOOT_LOG_DIR="${ROOT_LOG_SUBDIR}/pbs"

if [ -e "${ROOT_SUBDIR}" ] || [ -e "${ROOT_LOG_SUBDIR}" ]; then
  echo "[ERROR] output/log root already exists; set a unique TLTM_RUN_STAMP or TLTM_CAMPAIGN" >&2
  echo "[ERROR] ROOT_SUBDIR=${ROOT_SUBDIR}" >&2
  echo "[ERROR] ROOT_LOG_SUBDIR=${ROOT_LOG_SUBDIR}" >&2
  exit 2
fi
mkdir -p "${ROOT_SUBDIR}" "${BOOT_LOG_DIR}"
exec > "${BOOT_LOG_DIR}/pbs_boot.log" 2>&1

{
  echo "RUN_DATE=$(date -Is)"
  echo "RUNNER=codex"
  echo "PBS_JOBID=${PBS_JOBID:-}"
  echo "PBS_QUEUE=${PBS_QUEUE:-}"
  echo "PBS_O_WORKDIR=${PBS_O_WORKDIR:-}"
  echo "GIT_BRANCH=${CURRENT_BRANCH}"
  echo "GIT_COMMIT=${CURRENT_COMMIT}"
  echo "BASE_GIT_COMMIT=${TLTM_BASE_GIT_COMMIT}"
  echo "GIT_DIRTY_COUNT=$(git status --porcelain | wc -l | tr -d ' ')"
  echo "PYTHON_FOR_DFOLS=${PYTHON_FOR_DFOLS}"
  echo "PYTHON_EMBED_CFLAGS=${PYTHON_EMBED_CFLAGS:-}"
  echo "PYTHON_EMBED_LDFLAGS=${PYTHON_EMBED_LDFLAGS:-}"
  echo "CONFIG_JSON=${TLTM_CONFIG_JSON}"
  echo "CAMPAIGN=${TLTM_CAMPAIGN}"
  echo "DFOLS_CANDIDATE=npt5_r0055"
  echo "POLICIES=tltm_endpoint hairer_experimental"
  echo "METHODS=${TLTM_METHODS}"
  echo "SCHEDULE=${TLTM_SCHEDULE}"
  echo "PAIR_ORDER=${TLTM_PAIR_ORDER}"
  echo "TASK_METHOD_ORDER=${TLTM_TASK_METHOD_ORDER}"
  echo "SEED_OFFSET=${TLTM_SEED_OFFSET}"
  echo "N_SEEDS=${TLTM_MAX_SEEDS}"
  echo "CYCLES_PER_SEED=${TLTM_CYCLES_PER_SEED_LABEL}"
  echo "JOBS_PER_POLICY=${TLTM_RUN_JOBS_PER_POLICY}"
  echo "OUTPUT_ROOT=${ROOT_SUBDIR}"
  echo "LOG_ROOT=${ROOT_LOG_SUBDIR}"
} > "${ROOT_SUBDIR}/run_manifest.env"
git status --short > "${ROOT_SUBDIR}/git_status_short.txt"
git diff --stat > "${ROOT_SUBDIR}/git_diff_stat.txt" || true

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OMP_PROC_BIND=true
export OMP_PLACES=cores
export OPENBLAS_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

export CONSTRAINT_FAIL_CAPTURE_START_SAMPLE=2147483647
export TLTM_STAGE2_RNG_STREAM_CONTRACT=stage2_kernel_rng_v2
export TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE=1e-13
export TLTM_ODE_BACKEND=odex
export TLTM_ODE_TOLERANCE_SOURCE=parameters_abs_rel_tol_3e-14

export QN_REVERSE_GATE_ENABLED=1
export QN_REVERSE_GATE_TOL=1e-8
export QN_S1_PROBE_MAX_ITER=28
export QN_S1_NEAR_RESCUE_ENABLED=0
export QN_S1_NONNEAR_RESCUE_ENABLED=0
export QN_QUASI_GLOBAL_FALLBACK_ENABLED=0
export QN_QUASI_TOL_OVERRIDE=1e-13
export QN_SOLVER_BACKEND=official_dfols
export QN_OFFICIAL_DFOLS_PRESET=stable_gate77
export QN_OFFICIAL_DFOLS_NPT=5
export QN_OFFICIAL_DFOLS_MAXFUN=500
export QN_OFFICIAL_DFOLS_OBJFUN_HAS_NOISE=1
export QN_OFFICIAL_DFOLS_RHOBEG=0.055
export QN_OFFICIAL_DFOLS_RHOEND=1e-16
export QN_OFFICIAL_DFOLS_MODEL_ABS_TOL=1e-30
export QN_OFFICIAL_DFOLS_MODEL_REL_TOL=0
export TLTM_OFFICIAL_DFOLS_PYTHONPATH="${DFOLS_SITE_PACKAGES}${TLTM_OFFICIAL_DFOLS_PYTHONPATH:+:${TLTM_OFFICIAL_DFOLS_PYTHONPATH}}"

unset INTODE_SOLVER_ASSIST_ENABLED || true
export INTODE_SOLVER_ASSIST_POLICY=off
export TLTM_STAGE3_METHOD_ASSIST_POLICY=off
unset TLTM_STAGE3_METHOD_ASSIST_ENABLED || true

MAKE_ARGS=(
  -C build
  OMP=1
  ENABLE_OFFICIAL_DFOLS=1
  PYTHON="${PYTHON_FOR_DFOLS}"
)
if [ -n "${PYTHON_EMBED_CFLAGS:-}" ]; then
  MAKE_ARGS+=(PYTHON_EMBED_CFLAGS="${PYTHON_EMBED_CFLAGS}")
fi
if [ -n "${PYTHON_EMBED_LDFLAGS:-}" ]; then
  MAKE_ARGS+=(PYTHON_EMBED_LDFLAGS="${PYTHON_EMBED_LDFLAGS}")
fi
make "${MAKE_ARGS[@]}" ../bin/run_tltm_stage2 ../bin/evaluate_expectations

run_policy() {
  local policy="$1"
  local label="$2"
  local out_subdir="${ROOT_SUBDIR}/${label}"
  local log_subdir="${ROOT_LOG_SUBDIR}/${label}"

  mkdir -p "${out_subdir}" "${log_subdir}"
  {
    echo "TLTM_STAGE2_RNG_STREAM_CONTRACT=${TLTM_STAGE2_RNG_STREAM_CONTRACT}"
    echo "TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE=${TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE}"
    echo "TLTM_ODE_BACKEND=${TLTM_ODE_BACKEND}"
    echo "TLTM_ODE_CONTROLLER_POLICY=${policy}"
    echo "TLTM_ODE_TOLERANCE_SOURCE=${TLTM_ODE_TOLERANCE_SOURCE}"
    echo "QN_SOLVER_BACKEND=${QN_SOLVER_BACKEND}"
    echo "QN_REVERSE_GATE_ENABLED=${QN_REVERSE_GATE_ENABLED}"
    echo "QN_REVERSE_GATE_TOL=${QN_REVERSE_GATE_TOL}"
    echo "QN_S1_PROBE_MAX_ITER=${QN_S1_PROBE_MAX_ITER}"
    echo "QN_QUASI_TOL_OVERRIDE=${QN_QUASI_TOL_OVERRIDE}"
    echo "QN_OFFICIAL_DFOLS_PRESET=${QN_OFFICIAL_DFOLS_PRESET}"
    echo "QN_OFFICIAL_DFOLS_NPT=${QN_OFFICIAL_DFOLS_NPT}"
    echo "QN_OFFICIAL_DFOLS_MAXFUN=${QN_OFFICIAL_DFOLS_MAXFUN}"
    echo "QN_OFFICIAL_DFOLS_OBJFUN_HAS_NOISE=${QN_OFFICIAL_DFOLS_OBJFUN_HAS_NOISE}"
    echo "QN_OFFICIAL_DFOLS_RHOBEG=${QN_OFFICIAL_DFOLS_RHOBEG}"
    echo "QN_OFFICIAL_DFOLS_RHOEND=${QN_OFFICIAL_DFOLS_RHOEND}"
    echo "QN_OFFICIAL_DFOLS_MODEL_ABS_TOL=${QN_OFFICIAL_DFOLS_MODEL_ABS_TOL}"
    echo "QN_OFFICIAL_DFOLS_MODEL_REL_TOL=${QN_OFFICIAL_DFOLS_MODEL_REL_TOL}"
    echo "TLTM_OFFICIAL_DFOLS_PYTHONPATH=${TLTM_OFFICIAL_DFOLS_PYTHONPATH}"
    echo "INTODE_SOLVER_ASSIST_POLICY=${INTODE_SOLVER_ASSIST_POLICY}"
    echo "TLTM_STAGE3_METHOD_ASSIST_POLICY=${TLTM_STAGE3_METHOD_ASSIST_POLICY}"
  } > "${out_subdir}/method_manifest.env"

  (
    export TLTM_ODE_CONTROLLER_POLICY="${policy}"
    python3 scripts/run_stage3_3_multiseed.py \
      --repo-root . \
      --config "${TLTM_CONFIG_JSON}" \
      --methods "${TLTM_METHODS}" \
      --max-seeds "${TLTM_MAX_SEEDS}" \
      --seed-offset "${TLTM_SEED_OFFSET}" \
      --output-subdir "${out_subdir}" \
      --logs-subdir "${log_subdir}" \
      --log-prefix "f18b4o_${label}_npt5_r0055_1k" \
      --report-title "F18b.4o ${label} ODEX telemetry npt5_r0055 10seed 1k PBS screen" \
      --schedule "${TLTM_SCHEDULE}" \
      --pair-order "${TLTM_PAIR_ORDER}" \
      --task-method-order "${TLTM_TASK_METHOD_ORDER}" \
      --jobs "${TLTM_RUN_JOBS_PER_POLICY}" \
      --stage2-threads 1 \
      --eval-threads 1 \
      --allow-oversubscribe \
      --skip-build
  ) > "${log_subdir}/policy_driver.log" 2>&1
}

run_policy tltm_endpoint tltm_endpoint &
PID_TLTM=$!
run_policy hairer_experimental hairer_experimental &
PID_HAIRER=$!

wait "${PID_TLTM}"
wait "${PID_HAIRER}"

python3 - <<'PY'
import csv
from pathlib import Path

root = Path("output/tests") / Path(__import__("os").environ["TLTM_CAMPAIGN"])
for label in ("tltm_endpoint", "hairer_experimental"):
    path = root / label / "aggregated_summary_table.csv"
    with path.open() as f:
        rows = list(csv.DictReader(f))
    print("[F18B4O]", label, "rows=", len(rows))
    for row in rows:
        print(
            "[F18B4O]",
            label,
            row.get("method", ""),
            "runtime_mean=", row.get("mean_runtime_total", ""),
            "odex_calls=", row.get("total_odex_calls", ""),
            "rhs_per_call=", row.get("mean_odex_rhs_per_call", ""),
            "midpoint_rows_per_call=", row.get("mean_odex_midpoint_rows_per_call", ""),
            "kplus1_per_call=", row.get("mean_odex_kplus1_attempts_per_call", ""),
            "kplus1_rejects_per_call=", row.get("mean_odex_kplus1_rejects_per_call", ""),
        )
PY
