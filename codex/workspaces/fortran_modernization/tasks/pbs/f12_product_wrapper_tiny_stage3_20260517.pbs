#!/bin/bash
#PBS -N f12_wrap
#PBS -q C8
#PBS -l select=1:ncpus=8:mpiprocs=8:mem=8gb
#PBS -l walltime=01:00:00
#PBS -j oe

set -euo pipefail

if [ -f /etc/profile.d/modules.sh ]; then
  # shellcheck source=/dev/null
  . /etc/profile.d/modules.sh
fi
if [ -f /usr/share/Modules/init/bash ]; then
  # shellcheck source=/dev/null
  . /usr/share/Modules/init/bash
fi
module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

: "${TLTM_WORKTREE:=/lustre1/home/cychou/TLTM_worktrees/fortran_modernization}"
: "${TLTM_EXPECTED_GIT_BRANCH:=codex/fortran-modernization}"
: "${TLTM_EXPECTED_GIT_COMMIT:?TLTM_EXPECTED_GIT_COMMIT is required}"
: "${TLTM_PRODUCT_GATE_LABEL:=f12_product_wrapper_tiny_stage3_20260517}"
: "${TLTM_PRODUCT_GATE_ALLOW_OVERWRITE:=0}"
: "${TLTM_PRODUCT_GATE_CONFIG_JSON:=codex/workspaces/fortran_modernization/tasks/config/f12_product_wrapper_tiny_stage3.json}"
: "${TLTM_PRODUCT_GATE_MAX_SEEDS:=1}"
: "${TLTM_PRODUCT_GATE_JOBS:=1}"
: "${TLTM_BUILD_JOBS:=8}"

cd "${TLTM_WORKTREE}"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
CURRENT_COMMIT="$(git rev-parse HEAD)"
CURRENT_SHORT="$(git rev-parse --short=12 HEAD)"
if [ "${CURRENT_BRANCH}" != "${TLTM_EXPECTED_GIT_BRANCH}" ]; then
  echo "[ERROR] expected branch ${TLTM_EXPECTED_GIT_BRANCH}, got ${CURRENT_BRANCH}" >&2
  exit 2
fi
if [ "${CURRENT_COMMIT}" != "${TLTM_EXPECTED_GIT_COMMIT}" ]; then
  echo "[ERROR] expected commit ${TLTM_EXPECTED_GIT_COMMIT}, got ${CURRENT_COMMIT}" >&2
  exit 2
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "[ERROR] working tree is dirty; refusing F12 product-wrapper gate" >&2
  git status --short >&2
  exit 2
fi

RUN_STAMP="${TLTM_RUN_STAMP:-$(date +%Y%m%dT%H%M%S)}"
CAMPAIGN="${TLTM_PRODUCT_GATE_LABEL}_${RUN_STAMP}_${CURRENT_SHORT}"
OUT_ROOT="${TLTM_WORKTREE}/output/tests/fortran_modernization/${CAMPAIGN}"
LOG_ROOT="${TLTM_WORKTREE}/output/logs/fortran_modernization/${CAMPAIGN}"
BOOT_LOG="${LOG_ROOT}/pbs_boot.log"

if [ -e "${OUT_ROOT}" ] || [ -e "${LOG_ROOT}" ]; then
  if [ "${TLTM_PRODUCT_GATE_ALLOW_OVERWRITE}" != "1" ]; then
    echo "[ERROR] output/log path exists; set TLTM_PRODUCT_GATE_ALLOW_OVERWRITE=1 to rerun" >&2
    echo "OUT_ROOT=${OUT_ROOT}" >&2
    echo "LOG_ROOT=${LOG_ROOT}" >&2
    exit 3
  fi
  rm -rf "${OUT_ROOT}" "${LOG_ROOT}"
fi
mkdir -p "${OUT_ROOT}" "${LOG_ROOT}"
exec > "${BOOT_LOG}" 2>&1

date -Is
hostname
pwd
echo "branch=${CURRENT_BRANCH}"
echo "commit=${CURRENT_COMMIT}"
echo "config=${TLTM_PRODUCT_GATE_CONFIG_JSON}"
echo "out_root=${OUT_ROOT}"
echo "log_root=${LOG_ROOT}"
echo "pbs_jobid=${PBS_JOBID:-}"
echo "pbs_queue=${PBS_QUEUE:-}"

PYTHON_FOR_DFOLS="${TLTM_DFOLS_PYTHON:-}"
if [ -z "${PYTHON_FOR_DFOLS}" ]; then
  if command -v python3.11 >/dev/null 2>&1; then
    PYTHON_FOR_DFOLS="$(command -v python3.11)"
  elif command -v python3.9 >/dev/null 2>&1; then
    PYTHON_FOR_DFOLS="$(command -v python3.9)"
  else
    echo "[ERROR] Need python3.9+ for official DFO-LS package." >&2
    exit 4
  fi
fi

PY_VERSION="$("${PYTHON_FOR_DFOLS}" - <<'PY'
import sys
print("{}.{}".format(sys.version_info[0], sys.version_info[1]))
PY
)"
PY_INCLUDE="$("${PYTHON_FOR_DFOLS}" - <<'PY'
import sysconfig
print(sysconfig.get_paths()["include"])
PY
)"
PY_LIBDIR="$("${PYTHON_FOR_DFOLS}" - <<'PY'
import sysconfig
print(sysconfig.get_config_var("LIBDIR") or "")
PY
)"
PY_LDLIBRARY="$("${PYTHON_FOR_DFOLS}" - <<'PY'
import sysconfig
print(sysconfig.get_config_var("LDLIBRARY") or "")
PY
)"
PY_EMBED_EXTRA_LDFLAGS="$("${PYTHON_FOR_DFOLS}" - <<'PY'
import sysconfig
print(" ".join(str(sysconfig.get_config_var(k) or "") for k in ("LIBS", "SYSLIBS", "LINKFORSHARED")))
PY
)"

if [ -n "${TLTM_PYTHON_INCLUDE_DIR:-}" ]; then
  if [ ! -f "${TLTM_PYTHON_INCLUDE_DIR}/Python.h" ]; then
    echo "[ERROR] TLTM_PYTHON_INCLUDE_DIR lacks Python.h: ${TLTM_PYTHON_INCLUDE_DIR}" >&2
    exit 4
  fi
  PY_HEADER_CFLAGS="-I${TLTM_PYTHON_INCLUDE_DIR}"
  if grep -q 'pyconfig-' "${TLTM_PYTHON_INCLUDE_DIR}/pyconfig.h" && ! ls "${TLTM_PYTHON_INCLUDE_DIR}"/pyconfig-*.h >/dev/null 2>&1; then
    if ls "${PY_INCLUDE}"/pyconfig-*.h >/dev/null 2>&1; then
      PY_HEADER_CFLAGS="${PY_HEADER_CFLAGS} -I${PY_INCLUDE}"
    else
      echo "[ERROR] Python headers require a pyconfig platform fragment; set PYTHON_EMBED_CFLAGS or TLTM_PYTHON_INCLUDE_DIR" >&2
      exit 4
    fi
  fi
  export PYTHON_EMBED_CFLAGS="${PY_HEADER_CFLAGS}${PYTHON_EMBED_CFLAGS:+ ${PYTHON_EMBED_CFLAGS}}"
elif [ -f "${PY_INCLUDE}/Python.h" ]; then
  :
elif [ "${PY_VERSION}" = "3.11" ]; then
  : "${TLTM_PYTHON_DEVEL_ROOT:=${PWD}/.deps/python-devel-3.11}"
  PY_DEVEL_INCLUDE="${TLTM_PYTHON_DEVEL_ROOT}/usr/include/python3.11"
  if [ ! -f "${PY_DEVEL_INCLUDE}/Python.h" ]; then
    echo "[ERROR] missing Python.h; set TLTM_PYTHON_INCLUDE_DIR or prepare ${PY_DEVEL_INCLUDE}" >&2
    exit 4
  fi
  PY_HEADER_CFLAGS="-I${PY_DEVEL_INCLUDE}"
  if grep -q 'pyconfig-' "${PY_DEVEL_INCLUDE}/pyconfig.h" && ! ls "${PY_DEVEL_INCLUDE}"/pyconfig-*.h >/dev/null 2>&1; then
    if ls "${PY_INCLUDE}"/pyconfig-*.h >/dev/null 2>&1; then
      PY_HEADER_CFLAGS="${PY_HEADER_CFLAGS} -I${PY_INCLUDE}"
    else
      echo "[ERROR] extracted Python headers require a pyconfig platform fragment; set TLTM_PYTHON_INCLUDE_DIR" >&2
      exit 4
    fi
  fi
  export PYTHON_EMBED_CFLAGS="${PY_HEADER_CFLAGS}${PYTHON_EMBED_CFLAGS:+ ${PYTHON_EMBED_CFLAGS}}"
else
  echo "[ERROR] Python.h missing for ${PYTHON_FOR_DFOLS} (${PY_VERSION}); set TLTM_PYTHON_INCLUDE_DIR" >&2
  exit 4
fi

if [ -z "${PYTHON_EMBED_LDFLAGS:-}" ] && [ -n "${PY_LIBDIR}" ] && [ -n "${PY_LDLIBRARY}" ]; then
  if [ -f "${PY_LIBDIR}/${PY_LDLIBRARY}" ]; then
    export PYTHON_EMBED_LDFLAGS="${PY_LIBDIR}/${PY_LDLIBRARY} ${PY_EMBED_EXTRA_LDFLAGS}"
  elif [ -f "${PY_LIBDIR}/${PY_LDLIBRARY}.1.0" ]; then
    export PYTHON_EMBED_LDFLAGS="${PY_LIBDIR}/${PY_LDLIBRARY}.1.0 ${PY_EMBED_EXTRA_LDFLAGS}"
  fi
fi

if [ ! -x .venv-dfols/bin/python ]; then
  "${PYTHON_FOR_DFOLS}" -m venv .venv-dfols
fi
.venv-dfols/bin/python -m pip install -q -r requirements/external-dfols.txt
export TLTM_OFFICIAL_DFOLS_PYTHONPATH="$(
  .venv-dfols/bin/python - <<'PY'
import site
print(":".join(site.getsitepackages()))
PY
)"
.venv-dfols/bin/python - <<'PY'
import dfols, numpy
print("dfols_version={}".format(getattr(dfols, "__version__", "unknown")))
print("numpy_version={}".format(numpy.__version__))
PY

MAKE_ARGS=(
  -C build
  -j "${TLTM_BUILD_JOBS}"
  OMP=1
  ENABLE_OFFICIAL_DFOLS=1
  PYTHON="${PYTHON_FOR_DFOLS}"
)
if [ -n "${PYTHON_EMBED_CFLAGS:-}" ]; then
  MAKE_ARGS+=(PYTHON_EMBED_CFLAGS="${PYTHON_EMBED_CFLAGS}")
fi
if [ -n "${PYTHON_EMBED_LDFLAGS:-}" ]; then
  MAKE_ARGS+=(PYTHON_EMBED_LDFLAGS="${PYTHON_EMBED_LDFLAGS}")
fi
make "${MAKE_ARGS[@]}" ../bin/run_tltm_stage2 ../bin/evaluate_expectations

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export OMP_PROC_BIND=true
export OMP_PLACES=cores

export CONSTRAINT_FAIL_CAPTURE_START_SAMPLE=2147483647
export TLTM_STAGE2_RNG_STREAM_CONTRACT=stage2_kernel_rng_v2
export TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE=1e-13
export QN_REVERSE_GATE_ENABLED=1
export QN_REVERSE_GATE_TOL=1e-8
export QN_S1_PROBE_MAX_ITER=28
export QN_S1_NEAR_RESCUE_ENABLED=0
export QN_S1_NONNEAR_RESCUE_ENABLED=0
export QN_QUASI_GLOBAL_FALLBACK_ENABLED=0
export QN_OFFICIAL_DFOLS_PRESET=stable_gate77
export QN_OFFICIAL_DFOLS_NPT=5
export QN_OFFICIAL_DFOLS_MAXFUN=500
export QN_OFFICIAL_DFOLS_OBJFUN_HAS_NOISE=1
export QN_OFFICIAL_DFOLS_RHOBEG=0.055
export QN_OFFICIAL_DFOLS_RHOEND=1e-16
export QN_OFFICIAL_DFOLS_MODEL_ABS_TOL=1e-30
export QN_OFFICIAL_DFOLS_MODEL_REL_TOL=0

python3 scripts/run_tltm_product.py \
  --repo-root . \
  --config "${TLTM_PRODUCT_GATE_CONFIG_JSON}" \
  --method-set canonical_pair \
  --max-seeds "${TLTM_PRODUCT_GATE_MAX_SEEDS}" \
  --jobs "${TLTM_PRODUCT_GATE_JOBS}" \
  --stage2-threads 1 \
  --eval-threads 1 \
  --schedule paired \
  --pair-order alternating \
  --output-subdir "${OUT_ROOT}/product_wrapper" \
  --logs-subdir "${LOG_ROOT}/product_wrapper" \
  --log-prefix f12_product_wrapper \
  --report-title "F12 Product Wrapper Tiny Screen" \
  --skip-build

echo "[F12][DONE] product wrapper tiny screen completed"
