#!/bin/bash
#PBS -N qn10k_fbnr
#PBS -q C12
#PBS -l select=1:ncpus=20:mpiprocs=20:mem=8gb
#PBS -l walltime=04:00:00
#PBS -o /lustre1/home/cychou/TLTM_worktrees/qn_error_handling_validation/output/logs/qn_error_handling/qn10k_fb_norefine_ct1e13_qn1e13.pbs.out
#PBS -e /lustre1/home/cychou/TLTM_worktrees/qn_error_handling_validation/output/logs/qn_error_handling/qn10k_fb_norefine_ct1e13_qn1e13.pbs.err

set -euo pipefail
module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

WORKTREE="/lustre1/home/cychou/TLTM_worktrees/qn_error_handling_validation"
EXPECTED_BRANCH="codex/qn-error-handling-validation"
EXPECTED_COMMIT="${TLTM_EXPECTED_GIT_COMMIT:?TLTM_EXPECTED_GIT_COMMIT is required}"

cd "${WORKTREE}"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
CURRENT_COMMIT="$(git rev-parse HEAD)"
if [ "${CURRENT_BRANCH}" != "${EXPECTED_BRANCH}" ]; then
  echo "[ERROR] expected branch ${EXPECTED_BRANCH}, got ${CURRENT_BRANCH}" >&2
  exit 2
fi
if [ "${CURRENT_COMMIT}" != "${EXPECTED_COMMIT}" ]; then
  echo "[ERROR] expected commit ${EXPECTED_COMMIT}, got ${CURRENT_COMMIT}" >&2
  exit 2
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "[ERROR] working tree is dirty; refusing validation run" >&2
  git status --short >&2
  exit 2
fi

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OMP_PROC_BIND=true
export OMP_PLACES=cores
export CONSTRAINT_FAIL_CAPTURE_START_SAMPLE=2147483647

export TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE=1e-13
export QN_REVERSE_GATE_ENABLED=1
export QN_REVERSE_GATE_TOL=1e-8
export QN_S1_PROBE_MAX_ITER=28
export QN_S1_NEAR_RESCUE_ENABLED=0
export QN_S1_NONNEAR_RESCUE_ENABLED=0
export QN_QUASI_GLOBAL_FALLBACK_ENABLED=0
export QN_QUASI_TOL_OVERRIDE=1e-13

OUT_SUBDIR="output/tests/qn_error_handling/20260509_10seed_10k_fb_norefine_ct1e13_qn1e13"
LOG_SUBDIR="output/logs/qn_error_handling/20260509_10seed_10k_fb_norefine_ct1e13_qn1e13"
rm -rf "${OUT_SUBDIR}" "${LOG_SUBDIR}"
mkdir -p "${LOG_SUBDIR}"

if [ ! -f build/makefile ]; then
  mkdir -p build
  cp /lustre1/home/cychou/TLTM/build/makefile build/makefile
fi
make -C build ../bin/run_tltm_stage2

{
  echo "job_tag=qn_error_handling_10k_20260509_fb_norefine_ct1e13_qn1e13"
  echo "submitted_for=fortran_modernization_QN_error_handling_10k_validation"
  echo "date_start=$(date -Is)"
  echo "hostname=$(hostname)"
  echo "pwd=$(pwd)"
  echo "git_branch=${CURRENT_BRANCH}"
  echo "git_commit=${CURRENT_COMMIT}"
  echo "pbs_script=codex/workspaces/fortran_modernization/tasks/pbs/qn_error_handling_10k_validation_20260509_fb_norefine.pbs"
  echo "config=docs/stage_3_4_t035_paired_10k_10seed.json"
  echo "method=fb_norefine"
  echo "max_seeds=10"
  echo "cycles_per_seed=10000"
  echo "constraint_tol_override=${TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE}"
  echo "qn_quasi_tol_override=${QN_QUASI_TOL_OVERRIDE}"
  echo "reverse_gate_enabled=${QN_REVERSE_GATE_ENABLED}"
  echo "reverse_gate_tol=${QN_REVERSE_GATE_TOL}"
  echo "qn_s1_probe_max_iter=${QN_S1_PROBE_MAX_ITER}"
  echo "output_subdir=${OUT_SUBDIR}"
  echo "logs_subdir=${LOG_SUBDIR}"
} > "${LOG_SUBDIR}/run_manifest.txt"

python3 scripts/run_stage3_3_multiseed.py \
  --repo-root . \
  --config docs/stage_3_4_t035_paired_10k_10seed.json \
  --methods fb_norefine \
  --max-seeds 10 \
  --output-subdir "${OUT_SUBDIR}" \
  --logs-subdir "${LOG_SUBDIR}" \
  --log-prefix "qn10k_fb_norefine_ct1e13_qn1e13" \
  --report-title "QN error-handling 10k validation fb_norefine ct1e-13 qn1e-13" \
  --schedule task \
  --task-method-order fb_first \
  --jobs 20 \
  --stage2-threads 1 \
  --eval-threads 1 \
  --skip-build

echo "date_end=$(date -Is)" >> "${LOG_SUBDIR}/run_manifest.txt"
