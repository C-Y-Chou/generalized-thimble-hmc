#!/bin/bash
#PBS -N stn6samp
#PBS -q C8
#PBS -l select=1:ncpus=1:mpiprocs=1:mem=4gb
#PBS -l walltime=00:30:00
#PBS -j oe

set -euo pipefail

if [ -f /etc/profile.d/modules.sh ]; then
  # shellcheck source=/dev/null
  . /etc/profile.d/modules.sh
fi
if [ -f /usr/share/Modules/init/bash ]; then
  # shellcheck source=/dev/null
  . /usr/share/Modules/init/bash
fi
module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

: "${TLTM_WORKTREE:=/lustre1/home/cychou/TLTM_worktrees/fortran_modernization}"
: "${TLTM_EXPECTED_GIT_BRANCH:=codex/fortran-modernization}"
: "${TLTM_EXPECTED_GIT_COMMIT:?TLTM_EXPECTED_GIT_COMMIT is required}"
: "${TLTM_DFOLS_SAMPLE_GROUP:=stephanov_n6_dfols_sample_array_20260524}"
: "${TLTM_OUTPUT_ROOT:=output/stephanov_dfols_tuning}"
: "${TLTM_DFOLS_SAMPLE_CASE_DIR:=output/stephanov_dfols_tuning/stephanov_n6_dfols_policy_scan_noisefixed0_parallel_20260524a/base_auto_r025_rho16_abs26/qn_attempt_capture/record_0505}"
: "${TLTM_PARAMETERS_FILE:=data/parameters_stephanov_n6_mu06_t1e6_eps010_nstep6.dat}"
: "${TLTM_DFOLS_SAMPLE_IDS:=all}"
: "${TLTM_DFOLS_SAMPLE_MAXFUN:=1200}"
: "${TLTM_DFOLS_SAMPLE_NPTS:=0}"
: "${TLTM_DFOLS_SAMPLE_RHOBEGS:=0.20,0.25,0.30,0.35}"
: "${TLTM_DFOLS_SAMPLE_RHOENDS:=1e-13}"
: "${TLTM_DFOLS_SAMPLE_MODEL_ABS_TOLS:=1e-26}"
: "${TLTM_DFOLS_SAMPLE_MODEL_REL_TOLS:=0}"
: "${TLTM_DFOLS_SAMPLE_GAMMA_DECS:=default,0.25,0.75}"
: "${TLTM_DFOLS_SAMPLE_SAFETY_STEP_THRESHES:=default}"
: "${TLTM_DFOLS_SAMPLE_GROWING_SAFETY_DO_SAFETY_STEPS:=default}"
: "${TLTM_DFOLS_SAMPLE_GROWING_SAFETY_REDUCE_DELTAS:=default}"
: "${TLTM_DFOLS_SAMPLE_GROWING_SAFETY_FULL_GEOM_STEPS:=default}"
: "${TLTM_DFOLS_SAMPLE_OBJFUN_HAS_NOISE:=0}"
: "${TLTM_DFOLS_SAMPLE_RESIDUAL_SUCCESS_TOL:=1e-13}"
: "${TLTM_DFOLS_SAMPLE_SAVE_DIAGNOSTICS:=1}"

TLTM_DFOLS_SAMPLE_TASK_INDEX="${TLTM_DFOLS_SAMPLE_TASK_INDEX:-${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-}}}"
if [ -z "${TLTM_DFOLS_SAMPLE_TASK_INDEX}" ]; then
  echo "[ERROR] missing PBS array index; submit with qsub -J 1-N or set TLTM_DFOLS_SAMPLE_TASK_INDEX." >&2
  exit 2
fi

cd "${TLTM_WORKTREE}"
LOG_ROOT="output/logs/stephanov_dfols_tuning/${TLTM_DFOLS_SAMPLE_GROUP}"
mkdir -p "${LOG_ROOT}"
exec > "${LOG_ROOT}/pbs_boot_${PBS_JOBID:-manual}_${TLTM_DFOLS_SAMPLE_TASK_INDEX}.log" 2>&1

echo "RUN_DATE=$(date -Is)"
echo "HOSTNAME=$(hostname)"
echo "PBS_JOBID=${PBS_JOBID:-manual}"
echo "PBS_ARRAY_INDEX=${PBS_ARRAY_INDEX:-}"
echo "PBS_ARRAYID=${PBS_ARRAYID:-}"
echo "TLTM_WORKTREE=${TLTM_WORKTREE}"
echo "TLTM_DFOLS_SAMPLE_GROUP=${TLTM_DFOLS_SAMPLE_GROUP}"
echo "TLTM_DFOLS_SAMPLE_TASK_INDEX=${TLTM_DFOLS_SAMPLE_TASK_INDEX}"
echo "TLTM_DFOLS_SAMPLE_CASE_DIR=${TLTM_DFOLS_SAMPLE_CASE_DIR}"
echo "TLTM_DFOLS_SAMPLE_IDS=${TLTM_DFOLS_SAMPLE_IDS}"
echo "TLTM_DFOLS_SAMPLE_MAXFUN=${TLTM_DFOLS_SAMPLE_MAXFUN}"
echo "TLTM_DFOLS_SAMPLE_RHOBEGS=${TLTM_DFOLS_SAMPLE_RHOBEGS}"
echo "TLTM_DFOLS_SAMPLE_RHOENDS=${TLTM_DFOLS_SAMPLE_RHOENDS}"
echo "TLTM_DFOLS_SAMPLE_GAMMA_DECS=${TLTM_DFOLS_SAMPLE_GAMMA_DECS}"
echo "TLTM_DFOLS_SAMPLE_SAFETY_STEP_THRESHES=${TLTM_DFOLS_SAMPLE_SAFETY_STEP_THRESHES}"
echo "TLTM_DFOLS_SAMPLE_GROWING_SAFETY_DO_SAFETY_STEPS=${TLTM_DFOLS_SAMPLE_GROWING_SAFETY_DO_SAFETY_STEPS}"
echo "TLTM_DFOLS_SAMPLE_GROWING_SAFETY_REDUCE_DELTAS=${TLTM_DFOLS_SAMPLE_GROWING_SAFETY_REDUCE_DELTAS}"
echo "TLTM_DFOLS_SAMPLE_GROWING_SAFETY_FULL_GEOM_STEPS=${TLTM_DFOLS_SAMPLE_GROWING_SAFETY_FULL_GEOM_STEPS}"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
CURRENT_COMMIT="$(git rev-parse HEAD)"
echo "GIT_BRANCH=${CURRENT_BRANCH}"
echo "GIT_COMMIT=${CURRENT_COMMIT}"
echo "EXPECTED_GIT_COMMIT=${TLTM_EXPECTED_GIT_COMMIT}"
if [ "${CURRENT_BRANCH}" != "${TLTM_EXPECTED_GIT_BRANCH}" ]; then
  echo "[ERROR] expected branch ${TLTM_EXPECTED_GIT_BRANCH}, got ${CURRENT_BRANCH}" >&2
  exit 2
fi
if [ "${CURRENT_COMMIT}" != "${TLTM_EXPECTED_GIT_COMMIT}" ]; then
  echo "[ERROR] expected commit ${TLTM_EXPECTED_GIT_COMMIT}, got ${CURRENT_COMMIT}" >&2
  exit 2
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "[ERROR] working tree is dirty; refusing one-sample DFO-LS array task" >&2
  git status --short >&2
  exit 2
fi
if [ ! -x .venv-dfols/bin/python ]; then
  echo "[ERROR] missing .venv-dfols/bin/python" >&2
  exit 4
fi
if [ ! -x bin/evaluate_btn_residual_case ]; then
  echo "[ERROR] missing bin/evaluate_btn_residual_case" >&2
  exit 4
fi
if [ ! -d "${TLTM_DFOLS_SAMPLE_CASE_DIR}" ]; then
  echo "[ERROR] missing case dir: ${TLTM_DFOLS_SAMPLE_CASE_DIR}" >&2
  exit 4
fi
if [ ! -f "${TLTM_PARAMETERS_FILE}" ]; then
  echo "[ERROR] missing parameter file: ${TLTM_PARAMETERS_FILE}" >&2
  exit 4
fi

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export OMP_PROC_BIND=false

export TLTM_ODE_BACKEND=dop853
export TLTM_DOP853_HINIT_ENABLED=1
export TLTM_DOP853_STIFFNESS_CHECK_ENABLED=1
export TLTM_DOP853_STIFFNESS_CHECK_INTERVAL=1000
export TLTM_DOP853_STIFFNESS_MAX_HITS=15
export TLTM_DOP853_STIFFNESS_THRESHOLD=6.1

ARGS=(
  codex/workspaces/fortran_modernization/tasks/scripts/run_stephanov_n6_dfols_sample_array.py
  --repo-root "${TLTM_WORKTREE}"
  --case-dir "${TLTM_DFOLS_SAMPLE_CASE_DIR}"
  --output-root "${TLTM_OUTPUT_ROOT}"
  --run-group "${TLTM_DFOLS_SAMPLE_GROUP}"
  --sample-ids "${TLTM_DFOLS_SAMPLE_IDS}"
  --task-index "${TLTM_DFOLS_SAMPLE_TASK_INDEX}"
  --maxfun "${TLTM_DFOLS_SAMPLE_MAXFUN}"
  --npts "${TLTM_DFOLS_SAMPLE_NPTS}"
  --rhobegs "${TLTM_DFOLS_SAMPLE_RHOBEGS}"
  --rhoends "${TLTM_DFOLS_SAMPLE_RHOENDS}"
  --model-abs-tols "${TLTM_DFOLS_SAMPLE_MODEL_ABS_TOLS}"
  --model-rel-tols "${TLTM_DFOLS_SAMPLE_MODEL_REL_TOLS}"
  --gamma-decs "${TLTM_DFOLS_SAMPLE_GAMMA_DECS}"
  --safety-step-threshes "${TLTM_DFOLS_SAMPLE_SAFETY_STEP_THRESHES}"
  --growing-safety-do-safety-steps "${TLTM_DFOLS_SAMPLE_GROWING_SAFETY_DO_SAFETY_STEPS}"
  --growing-safety-reduce-deltas "${TLTM_DFOLS_SAMPLE_GROWING_SAFETY_REDUCE_DELTAS}"
  --growing-safety-full-geom-steps "${TLTM_DFOLS_SAMPLE_GROWING_SAFETY_FULL_GEOM_STEPS}"
  --objfun-has-noise "${TLTM_DFOLS_SAMPLE_OBJFUN_HAS_NOISE}"
  --residual-success-tol "${TLTM_DFOLS_SAMPLE_RESIDUAL_SUCCESS_TOL}"
  --parameters-file "${TLTM_PARAMETERS_FILE}"
  --force
)
if [ "${TLTM_DFOLS_SAMPLE_SAVE_DIAGNOSTICS}" = "1" ]; then
  ARGS+=(--save-diagnostics)
fi

/usr/bin/time -p .venv-dfols/bin/python "${ARGS[@]}"
