#!/bin/bash
#PBS -N m6refbuild
#PBS -j oe

set -euo pipefail

if [ -f /etc/profile.d/modules.sh ]; then
  . /etc/profile.d/modules.sh
fi
if [ -f /usr/share/Modules/init/bash ]; then
  . /usr/share/Modules/init/bash
fi
module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

: "${TLTM_WORKTREE:=/lustre1/home/cychou/TLTM}"
: "${TLTM_EXPECTED_GIT_BRANCH:?TLTM_EXPECTED_GIT_BRANCH is required}"
: "${TLTM_EXPECTED_GIT_COMMIT:?TLTM_EXPECTED_GIT_COMMIT is required}"
: "${TLTM_BUILD_JOBS:=16}"
: "${TLTM_RUN_GUARDRAILS:=1}"

cd "${TLTM_WORKTREE}"

: "${TLTM_PYTHON_DEVEL_ROOT:=${TLTM_WORKTREE}/.deps/python-devel-3.11}"
if [ -f "${TLTM_PYTHON_DEVEL_ROOT}/usr/include/python3.11/Python.h" ] && \
   [ -e "${TLTM_PYTHON_DEVEL_ROOT}/usr/lib64/libpython3.11.so" ]; then
  : "${PYTHON:=python3.11}"
  : "${PYTHON_EMBED_CFLAGS:=-I${TLTM_PYTHON_DEVEL_ROOT}/usr/include/python3.11}"
  : "${PYTHON_EMBED_LDFLAGS:=${TLTM_PYTHON_DEVEL_ROOT}/usr/lib64/libpython3.11.so -lpthread -ldl -lutil -lm}"
  export PYTHON PYTHON_EMBED_CFLAGS PYTHON_EMBED_LDFLAGS
  export LD_LIBRARY_PATH="${TLTM_PYTHON_DEVEL_ROOT}/usr/lib64${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
fi

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
CURRENT_COMMIT="$(git rev-parse HEAD)"
if [ "${CURRENT_BRANCH}" != "${TLTM_EXPECTED_GIT_BRANCH}" ]; then
  echo "[ERROR] expected branch ${TLTM_EXPECTED_GIT_BRANCH}, got ${CURRENT_BRANCH}" >&2
  exit 2
fi
if [ "${CURRENT_COMMIT}" != "${TLTM_EXPECTED_GIT_COMMIT}" ]; then
  echo "[ERROR] expected commit ${TLTM_EXPECTED_GIT_COMMIT}, got ${CURRENT_COMMIT}" >&2
  exit 2
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "[ERROR] working tree is dirty; refusing M6 reference preflight" >&2
  git status --short >&2
  exit 2
fi

LOG_DIR="output/logs/fortran_modernization/reference_datasets/preflight"
mkdir -p "${LOG_DIR}"
exec > "${LOG_DIR}/m6_reference_preflight_build.$(date +%Y%m%dT%H%M%S).log" 2>&1

date -Is
hostname
pwd
echo "branch=${CURRENT_BRANCH}"
echo "commit=${CURRENT_COMMIT}"
echo "build_jobs=${TLTM_BUILD_JOBS}"
echo "run_guardrails=${TLTM_RUN_GUARDRAILS}"
echo "python=${PYTHON:-auto}"
echo "python_embed_cflags=${PYTHON_EMBED_CFLAGS:-auto}"
echo "python_embed_ldflags=${PYTHON_EMBED_LDFLAGS:-auto}"

make -C build clean
make -C build -j "${TLTM_BUILD_JOBS}" ../bin/run_tltm_stage2 ../bin/evaluate_expectations

if [ "${TLTM_RUN_GUARDRAILS}" = "1" ]; then
  make -C build modernization_guardrails
fi

date -Is
