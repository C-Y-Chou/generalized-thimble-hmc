#!/bin/bash
#PBS -N stn6pfb
#PBS -q C8
#PBS -l select=1:ncpus=8:mpiprocs=8:mem=16gb
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail

if [ -f /etc/profile.d/modules.sh ]; then
  # shellcheck source=/dev/null
  . /etc/profile.d/modules.sh
fi
if [ -f /usr/share/Modules/init/bash ]; then
  # shellcheck source=/dev/null
  . /usr/share/Modules/init/bash
fi
module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

: "${TLTM_WORKTREE:=/lustre1/home/cychou/TLTM_worktrees/fortran_modernization}"
: "${TLTM_EXPECTED_GIT_BRANCH:=codex/fortran-modernization}"
: "${TLTM_EXPECTED_GIT_COMMIT:=}"
: "${TLTM_RUN_GROUP:=stephanov_n6_tltm_t003_ladder13_dop853_flowbank_32x3000_obs_20260523}"
: "${TLTM_CHUNK_NAME:=chunk00}"
: "${TLTM_RUN_NAME:=${TLTM_CHUNK_NAME}}"
: "${TLTM_HIGHFLOW_BANK_PACKAGE:=stephanov_n6_tltm_t003_ladder13_dop853_highflow_bank_8x600_20260523_xhist_b100_s5}"
: "${TLTM_INIT_FLOW_BANK_ROOT:=output/stephanov_flow_banks/${TLTM_HIGHFLOW_BANK_PACKAGE}/flow_bank_ladder13_dop853_dense_cache}"
: "${TLTM_RECORDS_SPEC:=0:101:202:303:404:505:606:707}"
: "${TLTM_CYCLES:=3000}"
: "${TLTM_SEED_BASE:=8930000}"
: "${TLTM_BUILD_ONLY:=0}"
: "${TLTM_BUILD_IN_JOB:=0}"
: "${TLTM_WRITE_COLD_X_HISTORY:=1}"
: "${TLTM_WRITE_FINAL_SNAPSHOT:=1}"
: "${TLTM_OUTPUT_ROOT:=output/stephanov_tltm_production/${TLTM_RUN_GROUP}}"
: "${TLTM_LOG_ROOT:=output/logs/stephanov_tltm_production/${TLTM_RUN_GROUP}/${TLTM_RUN_NAME}}"
: "${TLTM_SWAP_REFLOW_BACKEND:=direct}"
: "${TLTM_LOCAL_REFLOW_CACHE_MODE:=none}"

cd "${TLTM_WORKTREE}"
mkdir -p "${TLTM_LOG_ROOT}"
exec > "${TLTM_LOG_ROOT}/pbs_boot_${PBS_JOBID:-manual}.log" 2>&1

echo "RUN_DATE=$(date -Is)"
echo "HOSTNAME=$(hostname)"
echo "PBS_JOBID=${PBS_JOBID:-manual}"
echo "PBS_QUEUE=${PBS_QUEUE:-unknown}"
echo "TLTM_WORKTREE=${TLTM_WORKTREE}"
echo "TLTM_RUN_GROUP=${TLTM_RUN_GROUP}"
echo "TLTM_RUN_NAME=${TLTM_RUN_NAME}"
echo "TLTM_RECORDS_SPEC=${TLTM_RECORDS_SPEC}"
echo "TLTM_CYCLES=${TLTM_CYCLES}"
echo "TLTM_INIT_FLOW_BANK_ROOT=${TLTM_INIT_FLOW_BANK_ROOT}"
echo "TLTM_SWAP_REFLOW_BACKEND=${TLTM_SWAP_REFLOW_BACKEND}"
echo "TLTM_LOCAL_REFLOW_CACHE_MODE=${TLTM_LOCAL_REFLOW_CACHE_MODE}"

if [ -z "${TLTM_EXPECTED_GIT_COMMIT}" ]; then
  echo "[ERROR] TLTM_EXPECTED_GIT_COMMIT is required. Submit with qsub -v TLTM_EXPECTED_GIT_COMMIT=<commit>." >&2
  exit 2
fi

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
CURRENT_COMMIT="$(git rev-parse HEAD)"
echo "GIT_BRANCH=${CURRENT_BRANCH}"
echo "GIT_COMMIT=${CURRENT_COMMIT}"
echo "EXPECTED_GIT_COMMIT=${TLTM_EXPECTED_GIT_COMMIT}"
if [ "${CURRENT_BRANCH}" != "${TLTM_EXPECTED_GIT_BRANCH}" ]; then
  echo "[ERROR] expected branch ${TLTM_EXPECTED_GIT_BRANCH}, got ${CURRENT_BRANCH}" >&2
  exit 2
fi
if [ "${CURRENT_COMMIT}" != "${TLTM_EXPECTED_GIT_COMMIT}" ]; then
  echo "[ERROR] expected commit ${TLTM_EXPECTED_GIT_COMMIT}, got ${CURRENT_COMMIT}" >&2
  exit 2
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "[ERROR] working tree is dirty; refusing cluster production" >&2
  git status --short >&2
  exit 2
fi

if [ -x .venv-dfols/bin/python ]; then
  DFOLS_SITE_PACKAGES="$(.venv-dfols/bin/python - <<'PY'
import sysconfig
print(sysconfig.get_paths()["purelib"])
PY
)"
  export TLTM_OFFICIAL_DFOLS_PYTHONPATH="${DFOLS_SITE_PACKAGES}${TLTM_OFFICIAL_DFOLS_PYTHONPATH:+:${TLTM_OFFICIAL_DFOLS_PYTHONPATH}}"
fi

# Configure Python.h/libpython for the official DFO-LS C bridge on cluster02.
# shellcheck source=/dev/null
. codex/workspaces/fortran_modernization/tasks/scripts/python_embed_env.sh

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export OMP_PROC_BIND=false
export CONSTRAINT_FAIL_CAPTURE_START_SAMPLE=2147483647

export TLTM_ODE_BACKEND=dop853
export TLTM_DOP853_HINIT_ENABLED=1
export TLTM_DOP853_STIFFNESS_CHECK_ENABLED=1
export TLTM_DOP853_STIFFNESS_CHECK_INTERVAL=1000
export TLTM_DOP853_STIFFNESS_MAX_HITS=15
export TLTM_DOP853_STIFFNESS_THRESHOLD=6.1

export TLTM_STAGE2_SWAP_REFLOW_BACKEND="${TLTM_SWAP_REFLOW_BACKEND}"
export TLTM_STAGE2_LOCAL_REFLOW_CACHE_MODE="${TLTM_LOCAL_REFLOW_CACHE_MODE}"

if [ ! -d "${TLTM_INIT_FLOW_BANK_ROOT}/records" ] || [ ! -f "${TLTM_INIT_FLOW_BANK_ROOT}/diagnostics.csv" ]; then
  echo "[ERROR] dense flow-bank cache is missing under ${TLTM_INIT_FLOW_BANK_ROOT}" >&2
  exit 2
fi

TLTM_RECORDS="${TLTM_RECORDS_SPEC//:/,}"
python3 - "${TLTM_INIT_FLOW_BANK_ROOT}" "${TLTM_RECORDS}" 13 <<'PY'
import sys
from pathlib import Path

root = Path(sys.argv[1])
records = [int(item) for item in sys.argv[2].split(",") if item.strip()]
slot_count = int(sys.argv[3])
missing = []
for record in records:
    record_dir = root / "records" / f"record_{record:06d}"
    for slot in range(slot_count):
        slot_file = record_dir / f"slot_{slot:06d}.bin"
        if not slot_file.exists():
            missing.append(str(slot_file))
if missing:
    raise SystemExit("[ERROR] missing flow-bank slot files: " + ", ".join(missing[:10]))
print(f"FLOW_BANK_INPUT_OK records={len(records)} slots={slot_count} root={root}")
PY

if [ "${TLTM_BUILD_ONLY}" = "1" ] || [ "${TLTM_BUILD_IN_JOB}" = "1" ]; then
  make -C build clean
  make -C build OMP=1 PYTHON="${PYTHON}" PYTHON_EMBED_CFLAGS="${PYTHON_EMBED_CFLAGS}" \
    PYTHON_EMBED_LDFLAGS="${PYTHON_EMBED_LDFLAGS}" ../bin/run_tltm_stage2
fi

if [ "${TLTM_BUILD_ONLY}" = "1" ]; then
  echo "BUILD_ONLY_DONE=1"
  exit 0
fi

if [ ! -x bin/run_tltm_stage2 ]; then
  echo "[ERROR] bin/run_tltm_stage2 is missing or not executable; submit a build dependency first." >&2
  exit 2
fi

RUNNER_ARGS=(
  codex/workspaces/fortran_modernization/tasks/scripts/run_stephanov_n6_tltm_ladder.py
  --skip-build
  --init-flow-bank-root "${TLTM_INIT_FLOW_BANK_ROOT}"
  --records "${TLTM_RECORDS}"
  --cycles "${TLTM_CYCLES}"
  --jobs 8
  --threads 1
  --timeout-sec 43000
  --seed-base "${TLTM_SEED_BASE}"
  --ladder 0,1e-3,3e-3,7e-3,1e-2,1.3e-2,1.6e-2,1.8e-2,2e-2,2.25e-2,2.5e-2,2.75e-2,3e-2
  --parallel-local-updates 1
  --parallel-swaps 1
  --write-cold-observables
  --write-all-replica-observables
  --observable-stride 1
  --output-root "${TLTM_OUTPUT_ROOT}"
  --run-name "${TLTM_RUN_NAME}"
  --force
)
if [ "${TLTM_WRITE_COLD_X_HISTORY}" = "1" ]; then
  RUNNER_ARGS+=(--write-cold-x-history)
fi
if [ "${TLTM_WRITE_FINAL_SNAPSHOT}" = "1" ]; then
  RUNNER_ARGS+=(--write-final-snapshot)
fi

/usr/bin/time -p python3 "${RUNNER_ARGS[@]}"

SUMMARY="${TLTM_OUTPUT_ROOT}/${TLTM_RUN_NAME}/tltm_ladder_summary.csv"
AGGREGATE="${TLTM_OUTPUT_ROOT}/${TLTM_RUN_NAME}/tltm_ladder_aggregate.csv"
echo "SUMMARY=${SUMMARY}"
echo "AGGREGATE=${AGGREGATE}"
cat "${AGGREGATE}"
