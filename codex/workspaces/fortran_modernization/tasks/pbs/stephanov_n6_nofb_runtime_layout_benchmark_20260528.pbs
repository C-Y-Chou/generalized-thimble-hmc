#!/bin/bash
#PBS -N n6nofbrt
#PBS -q F
#PBS -l select=1:ncpus=32:mpiprocs=32:mem=96gb
#PBS -l walltime=04:00:00
#PBS -j oe

set -euo pipefail

if [ -f /etc/profile.d/modules.sh ]; then
  # shellcheck source=/dev/null
  . /etc/profile.d/modules.sh
fi
if [ -f /usr/share/Modules/init/bash ]; then
  # shellcheck source=/dev/null
  . /usr/share/Modules/init/bash
fi
module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

: "${TLTM_WORKTREE:=/lustre1/home/cychou/TLTM_worktrees/fortran_modernization_nofb_runtime_4e178db}"
: "${TLTM_EXPECTED_GIT_BRANCH:=codex/nofb-runtime-optimization-20260528}"
: "${TLTM_EXPECTED_GIT_COMMIT:?TLTM_EXPECTED_GIT_COMMIT is required}"
: "${TLTM_RUN_NAME:=stephanov_n6_nofb_runtime_layouts_40cyc_20260528a}"
: "${TLTM_OUTPUT_ROOT:=/lustre1/home/cychou/TLTM_worktrees/fortran_modernization/output/stephanov_runtime_benchmarks}"
: "${TLTM_LOG_ROOT:=/lustre1/home/cychou/TLTM_worktrees/fortran_modernization/output/logs/stephanov_runtime_benchmarks/${TLTM_RUN_NAME}}"
: "${TLTM_CYCLES:=40}"
: "${TLTM_LAYOUTS:=32x1,16x2,8x4,4x8,2x16,1x32}"
: "${TLTM_BLAS_THREADS:=1}"

cd "${TLTM_WORKTREE}"
mkdir -p "${TLTM_LOG_ROOT}"
exec > "${TLTM_LOG_ROOT}/pbs_boot_${PBS_JOBID:-manual}.log" 2>&1

echo "RUN_DATE=$(date -Is)"
echo "HOSTNAME=$(hostname)"
echo "PBS_JOBID=${PBS_JOBID:-manual}"
echo "PBS_QUEUE=${PBS_QUEUE:-unknown}"
echo "TLTM_WORKTREE=${TLTM_WORKTREE}"
echo "TLTM_RUN_NAME=${TLTM_RUN_NAME}"
echo "TLTM_CYCLES=${TLTM_CYCLES}"
echo "TLTM_LAYOUTS=${TLTM_LAYOUTS}"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
CURRENT_COMMIT="$(git rev-parse HEAD)"
echo "GIT_BRANCH=${CURRENT_BRANCH}"
echo "GIT_COMMIT=${CURRENT_COMMIT}"
echo "EXPECTED_GIT_COMMIT=${TLTM_EXPECTED_GIT_COMMIT}"
if [ "${CURRENT_BRANCH}" != "${TLTM_EXPECTED_GIT_BRANCH}" ]; then
  echo "[ERROR] expected branch ${TLTM_EXPECTED_GIT_BRANCH}, got ${CURRENT_BRANCH}" >&2
  exit 2
fi
if [ "${CURRENT_COMMIT}" != "${TLTM_EXPECTED_GIT_COMMIT}" ]; then
  echo "[ERROR] expected commit ${TLTM_EXPECTED_GIT_COMMIT}, got ${CURRENT_COMMIT}" >&2
  exit 2
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "[ERROR] working tree is dirty; refusing cluster benchmark" >&2
  git status --short >&2
  exit 2
fi

if [ -x .venv-dfols/bin/python ]; then
  DFOLS_SITE_PACKAGES="$(.venv-dfols/bin/python - <<'PY'
import sysconfig
print(sysconfig.get_paths()["purelib"])
PY
)"
  export TLTM_OFFICIAL_DFOLS_PYTHONPATH="${DFOLS_SITE_PACKAGES}${TLTM_OFFICIAL_DFOLS_PYTHONPATH:+:${TLTM_OFFICIAL_DFOLS_PYTHONPATH}}"
fi

# Configure Python.h/libpython for the official DFO-LS C bridge on cluster02.
# shellcheck source=/dev/null
. codex/workspaces/fortran_modernization/tasks/scripts/python_embed_env.sh

export OMP_DYNAMIC=FALSE
export MKL_DYNAMIC=FALSE
export CONSTRAINT_FAIL_CAPTURE_START_SAMPLE=2147483647

make -C build clean

/usr/bin/time -p python3 codex/workspaces/fortran_modernization/tasks/scripts/benchmark_stephanov_n6_nofb_runtime_layouts.py \
  --output-root "${TLTM_OUTPUT_ROOT}" \
  --run-name "${TLTM_RUN_NAME}" \
  --cycles "${TLTM_CYCLES}" \
  --layouts "${TLTM_LAYOUTS}" \
  --blas-threads "${TLTM_BLAS_THREADS}" \
  --total-ncpus 32 \
  --force

SUMMARY="${TLTM_OUTPUT_ROOT}/${TLTM_RUN_NAME}/benchmark_summary.csv"
README="${TLTM_OUTPUT_ROOT}/${TLTM_RUN_NAME}/README.md"
echo "SUMMARY=${SUMMARY}"
echo "README=${README}"
cat "${SUMMARY}"
