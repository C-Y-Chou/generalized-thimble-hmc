#!/bin/bash
#PBS -N wv1step
#PBS -q C17
#PBS -l select=1:ncpus=16:mpiprocs=16:mem=32gb
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail

if [ -f /etc/profile.d/modules.sh ]; then
  # shellcheck source=/dev/null
  . /etc/profile.d/modules.sh
fi
if [ -f /usr/share/Modules/init/bash ]; then
  # shellcheck source=/dev/null
  . /usr/share/Modules/init/bash
fi
module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

: "${TLTM_WORKTREE:?TLTM_WORKTREE is required}"
: "${TLTM_SOURCE_PIN_FILE:=}"
: "${TLTM_REQUIRE_SOURCE_PIN:=1}"
: "${TLTM_EXPECTED_SOURCE_PIN_ID:=}"
: "${TLTM_RUN_NAME:=wv_hmc_one_step_invariant_n2_t001_20260602}"
: "${TLTM_OUTPUT_ROOT:=/lustre1/home/cychou/TLTM_worktrees/fortran_modernization/output/wv_hmc_one_step_invariant_20260602}"
: "${TLTM_LOG_ROOT:=/lustre1/home/cychou/TLTM_worktrees/fortran_modernization/output/logs/wv_hmc_one_step_invariant_20260602/${TLTM_RUN_NAME}}"
: "${TLTM_PARAMETERS_FILE:=data/parameters_stephanov_n2_smoke.dat}"
: "${WV_ONE_SEED_START:=9940001}"
: "${WV_ONE_SAMPLE_COUNT:=1024}"
: "${WV_ONE_CYCLES:=1}"
: "${WV_ONE_MEASUREMENT_START_CYCLE:=1}"
: "${WV_ONE_STEP_SIZE:=0.003}"
: "${WV_ONE_NUM_STEPS:=20}"
: "${WV_ONE_JOBS:=16}"
: "${WV_ONE_TIMEOUT_SEC:=300}"
: "${WV_ONE_T0:=0.0}"
: "${WV_ONE_T1:=0.01}"
: "${WV_ONE_D0:=0.0001}"
: "${WV_ONE_D1:=0.0025}"
: "${WV_ONE_MEASUREMENT_T0:=0.0}"
: "${WV_ONE_MEASUREMENT_T1:=0.01}"
: "${WV_ONE_W_PROFILE:=paper_wall}"
: "${WV_ONE_W_GAMMA:=0.0}"
: "${WV_ONE_W_C0:=1.0}"
: "${WV_ONE_W_C1:=1.0}"
: "${WV_ONE_BOUNDARY_POLICY:=paper_full_flip}"
: "${WV_ONE_CONSTRAINT_TOL:=1.0e-10}"
: "${WV_ONE_CONSTRAINT_MAX_ITER:=96}"
: "${WV_ONE_REVERSE_GATE_STATE_TOL:=1.0e-5}"
: "${WV_ONE_REVERSE_GATE_MOMENTUM_TOL:=1.0e-3}"
: "${WV_ONE_ORACLE_ORDER:=3}"
: "${WV_ONE_ORACLE_T_ORDER:=5}"
: "${WV_ONE_RESAMPLE_SEED:=20260602}"
: "${WV_ONE_RESAMPLE_METHOD:=systematic}"
: "${WV_ONE_ALLOW_MISSING_ORACLE_SLOTS:=1}"
: "${WV_ONE_Z_WARN:=3.0}"
: "${WV_ONE_Z_FAIL:=4.0}"
: "${TLTM_ODE_BACKEND:=dop853}"
: "${TLTM_DOP853_HINIT_ENABLED:=1}"
: "${TLTM_DOP853_STIFFNESS_CHECK_ENABLED:=1}"
: "${TLTM_DOP853_STIFFNESS_CHECK_INTERVAL:=1000}"
: "${TLTM_DOP853_STIFFNESS_MAX_HITS:=15}"
: "${TLTM_DOP853_STIFFNESS_THRESHOLD:=6.1}"
export TLTM_ODE_BACKEND
export TLTM_DOP853_HINIT_ENABLED
export TLTM_DOP853_STIFFNESS_CHECK_ENABLED
export TLTM_DOP853_STIFFNESS_CHECK_INTERVAL
export TLTM_DOP853_STIFFNESS_MAX_HITS
export TLTM_DOP853_STIFFNESS_THRESHOLD

cd "${TLTM_WORKTREE}"
mkdir -p "${TLTM_LOG_ROOT}"
exec > "${TLTM_LOG_ROOT}/pbs_boot_${PBS_JOBID:-manual}.log" 2>&1

echo "RUN_DATE=$(date -Is)"
echo "HOSTNAME=$(hostname)"
echo "PBS_JOBID=${PBS_JOBID:-manual}"
echo "PBS_QUEUE=${PBS_QUEUE:-unknown}"
echo "TLTM_WORKTREE=${TLTM_WORKTREE}"
echo "TLTM_RUN_NAME=${TLTM_RUN_NAME}"
echo "TLTM_OUTPUT_ROOT=${TLTM_OUTPUT_ROOT}"
echo "TLTM_LOG_ROOT=${TLTM_LOG_ROOT}"
echo "TLTM_SOURCE_PIN_FILE=${TLTM_SOURCE_PIN_FILE}"
echo "TLTM_EXPECTED_SOURCE_PIN_ID=${TLTM_EXPECTED_SOURCE_PIN_ID}"
echo "WV_ONE_SAMPLE_COUNT=${WV_ONE_SAMPLE_COUNT}"
echo "WV_ONE_CYCLES=${WV_ONE_CYCLES}"
echo "WV_ONE_STEP_SIZE=${WV_ONE_STEP_SIZE}"
echo "WV_ONE_NUM_STEPS=${WV_ONE_NUM_STEPS}"
echo "WV_ONE_T0=${WV_ONE_T0}"
echo "WV_ONE_T1=${WV_ONE_T1}"
echo "WV_ONE_D0=${WV_ONE_D0}"
echo "WV_ONE_D1=${WV_ONE_D1}"
echo "WV_ONE_W_PROFILE=${WV_ONE_W_PROFILE}"
echo "WV_ONE_W_GAMMA=${WV_ONE_W_GAMMA}"
echo "WV_ONE_ORACLE_ORDER=${WV_ONE_ORACLE_ORDER}"
echo "WV_ONE_ORACLE_T_ORDER=${WV_ONE_ORACLE_T_ORDER}"
echo "WV_ONE_RESAMPLE_METHOD=${WV_ONE_RESAMPLE_METHOD}"
echo "TLTM_ODE_BACKEND=${TLTM_ODE_BACKEND}"

if [ -z "${TLTM_SOURCE_PIN_FILE}" ] && [ -f "${TLTM_WORKTREE}/codex/workspaces/fortran_modernization/state/CLUSTER02_SOURCE_PIN.env" ]; then
  TLTM_SOURCE_PIN_FILE="${TLTM_WORKTREE}/codex/workspaces/fortran_modernization/state/CLUSTER02_SOURCE_PIN.env"
fi
if [ -n "${TLTM_SOURCE_PIN_FILE}" ]; then
  if [ ! -f "${TLTM_SOURCE_PIN_FILE}" ]; then
    echo "[ERROR] TLTM_SOURCE_PIN_FILE does not exist: ${TLTM_SOURCE_PIN_FILE}" >&2
    exit 2
  fi
  echo "SOURCE_PIN_START"
  sed 's/^/SOURCE_PIN_FILE: /' "${TLTM_SOURCE_PIN_FILE}"
  echo "SOURCE_PIN_END"
  # shellcheck source=/dev/null
  . "${TLTM_SOURCE_PIN_FILE}"
  echo "TLTM_SOURCE_PIN_ID=${TLTM_SOURCE_PIN_ID:-}"
  echo "TLTM_SOURCE_PIN_COMMIT=${TLTM_SOURCE_PIN_COMMIT:-}"
  echo "TLTM_SOURCE_PIN_DIRTY_COUNT=${TLTM_SOURCE_PIN_DIRTY_COUNT:-}"
  if [ -n "${TLTM_EXPECTED_SOURCE_PIN_ID}" ] && [ "${TLTM_SOURCE_PIN_ID:-}" != "${TLTM_EXPECTED_SOURCE_PIN_ID}" ]; then
    echo "[ERROR] expected source pin ${TLTM_EXPECTED_SOURCE_PIN_ID}, got ${TLTM_SOURCE_PIN_ID:-missing}" >&2
    exit 2
  fi
elif [ "${TLTM_REQUIRE_SOURCE_PIN}" = "1" ]; then
  echo "[ERROR] TLTM_REQUIRE_SOURCE_PIN=1 but no source pin file was provided or found." >&2
  exit 2
fi

# shellcheck source=/dev/null
. codex/workspaces/fortran_modernization/tasks/scripts/python_embed_env.sh

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export OMP_DYNAMIC=FALSE
export MKL_DYNAMIC=FALSE

test -f build/makefile
make -C build -j "${WV_ONE_JOBS}" OMP=1 PYTHON="${PYTHON}" PYTHON_EMBED_CFLAGS="${PYTHON_EMBED_CFLAGS}" \
  PYTHON_EMBED_LDFLAGS="${PYTHON_EMBED_LDFLAGS}" ../bin/run_wv_hmc ../bin/build_flow_bank_dense

RUN_ROOT="${TLTM_OUTPUT_ROOT}/${TLTM_RUN_NAME}/sample"
ORACLE_WORK_DIR="${TLTM_OUTPUT_ROOT}/${TLTM_RUN_NAME}/oracle_work"
READBACK_DIR="${TLTM_OUTPUT_ROOT}/${TLTM_RUN_NAME}/readback"
BANK_DIR="${TLTM_OUTPUT_ROOT}/${TLTM_RUN_NAME}/state_bank"
STATE_BANK="${BANK_DIR}/oracle_positive_state_bank.bin"
mkdir -p "${RUN_ROOT}" "${ORACLE_WORK_DIR}" "${READBACK_DIR}" "${BANK_DIR}"

/usr/bin/time -p "${PYTHON}" codex/workspaces/fortran_modernization/tasks/scripts/build_wv_hmc_oracle_state_bank_20260602.py \
  --output "${STATE_BANK}" \
  --oracle-work-dir "${ORACLE_WORK_DIR}" \
  --parameters-file "${TLTM_PARAMETERS_FILE}" \
  --flow-bank-binary bin/build_flow_bank_dense \
  --order "${WV_ONE_ORACLE_ORDER}" \
  --t-order "${WV_ONE_ORACLE_T_ORDER}" \
  --sample-count "${WV_ONE_SAMPLE_COUNT}" \
  --resample-seed "${WV_ONE_RESAMPLE_SEED}" \
  --resample-method "${WV_ONE_RESAMPLE_METHOD}" \
  --t0 "${WV_ONE_T0}" \
  --t1 "${WV_ONE_T1}" \
  --d0 "${WV_ONE_D0}" \
  --d1 "${WV_ONE_D1}" \
  --gamma "${WV_ONE_W_GAMMA}" \
  --c0 "${WV_ONE_W_C0}" \
  --c1 "${WV_ONE_W_C1}" \
  --allow-missing-oracle-slots

/usr/bin/time -p "${PYTHON}" codex/workspaces/fortran_modernization/tasks/scripts/run_wv_hmc_dense_observable_validation_20260529.py \
  --binary bin/run_wv_hmc \
  --parameters-file "${TLTM_PARAMETERS_FILE}" \
  --output-root "${RUN_ROOT}" \
  --seed-start "${WV_ONE_SEED_START}" \
  --seed-count "${WV_ONE_SAMPLE_COUNT}" \
  --cycles "${WV_ONE_CYCLES}" \
  --measurement-start-cycle "${WV_ONE_MEASUREMENT_START_CYCLE}" \
  --step-size "${WV_ONE_STEP_SIZE}" \
  --num-steps "${WV_ONE_NUM_STEPS}" \
  --init-mode state_bank \
  --init-bank-file "${STATE_BANK}" \
  --init-bank-record -1 \
  --init-bank-record-mode seed_offset \
  --reverse-gate-state-tol "${WV_ONE_REVERSE_GATE_STATE_TOL}" \
  --reverse-gate-momentum-tol "${WV_ONE_REVERSE_GATE_MOMENTUM_TOL}" \
  --constraint-tol "${WV_ONE_CONSTRAINT_TOL}" \
  --constraint-max-iter "${WV_ONE_CONSTRAINT_MAX_ITER}" \
  --adaptive-newton-stop-enabled 0 \
  --sampler-t0 "${WV_ONE_T0}" \
  --sampler-t1 "${WV_ONE_T1}" \
  --d0 "${WV_ONE_D0}" \
  --d1 "${WV_ONE_D1}" \
  --measurement-t0 "${WV_ONE_MEASUREMENT_T0}" \
  --measurement-t1 "${WV_ONE_MEASUREMENT_T1}" \
  --w-profile "${WV_ONE_W_PROFILE}" \
  --boundary-policy "${WV_ONE_BOUNDARY_POLICY}" \
  --w-gamma "${WV_ONE_W_GAMMA}" \
  --w-c0 "${WV_ONE_W_C0}" \
  --w-c1 "${WV_ONE_W_C1}" \
  --jobs "${WV_ONE_JOBS}" \
  --timeout-sec "${WV_ONE_TIMEOUT_SEC}" \
  --history-stride 1 \
  --write-observable-history \
  --write-state-history \
  --write-final-state

ANALYSIS_EXTRA_ARGS=()
if [ "${WV_ONE_ALLOW_MISSING_ORACLE_SLOTS}" = "1" ]; then
  ANALYSIS_EXTRA_ARGS+=(--allow-missing-oracle-slots)
fi
/usr/bin/time -p "${PYTHON}" codex/workspaces/fortran_modernization/tasks/scripts/analyze_wv_hmc_positive_target_invariant_20260602.py \
  --run-root "${RUN_ROOT}" \
  --output-root "${READBACK_DIR}" \
  --oracle-work-dir "${ORACLE_WORK_DIR}" \
  --parameters-file "${TLTM_PARAMETERS_FILE}" \
  --flow-bank-binary bin/build_flow_bank_dense \
  --order "${WV_ONE_ORACLE_ORDER}" \
  --t-order "${WV_ONE_ORACLE_T_ORDER}" \
  --t0 "${WV_ONE_MEASUREMENT_T0}" \
  --t1 "${WV_ONE_MEASUREMENT_T1}" \
  --d0 "${WV_ONE_D0}" \
  --d1 "${WV_ONE_D1}" \
  --gamma "${WV_ONE_W_GAMMA}" \
  --c0 "${WV_ONE_W_C0}" \
  --c1 "${WV_ONE_W_C1}" \
  --skip-oracle-build \
  --z-warn-threshold "${WV_ONE_Z_WARN}" \
  --z-fail-threshold "${WV_ONE_Z_FAIL}" \
  --no-fail-exit \
  "${ANALYSIS_EXTRA_ARGS[@]}"

echo "STATE_BANK=${STATE_BANK}"
echo "RUN_ROOT=${RUN_ROOT}"
echo "READBACK_DIR=${READBACK_DIR}"
echo "WV_HMC_ONE_STEP_INVARIANT_GATE_COMPLETE"
