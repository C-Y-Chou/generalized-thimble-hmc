#!/bin/bash
#PBS -N stn6ab
#PBS -q C8
#PBS -l select=1:ncpus=8:mpiprocs=8:mem=16gb
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail

if [ -f /etc/profile.d/modules.sh ]; then
  # shellcheck source=/dev/null
  . /etc/profile.d/modules.sh
fi
if [ -f /usr/share/Modules/init/bash ]; then
  # shellcheck source=/dev/null
  . /usr/share/Modules/init/bash
fi
module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

: "${TLTM_WORKTREE:=/lustre1/home/cychou/TLTM_worktrees/fortran_modernization}"
: "${TLTM_EXPECTED_GIT_BRANCH:=codex/fortran-modernization}"
: "${TLTM_EXPECTED_GIT_COMMIT:?TLTM_EXPECTED_GIT_COMMIT is required}"
: "${TLTM_PROD_AB_GROUP:=stephanov_n6_prod_ab_maxfun_20260524}"
: "${TLTM_PROD_AB_CANDIDATE:=all}"
: "${TLTM_PROD_AB_RECORDS:=0,101,202,303,404,505,606,707}"
: "${TLTM_PROD_AB_CYCLES:=5}"
: "${TLTM_PROD_AB_JOBS:=8}"
: "${TLTM_PROD_AB_THREADS:=1}"
: "${TLTM_PROD_AB_TIMEOUT_SEC:=7200}"
: "${TLTM_PROD_AB_SEED_BASE:=8930000}"
: "${TLTM_PROD_AB_LOCAL_TRANSITION_AUDIT:=0}"
: "${TLTM_PROD_AB_LOCAL_TRANSITION_AUDIT_MAX_ROWS:=200000}"
: "${TLTM_OUTPUT_ROOT:=output/stephanov_dfols_tuning}"
: "${TLTM_HIGHFLOW_BANK_PACKAGE:=stephanov_n6_tltm_t003_ladder13_dop853_highflow_bank_8x600_20260523_xhist_b100_s5}"
: "${TLTM_INIT_FLOW_BANK_ROOT:=output/stephanov_flow_banks/${TLTM_HIGHFLOW_BANK_PACKAGE}/flow_bank_ladder13_dop853_dense_cache}"

TLTM_PROD_AB_TASK_INDEX="${TLTM_PROD_AB_TASK_INDEX:-${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-}}}"

cd "${TLTM_WORKTREE}"
LOG_ROOT="output/logs/stephanov_dfols_tuning/${TLTM_PROD_AB_GROUP}"
mkdir -p "${LOG_ROOT}"
exec > "${LOG_ROOT}/pbs_boot_${PBS_JOBID:-manual}_${TLTM_PROD_AB_TASK_INDEX:-serial}.log" 2>&1

echo "RUN_DATE=$(date -Is)"
echo "HOSTNAME=$(hostname)"
echo "PBS_JOBID=${PBS_JOBID:-manual}"
echo "PBS_ARRAY_INDEX=${PBS_ARRAY_INDEX:-}"
echo "PBS_ARRAYID=${PBS_ARRAYID:-}"
echo "TLTM_WORKTREE=${TLTM_WORKTREE}"
echo "TLTM_PROD_AB_GROUP=${TLTM_PROD_AB_GROUP}"
echo "TLTM_PROD_AB_CANDIDATE=${TLTM_PROD_AB_CANDIDATE}"
echo "TLTM_PROD_AB_TASK_INDEX=${TLTM_PROD_AB_TASK_INDEX:-}"
echo "TLTM_PROD_AB_RECORDS=${TLTM_PROD_AB_RECORDS}"
echo "TLTM_PROD_AB_CYCLES=${TLTM_PROD_AB_CYCLES}"
echo "TLTM_PROD_AB_JOBS=${TLTM_PROD_AB_JOBS}"
echo "TLTM_PROD_AB_THREADS=${TLTM_PROD_AB_THREADS}"
echo "TLTM_PROD_AB_LOCAL_TRANSITION_AUDIT=${TLTM_PROD_AB_LOCAL_TRANSITION_AUDIT}"
echo "TLTM_INIT_FLOW_BANK_ROOT=${TLTM_INIT_FLOW_BANK_ROOT}"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
CURRENT_COMMIT="$(git rev-parse HEAD)"
echo "GIT_BRANCH=${CURRENT_BRANCH}"
echo "GIT_COMMIT=${CURRENT_COMMIT}"
echo "EXPECTED_GIT_COMMIT=${TLTM_EXPECTED_GIT_COMMIT}"
if [ "${CURRENT_BRANCH}" != "${TLTM_EXPECTED_GIT_BRANCH}" ]; then
  echo "[ERROR] expected branch ${TLTM_EXPECTED_GIT_BRANCH}, got ${CURRENT_BRANCH}" >&2
  exit 2
fi
if [ "${CURRENT_COMMIT}" != "${TLTM_EXPECTED_GIT_COMMIT}" ]; then
  echo "[ERROR] expected commit ${TLTM_EXPECTED_GIT_COMMIT}, got ${CURRENT_COMMIT}" >&2
  exit 2
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "[ERROR] working tree is dirty; refusing production AB test" >&2
  git status --short >&2
  exit 2
fi

if [ ! -d "${TLTM_INIT_FLOW_BANK_ROOT}/records" ] || [ ! -f "${TLTM_INIT_FLOW_BANK_ROOT}/diagnostics.csv" ]; then
  echo "[ERROR] dense flow-bank cache is missing under ${TLTM_INIT_FLOW_BANK_ROOT}" >&2
  exit 2
fi

if [ -x .venv-dfols/bin/python ]; then
  DFOLS_SITE_PACKAGES="$(.venv-dfols/bin/python - <<'PY'
import sysconfig
print(sysconfig.get_paths()["purelib"])
PY
)"
  export TLTM_OFFICIAL_DFOLS_PYTHONPATH="${DFOLS_SITE_PACKAGES}${TLTM_OFFICIAL_DFOLS_PYTHONPATH:+:${TLTM_OFFICIAL_DFOLS_PYTHONPATH}}"
fi

# Configure Python.h/libpython for the official DFO-LS C bridge on cluster02.
# shellcheck source=/dev/null
. codex/workspaces/fortran_modernization/tasks/scripts/python_embed_env.sh

export OMP_NUM_THREADS="${TLTM_PROD_AB_THREADS}"
export OPENBLAS_NUM_THREADS="${TLTM_PROD_AB_THREADS}"
export MKL_NUM_THREADS="${TLTM_PROD_AB_THREADS}"
export VECLIB_MAXIMUM_THREADS="${TLTM_PROD_AB_THREADS}"
export OMP_PROC_BIND=false
export CONSTRAINT_FAIL_CAPTURE_START_SAMPLE=2147483647

make -C build PYTHON="${PYTHON}" ENABLE_OFFICIAL_DFOLS=1 ../bin/run_tltm_stage2

ARGS=(
  codex/workspaces/fortran_modernization/tasks/scripts/run_stephanov_n6_production_ab_maxfun.py
  --repo-root "${TLTM_WORKTREE}"
  --output-root "${TLTM_OUTPUT_ROOT}"
  --run-group "${TLTM_PROD_AB_GROUP}"
  --candidate "${TLTM_PROD_AB_CANDIDATE}"
  --records "${TLTM_PROD_AB_RECORDS}"
  --cycles "${TLTM_PROD_AB_CYCLES}"
  --jobs "${TLTM_PROD_AB_JOBS}"
  --threads "${TLTM_PROD_AB_THREADS}"
  --timeout-sec "${TLTM_PROD_AB_TIMEOUT_SEC}"
  --seed-base "${TLTM_PROD_AB_SEED_BASE}"
  --init-flow-bank-root "${TLTM_INIT_FLOW_BANK_ROOT}"
  --force
)
if [ -n "${TLTM_PROD_AB_TASK_INDEX}" ]; then
  ARGS+=(--task-index "${TLTM_PROD_AB_TASK_INDEX}")
fi
if [ "${TLTM_PROD_AB_LOCAL_TRANSITION_AUDIT}" = "1" ]; then
  ARGS+=(--enable-local-transition-audit --local-transition-audit-max-rows "${TLTM_PROD_AB_LOCAL_TRANSITION_AUDIT_MAX_ROWS}")
fi

/usr/bin/time -p "${PYTHON}" "${ARGS[@]}"

SUMMARY="${TLTM_OUTPUT_ROOT}/${TLTM_PROD_AB_GROUP}/production_ab_summary.csv"
ATTEMPTS="${TLTM_OUTPUT_ROOT}/${TLTM_PROD_AB_GROUP}/production_ab_attempts.csv"
echo "SUMMARY=${SUMMARY}"
echo "ATTEMPTS=${ATTEMPTS}"
if [ -f "${SUMMARY}" ]; then
  cat "${SUMMARY}"
else
  echo "SUMMARY_PENDING_SIDECAR_MERGE=1"
fi
