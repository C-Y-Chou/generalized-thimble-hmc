#!/bin/bash
#PBS -N assist100k
#PBS -q C8
#PBS -l select=1:ncpus=16:mpiprocs=16:mem=16gb
#PBS -l walltime=06:00:00

set -euo pipefail

if [ -f /etc/profile.d/modules.sh ]; then
  # shellcheck source=/dev/null
  . /etc/profile.d/modules.sh
fi
if [ -f /usr/share/Modules/init/bash ]; then
  # shellcheck source=/dev/null
  . /usr/share/Modules/init/bash
fi
module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

WORKTREE="/lustre1/home/cychou/TLTM"
: "${TLTM_EXPECTED_GIT_BRANCH:=codex/preprod-hardening}"
: "${TLTM_EXPECTED_GIT_COMMIT:?TLTM_EXPECTED_GIT_COMMIT is required}"
: "${TLTM_CHUNK_ID:?TLTM_CHUNK_ID is required}"
: "${TLTM_SEED_OFFSET:?TLTM_SEED_OFFSET is required}"
: "${TLTM_MAX_SEEDS:=16}"
: "${TLTM_JOBS:=16}"

cd "${WORKTREE}"
test -x bin/run_tltm_stage2
test -x bin/evaluate_expectations

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OMP_PROC_BIND=true
export OMP_PLACES=cores
export CONSTRAINT_FAIL_CAPTURE_START_SAMPLE=2147483647

export TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE=1e-13
export QN_REVERSE_GATE_ENABLED=1
export QN_REVERSE_GATE_TOL=1e-8
export QN_S1_PROBE_MAX_ITER=28
export QN_S1_NEAR_RESCUE_ENABLED=0
export QN_S1_NONNEAR_RESCUE_ENABLED=0
export QN_QUASI_GLOBAL_FALLBACK_ENABLED=0
export QN_QUASI_TOL_OVERRIDE=1e-13

CONFIG_JSON="docs/stage_3_4_t035_paired_128seed_100k_rg_nofb_fbnorefine.json"
ROOT_SUBDIR="output/tests/odex_validation/20260509_128seed_100k_qnclean_solverassist_fb_norefine_ct1e13_qn1e13"
ROOT_LOG_SUBDIR="output/logs/odex_validation/20260509_128seed_100k_qnclean_solverassist_fb_norefine_ct1e13_qn1e13"
OUT_SUBDIR="${ROOT_SUBDIR}/chunk_${TLTM_CHUNK_ID}"
LOG_SUBDIR="${ROOT_LOG_SUBDIR}/chunk_${TLTM_CHUNK_ID}"
BOOT_LOG="${LOG_SUBDIR}/pbs_boot.log"

rm -rf "${OUT_SUBDIR}" "${LOG_SUBDIR}"
mkdir -p "${OUT_SUBDIR}" "${LOG_SUBDIR}"
exec > "${BOOT_LOG}" 2>&1

date -Is
hostname
pwd

{
  echo "job_tag=assist128seed100k_20260509_qnclean_fb_norefine_ct1e13_qn1e13_chunk_${TLTM_CHUNK_ID}"
  echo "submitted_for=fortran_modernization_solver_internal_assist_128seed_100k_validation_chunk"
  echo "date_start=$(date -Is)"
  echo "hostname=$(hostname)"
  echo "pwd=$(pwd)"
  echo "expected_branch=${TLTM_EXPECTED_GIT_BRANCH}"
  echo "expected_commit=${TLTM_EXPECTED_GIT_COMMIT}"
  echo "pbs_script=codex/workspaces/fortran_modernization/tasks/pbs/odex_assist_128seed_100k_validation_20260509_qnclean_fb_norefine_chunk.pbs"
  echo "config=${CONFIG_JSON}"
  echo "method=fb_norefine"
  echo "flow_policy=odex_primary_solver_internal_assist_final_flow_strict"
  echo "chunk_id=${TLTM_CHUNK_ID}"
  echo "seed_offset=${TLTM_SEED_OFFSET}"
  echo "max_seeds=${TLTM_MAX_SEEDS}"
  echo "cycles_per_seed=100000"
  echo "jobs=${TLTM_JOBS}"
  echo "constraint_tol_override=${TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE}"
  echo "qn_quasi_tol_override=${QN_QUASI_TOL_OVERRIDE}"
  echo "reverse_gate_enabled=${QN_REVERSE_GATE_ENABLED}"
  echo "reverse_gate_tol=${QN_REVERSE_GATE_TOL}"
  echo "qn_s1_probe_max_iter=${QN_S1_PROBE_MAX_ITER}"
  echo "output_subdir=${OUT_SUBDIR}"
  echo "logs_subdir=${LOG_SUBDIR}"
} > "${LOG_SUBDIR}/run_manifest.txt"

python3 scripts/run_stage3_3_multiseed.py \
  --repo-root . \
  --config "${CONFIG_JSON}" \
  --methods fb_norefine \
  --seed-offset "${TLTM_SEED_OFFSET}" \
  --max-seeds "${TLTM_MAX_SEEDS}" \
  --output-subdir "${OUT_SUBDIR}" \
  --logs-subdir "${LOG_SUBDIR}" \
  --log-prefix "assist128seed100k_qnclean_fb_norefine_ct1e13_qn1e13_chunk_${TLTM_CHUNK_ID}" \
  --report-title "Solver-assist 128seed 100k QN-clean validation fb_norefine chunk ${TLTM_CHUNK_ID}" \
  --schedule task \
  --task-method-order fb_first \
  --jobs "${TLTM_JOBS}" \
  --stage2-threads 1 \
  --eval-threads 1 \
  --skip-build

echo "date_end=$(date -Is)" >> "${LOG_SUBDIR}/run_manifest.txt"
