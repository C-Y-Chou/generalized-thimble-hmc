#!/bin/bash
#PBS -N stn6dfx
#PBS -q C8
#PBS -l select=1:ncpus=8:mpiprocs=8:mem=16gb
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail

if [ -f /etc/profile.d/modules.sh ]; then
  # shellcheck source=/dev/null
  . /etc/profile.d/modules.sh
fi
if [ -f /usr/share/Modules/init/bash ]; then
  # shellcheck source=/dev/null
  . /usr/share/Modules/init/bash
fi
module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

: "${TLTM_WORKTREE:=/lustre1/home/cychou/TLTM_worktrees/fortran_modernization}"
: "${TLTM_EXPECTED_GIT_BRANCH:=codex/fortran-modernization}"
: "${TLTM_EXPECTED_GIT_COMMIT:?TLTM_EXPECTED_GIT_COMMIT is required}"
: "${TLTM_DFOLS_FIXED_GROUP:=stephanov_n6_dfols_fixed_attempt_factorial_20260524}"
: "${TLTM_OUTPUT_ROOT:=output/stephanov_dfols_tuning}"
: "${TLTM_CAPTURE_ROOT:=output/stephanov_dfols_tuning/stephanov_n6_dfols_policy_scan_noisefixed0_parallel_20260524a/base_auto_r025_rho16_abs26/qn_attempt_capture}"
: "${TLTM_PARAMETERS_FILE:=data/parameters_stephanov_n6_mu06_t1e6_eps010_nstep6.dat}"
: "${TLTM_FIXED_RECORDS:=all}"
: "${TLTM_FIXED_WORKERS:=8}"
: "${TLTM_FIXED_MAX_CASES_PER_RECORD:=1}"
: "${TLTM_FIXED_MAXFUN:=1200}"
: "${TLTM_FIXED_NPTS:=0}"
: "${TLTM_FIXED_RHOBEGS:=0.15,0.25,0.35}"
: "${TLTM_FIXED_RHOENDS:=1e-16,1e-13}"
: "${TLTM_FIXED_MODEL_ABS_TOLS:=1e-26,1e-30}"
: "${TLTM_FIXED_MODEL_REL_TOLS:=0}"
: "${TLTM_FIXED_OBJFUN_HAS_NOISE:=0}"
: "${TLTM_FIXED_RESIDUAL_SUCCESS_TOL:=1e-13}"

cd "${TLTM_WORKTREE}"

LOG_ROOT="output/logs/stephanov_dfols_tuning/${TLTM_DFOLS_FIXED_GROUP}"
mkdir -p "${LOG_ROOT}"
exec > "${LOG_ROOT}/pbs_boot_${PBS_JOBID:-manual}.log" 2>&1

echo "RUN_DATE=$(date -Is)"
echo "HOSTNAME=$(hostname)"
echo "PBS_JOBID=${PBS_JOBID:-manual}"
echo "TLTM_WORKTREE=${TLTM_WORKTREE}"
echo "TLTM_DFOLS_FIXED_GROUP=${TLTM_DFOLS_FIXED_GROUP}"
echo "TLTM_CAPTURE_ROOT=${TLTM_CAPTURE_ROOT}"
echo "TLTM_PARAMETERS_FILE=${TLTM_PARAMETERS_FILE}"
echo "TLTM_FIXED_RECORDS=${TLTM_FIXED_RECORDS}"
echo "TLTM_FIXED_WORKERS=${TLTM_FIXED_WORKERS}"
echo "TLTM_FIXED_MAX_CASES_PER_RECORD=${TLTM_FIXED_MAX_CASES_PER_RECORD}"
echo "TLTM_FIXED_MAXFUN=${TLTM_FIXED_MAXFUN}"
echo "TLTM_FIXED_NPTS=${TLTM_FIXED_NPTS}"
echo "TLTM_FIXED_RHOBEGS=${TLTM_FIXED_RHOBEGS}"
echo "TLTM_FIXED_RHOENDS=${TLTM_FIXED_RHOENDS}"
echo "TLTM_FIXED_MODEL_ABS_TOLS=${TLTM_FIXED_MODEL_ABS_TOLS}"
echo "TLTM_FIXED_MODEL_REL_TOLS=${TLTM_FIXED_MODEL_REL_TOLS}"
echo "TLTM_FIXED_OBJFUN_HAS_NOISE=${TLTM_FIXED_OBJFUN_HAS_NOISE}"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
CURRENT_COMMIT="$(git rev-parse HEAD)"
echo "GIT_BRANCH=${CURRENT_BRANCH}"
echo "GIT_COMMIT=${CURRENT_COMMIT}"
echo "EXPECTED_GIT_COMMIT=${TLTM_EXPECTED_GIT_COMMIT}"
if [ "${CURRENT_BRANCH}" != "${TLTM_EXPECTED_GIT_BRANCH}" ]; then
  echo "[ERROR] expected branch ${TLTM_EXPECTED_GIT_BRANCH}, got ${CURRENT_BRANCH}" >&2
  exit 2
fi
if [ "${CURRENT_COMMIT}" != "${TLTM_EXPECTED_GIT_COMMIT}" ]; then
  echo "[ERROR] expected commit ${TLTM_EXPECTED_GIT_COMMIT}, got ${CURRENT_COMMIT}" >&2
  exit 2
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "[ERROR] working tree is dirty; refusing fixed-attempt DFO-LS scan" >&2
  git status --short >&2
  exit 2
fi

if [ ! -x .venv-dfols/bin/python ]; then
  echo "[ERROR] missing .venv-dfols/bin/python" >&2
  exit 4
fi
if [ ! -x bin/evaluate_btn_residual_case ]; then
  echo "[ERROR] missing bin/evaluate_btn_residual_case" >&2
  exit 4
fi
if [ ! -d "${TLTM_CAPTURE_ROOT}" ]; then
  echo "[ERROR] missing capture root: ${TLTM_CAPTURE_ROOT}" >&2
  exit 4
fi
if [ ! -f "${TLTM_PARAMETERS_FILE}" ]; then
  echo "[ERROR] missing parameter file: ${TLTM_PARAMETERS_FILE}" >&2
  exit 4
fi

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export OMP_PROC_BIND=false

export TLTM_ODE_BACKEND=dop853
export TLTM_DOP853_HINIT_ENABLED=1
export TLTM_DOP853_STIFFNESS_CHECK_ENABLED=1
export TLTM_DOP853_STIFFNESS_CHECK_INTERVAL=1000
export TLTM_DOP853_STIFFNESS_MAX_HITS=15
export TLTM_DOP853_STIFFNESS_THRESHOLD=6.1

/usr/bin/time -p .venv-dfols/bin/python \
  codex/workspaces/fortran_modernization/tasks/scripts/run_stephanov_n6_dfols_fixed_attempt_factorial.py \
  --repo-root "${TLTM_WORKTREE}" \
  --capture-root "${TLTM_CAPTURE_ROOT}" \
  --output-root "${TLTM_OUTPUT_ROOT}" \
  --run-group "${TLTM_DFOLS_FIXED_GROUP}" \
  --records "${TLTM_FIXED_RECORDS}" \
  --workers "${TLTM_FIXED_WORKERS}" \
  --max-cases-per-record "${TLTM_FIXED_MAX_CASES_PER_RECORD}" \
  --maxfun "${TLTM_FIXED_MAXFUN}" \
  --npts "${TLTM_FIXED_NPTS}" \
  --rhobegs "${TLTM_FIXED_RHOBEGS}" \
  --rhoends "${TLTM_FIXED_RHOENDS}" \
  --model-abs-tols "${TLTM_FIXED_MODEL_ABS_TOLS}" \
  --model-rel-tols "${TLTM_FIXED_MODEL_REL_TOLS}" \
  --objfun-has-noise "${TLTM_FIXED_OBJFUN_HAS_NOISE}" \
  --residual-success-tol "${TLTM_FIXED_RESIDUAL_SUCCESS_TOL}" \
  --parameters-file "${TLTM_PARAMETERS_FILE}" \
  --force

SUMMARY="${TLTM_OUTPUT_ROOT}/${TLTM_DFOLS_FIXED_GROUP}/fixed_attempt_factorial_summary.csv"
EFFECTS="${TLTM_OUTPUT_ROOT}/${TLTM_DFOLS_FIXED_GROUP}/fixed_attempt_factorial_effects.csv"
TASKS="${TLTM_OUTPUT_ROOT}/${TLTM_DFOLS_FIXED_GROUP}/fixed_attempt_factorial_tasks.csv"
echo "SUMMARY=${SUMMARY}"
echo "EFFECTS=${EFFECTS}"
echo "TASKS=${TASKS}"
cat "${SUMMARY}"
echo "EFFECTS_HEAD"
head -120 "${EFFECTS}"
