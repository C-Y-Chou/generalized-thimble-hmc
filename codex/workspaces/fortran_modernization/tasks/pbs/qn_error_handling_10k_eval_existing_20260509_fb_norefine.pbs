#!/bin/bash
#PBS -N qn10k_eval
#PBS -q C12
#PBS -l select=1:ncpus=20:mpiprocs=20:mem=8gb
#PBS -l walltime=01:00:00
#PBS -o /lustre1/home/cychou/TLTM/output/logs/qn_error_handling/qn10k_fb_norefine_ct1e13_qn1e13_eval_existing.pbs.out
#PBS -e /lustre1/home/cychou/TLTM/output/logs/qn_error_handling/qn10k_fb_norefine_ct1e13_qn1e13_eval_existing.pbs.err

set -euo pipefail
BOOT_LOG="/lustre1/home/cychou/TLTM/output/logs/qn_error_handling/qn10k_fb_norefine_ct1e13_qn1e13_eval_existing.boot.log"
mkdir -p "$(dirname "${BOOT_LOG}")"
exec > "${BOOT_LOG}" 2>&1

date -Is
hostname
pwd

if [ -f /etc/profile.d/modules.sh ]; then
  # shellcheck source=/dev/null
  . /etc/profile.d/modules.sh
fi
if [ -f /usr/share/Modules/init/bash ]; then
  # shellcheck source=/dev/null
  . /usr/share/Modules/init/bash
fi
module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

WORKTREE="/lustre1/home/cychou/TLTM_worktrees/qn_error_handling_validation"
cd "${WORKTREE}"

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OMP_PROC_BIND=true
export OMP_PLACES=cores

export TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE=1e-13
export QN_REVERSE_GATE_ENABLED=1
export QN_REVERSE_GATE_TOL=1e-8
export QN_S1_PROBE_MAX_ITER=28
export QN_S1_NEAR_RESCUE_ENABLED=0
export QN_S1_NONNEAR_RESCUE_ENABLED=0
export QN_QUASI_GLOBAL_FALLBACK_ENABLED=0
export QN_QUASI_TOL_OVERRIDE=1e-13

OUT_SUBDIR="output/tests/qn_error_handling/20260509_10seed_10k_fb_norefine_ct1e13_qn1e13"
LOG_SUBDIR="output/logs/qn_error_handling/20260509_10seed_10k_fb_norefine_ct1e13_qn1e13"

if [ ! -f build/makefile ]; then
  mkdir -p build
  cp /lustre1/home/cychou/TLTM/build/makefile build/makefile
fi
make -C build ../bin/evaluate_expectations

{
  echo "job_tag=qn_error_handling_10k_eval_existing_20260509_fb_norefine_ct1e13_qn1e13"
  echo "submitted_for=fortran_modernization_QN_error_handling_eval_salvage"
  echo "date_start=$(date -Is)"
  echo "hostname=$(hostname)"
  echo "pwd=$(pwd)"
  echo "pbs_script=codex/workspaces/fortran_modernization/tasks/pbs/qn_error_handling_10k_eval_existing_20260509_fb_norefine.pbs"
  echo "config=docs/stage_3_4_t035_paired_10k_10seed.json"
  echo "method=fb_norefine"
  echo "max_seeds=10"
  echo "cycles_per_seed=10000"
  echo "output_subdir=${OUT_SUBDIR}"
  echo "logs_subdir=${LOG_SUBDIR}"
} > "${LOG_SUBDIR}/eval_existing_manifest.txt"

python3 codex/workspaces/fortran_modernization/tasks/scripts/evaluate_existing_stage3_multiseed.py \
  --repo-root . \
  --config docs/stage_3_4_t035_paired_10k_10seed.json \
  --methods fb_norefine \
  --max-seeds 10 \
  --output-subdir "${OUT_SUBDIR}" \
  --logs-subdir "${LOG_SUBDIR}" \
  --log-prefix "qn10k_fb_norefine_ct1e13_qn1e13" \
  --report-title "QN error-handling 10k validation fb_norefine ct1e-13 qn1e-13" \
  --schedule task \
  --task-method-order fb_first \
  --jobs 20 \
  --stage2-threads 1 \
  --eval-threads 1 \
  --skip-build

echo "date_end=$(date -Is)" >> "${LOG_SUBDIR}/eval_existing_manifest.txt"
