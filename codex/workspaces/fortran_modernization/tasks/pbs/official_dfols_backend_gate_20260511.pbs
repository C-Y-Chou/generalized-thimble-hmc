#!/bin/bash
#PBS -N dfols_gate
#PBS -q C8
#PBS -l select=1:ncpus=8:mpiprocs=8:mem=8gb
#PBS -l walltime=03:00:00
#PBS -j oe

set -euo pipefail

if [ -f /etc/profile.d/modules.sh ]; then
  # shellcheck source=/dev/null
  . /etc/profile.d/modules.sh
fi
if [ -f /usr/share/Modules/init/bash ]; then
  # shellcheck source=/dev/null
  . /usr/share/Modules/init/bash
fi
module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

: "${TLTM_WORKTREE:=/lustre1/home/cychou/TLTM_worktrees/fortran_modernization}"
: "${TLTM_EXPECTED_GIT_BRANCH:=codex/fortran-modernization}"
: "${TLTM_EXPECTED_GIT_COMMIT:?TLTM_EXPECTED_GIT_COMMIT is required}"
: "${TLTM_DFOLS_GATE_LABEL:=official_dfols_backend_gate_20260511}"
: "${TLTM_DFOLS_GATE_ALLOW_OVERWRITE:=0}"
: "${TLTM_DFOLS_GATE_MAX_CASES:=0}"

cd "${TLTM_WORKTREE}"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
CURRENT_COMMIT="$(git rev-parse HEAD)"
if [ "${CURRENT_BRANCH}" != "${TLTM_EXPECTED_GIT_BRANCH}" ]; then
  echo "[ERROR] expected branch ${TLTM_EXPECTED_GIT_BRANCH}, got ${CURRENT_BRANCH}" >&2
  exit 2
fi
if [ "${CURRENT_COMMIT}" != "${TLTM_EXPECTED_GIT_COMMIT}" ]; then
  echo "[ERROR] expected commit ${TLTM_EXPECTED_GIT_COMMIT}, got ${CURRENT_COMMIT}" >&2
  exit 2
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "[ERROR] working tree is dirty; refusing official DFO-LS backend gate" >&2
  git status --short >&2
  exit 2
fi

OUT_ROOT="${TLTM_WORKTREE}/output/tests/fortran_modernization/${TLTM_DFOLS_GATE_LABEL}"
LOG_ROOT="${TLTM_WORKTREE}/output/logs/fortran_modernization/${TLTM_DFOLS_GATE_LABEL}"
ATTEMPT_DIR="${OUT_ROOT}/attempts"
DIAG_DIR="${OUT_ROOT}/dfols_diagnostics"
BOOT_LOG="${LOG_ROOT}/pbs_boot.log"
CONFIG_JSON="codex/workspaces/fortran_modernization/tasks/config/official_dfols_backend_gate_1seed_500cycle_t035.json"
RESULT_CSV="${OUT_ROOT}/official_candidate_maxfun250.csv"
SUMMARY_TXT="${OUT_ROOT}/gate_summary.txt"

if [ -e "${OUT_ROOT}" ] || [ -e "${LOG_ROOT}" ]; then
  if [ "${TLTM_DFOLS_GATE_ALLOW_OVERWRITE}" != "1" ]; then
    echo "[ERROR] output/log path exists; set TLTM_DFOLS_GATE_ALLOW_OVERWRITE=1 to rerun" >&2
    echo "OUT_ROOT=${OUT_ROOT}" >&2
    echo "LOG_ROOT=${LOG_ROOT}" >&2
    exit 3
  fi
  rm -rf "${OUT_ROOT}" "${LOG_ROOT}"
fi

mkdir -p "${ATTEMPT_DIR}" "${DIAG_DIR}" "${LOG_ROOT}"
exec > "${BOOT_LOG}" 2>&1

date -Is
hostname
pwd
echo "branch=${CURRENT_BRANCH}"
echo "commit=${CURRENT_COMMIT}"
echo "config=${CONFIG_JSON}"
echo "out_root=${OUT_ROOT}"

PYTHON_FOR_DFOLS="${TLTM_DFOLS_PYTHON:-}"
if [ -z "${PYTHON_FOR_DFOLS}" ]; then
  if command -v python3.11 >/dev/null 2>&1; then
    PYTHON_FOR_DFOLS="$(command -v python3.11)"
  elif command -v python3.9 >/dev/null 2>&1; then
    PYTHON_FOR_DFOLS="$(command -v python3.9)"
  else
    echo "[ERROR] Need python3.9+ for official DFO-LS package." >&2
    exit 4
  fi
fi

if [ ! -x .venv-dfols/bin/python ]; then
  "${PYTHON_FOR_DFOLS}" -m venv .venv-dfols
fi
.venv-dfols/bin/python -m pip install -q -r requirements/external-dfols.txt
.venv-dfols/bin/python - <<'PY'
import dfols, numpy
print("dfols_version={}".format(getattr(dfols, "__version__", "unknown")))
print("numpy_version={}".format(numpy.__version__))
PY

make -C build -j 8 ../bin/run_tltm_stage2 ../bin/evaluate_expectations ../bin/evaluate_btn_residual_case

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OMP_PROC_BIND=true
export OMP_PLACES=cores
export CONSTRAINT_FAIL_CAPTURE_START_SAMPLE=2147483647

export TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE=1e-13
export QN_REVERSE_GATE_ENABLED=1
export QN_REVERSE_GATE_TOL=1e-8
export QN_S1_PROBE_MAX_ITER=28
export QN_S1_NEAR_RESCUE_ENABLED=0
export QN_S1_NONNEAR_RESCUE_ENABLED=0
export QN_QUASI_GLOBAL_FALLBACK_ENABLED=0
export QN_QUASI_TOL_OVERRIDE=1e-13

export QN_ATTEMPT_CAPTURE_DIR="${ATTEMPT_DIR}"
export QN_ATTEMPT_CAPTURE_LIMIT=100
export QN_ATTEMPT_CAPTURE_STRIDE=1

{
  echo "job_tag=${TLTM_DFOLS_GATE_LABEL}"
  echo "submitted_for=fortran_modernization_official_dfols_backend_gate"
  echo "date_start=$(date -Is)"
  echo "hostname=$(hostname)"
  echo "pwd=$(pwd)"
  echo "git_branch=${CURRENT_BRANCH}"
  echo "git_commit=${CURRENT_COMMIT}"
  echo "pbs_script=codex/workspaces/fortran_modernization/tasks/pbs/official_dfols_backend_gate_20260511.pbs"
  echo "config=${CONFIG_JSON}"
  echo "method=fb_norefine"
  echo "max_seeds=1"
  echo "cycles_per_seed=500"
  echo "capture_dir=${ATTEMPT_DIR}"
  echo "capture_limit=${QN_ATTEMPT_CAPTURE_LIMIT}"
  echo "official_dfols_maxfun=250"
  echo "official_dfols_objfun_has_noise=true"
  echo "official_dfols_rhobeg=0.05"
  echo "official_dfols_rhoend=1e-16"
  echo "official_dfols_model_abs_tol=1e-30"
  echo "official_dfols_model_rel_tol=0"
  echo "tltm_residual_success_tol=1e-13"
} > "${OUT_ROOT}/run_manifest.txt"

python3 scripts/run_stage3_3_multiseed.py \
  --repo-root . \
  --config "${CONFIG_JSON}" \
  --methods fb_norefine \
  --max-seeds 1 \
  --output-subdir "${OUT_ROOT}/stage3" \
  --logs-subdir "${LOG_ROOT}/stage3" \
  --log-prefix "official_dfols_backend_gate" \
  --report-title "Official DFO-LS backend gate smoke" \
  --schedule task \
  --task-method-order fb_first \
  --jobs 1 \
  --stage2-threads 1 \
  --eval-threads 1 \
  --stage2-v1-sidecars on \
  --stage2-protocol-audit auto \
  --stage2-protocol-audit-fail-on error \
  --skip-build

test -s "${ATTEMPT_DIR}/qn_attempt_meta.csv"

.venv-dfols/bin/python scripts/run_external_dfols_btn_compare.py \
  --case-dir "${ATTEMPT_DIR}" \
  --capture-prefix qn_attempt \
  --seed-source capture \
  --sample-ids all \
  --max-cases "${TLTM_DFOLS_GATE_MAX_CASES}" \
  --maxfun 250 \
  --objfun-has-noise \
  --model-abs-tol 1e-30 \
  --model-rel-tol 0 \
  --rhobeg 0.05 \
  --rhoend 1e-16 \
  --residual-success-tol 1e-13 \
  --out-csv "${RESULT_CSV}" \
  --diagnostic-dir "${DIAG_DIR}" \
  --print-progress

.venv-dfols/bin/python - "${ATTEMPT_DIR}/qn_attempt_meta.csv" "${RESULT_CSV}" "${SUMMARY_TXT}" <<'PY'
import csv
import sys
from pathlib import Path

meta_path = Path(sys.argv[1])
result_path = Path(sys.argv[2])
summary_path = Path(sys.argv[3])

with meta_path.open(newline="") as f:
    meta_rows = list(csv.DictReader(f))
with result_path.open(newline="") as f:
    result_rows = list(csv.DictReader(f))

meta_by_sample = {int(row["sample_idx"]): row for row in meta_rows}
result_by_sample = {int(row["sample_idx"]): row for row in result_rows}

missing = sorted(set(meta_by_sample) - set(result_by_sample))
float64_fail = [idx for idx, row in result_by_sample.items() if int(row.get("float64_contract", "0")) != 1]
residual_fail = [idx for idx, row in result_by_sample.items() if int(row.get("residual_success", "0")) != 1]
inhouse_converged = [
    idx for idx, row in meta_by_sample.items()
    if int(row.get("converged", "0")) == 1 and idx in result_by_sample
]
inhouse_converged_regressions = [
    idx for idx in inhouse_converged
    if int(result_by_sample[idx].get("residual_success", "0")) != 1
]

max_residual = max((float(row["final_residual_norm"]) for row in result_rows), default=float("nan"))
summary_lines = [
    "attempt_count={}".format(len(meta_rows)),
    "official_result_count={}".format(len(result_rows)),
    "inhouse_converged_count={}".format(len(inhouse_converged)),
    "official_residual_success_count={}".format(len(result_rows) - len(residual_fail)),
    "float64_fail_count={}".format(len(float64_fail)),
    "missing_result_count={}".format(len(missing)),
    "inhouse_converged_regression_count={}".format(len(inhouse_converged_regressions)),
    "max_official_final_residual_norm={:.17e}".format(max_residual),
    "missing_samples={}".format(",".join(map(str, missing))),
    "float64_fail_samples={}".format(",".join(map(str, float64_fail))),
    "residual_fail_samples={}".format(",".join(map(str, residual_fail))),
    "inhouse_converged_regression_samples={}".format(",".join(map(str, inhouse_converged_regressions))),
]
summary_path.write_text("\n".join(summary_lines) + "\n", encoding="utf-8")
print("\n".join(summary_lines))

if not meta_rows:
    raise SystemExit("no QN attempts captured")
if missing:
    raise SystemExit("official DFO-LS did not produce rows for all captured attempts")
if float64_fail:
    raise SystemExit("float64 contract failure")
if inhouse_converged_regressions:
    raise SystemExit("official DFO-LS regressed an in-house-converged attempt")
PY

echo "date_end=$(date -Is)" >> "${OUT_ROOT}/run_manifest.txt"
date -Is
