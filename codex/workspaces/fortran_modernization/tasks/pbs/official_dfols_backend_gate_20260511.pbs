#!/bin/bash
#PBS -N dfols_gate
#PBS -q C8
#PBS -l select=1:ncpus=8:mpiprocs=8:mem=8gb
#PBS -l walltime=03:00:00
#PBS -j oe

set -euo pipefail

if [ -f /etc/profile.d/modules.sh ]; then
  # shellcheck source=/dev/null
  . /etc/profile.d/modules.sh
fi
if [ -f /usr/share/Modules/init/bash ]; then
  # shellcheck source=/dev/null
  . /usr/share/Modules/init/bash
fi
module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

: "${TLTM_WORKTREE:=/lustre1/home/cychou/TLTM_worktrees/fortran_modernization}"
: "${TLTM_EXPECTED_GIT_BRANCH:=codex/fortran-modernization}"
: "${TLTM_EXPECTED_GIT_COMMIT:?TLTM_EXPECTED_GIT_COMMIT is required}"
: "${TLTM_DFOLS_GATE_LABEL:=official_dfols_backend_gate_20260511}"
: "${TLTM_DFOLS_GATE_ALLOW_OVERWRITE:=0}"
: "${TLTM_DFOLS_GATE_MAX_CASES:=0}"
: "${TLTM_BUILD_JOBS:=8}"
: "${TLTM_DFOLS_GATE_CONFIG_JSON:=codex/workspaces/fortran_modernization/tasks/config/official_dfols_backend_gate_1seed_500cycle_t035.json}"
: "${TLTM_DFOLS_GATE_MAX_SEEDS:=1}"
: "${TLTM_DFOLS_GATE_CYCLES_PER_SEED:=500}"
: "${TLTM_DFOLS_GATE_CAPTURE_LIMIT:=100}"
: "${TLTM_DFOLS_GATE_CAPTURE_STRIDE:=1}"
: "${TLTM_DFOLS_GATE_STAGE3_JOBS:=1}"

cd "${TLTM_WORKTREE}"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
CURRENT_COMMIT="$(git rev-parse HEAD)"
if [ "${CURRENT_BRANCH}" != "${TLTM_EXPECTED_GIT_BRANCH}" ]; then
  echo "[ERROR] expected branch ${TLTM_EXPECTED_GIT_BRANCH}, got ${CURRENT_BRANCH}" >&2
  exit 2
fi
if [ "${CURRENT_COMMIT}" != "${TLTM_EXPECTED_GIT_COMMIT}" ]; then
  echo "[ERROR] expected commit ${TLTM_EXPECTED_GIT_COMMIT}, got ${CURRENT_COMMIT}" >&2
  exit 2
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "[ERROR] working tree is dirty; refusing official DFO-LS backend gate" >&2
  git status --short >&2
  exit 2
fi

OUT_ROOT="${TLTM_WORKTREE}/output/tests/fortran_modernization/${TLTM_DFOLS_GATE_LABEL}"
LOG_ROOT="${TLTM_WORKTREE}/output/logs/fortran_modernization/${TLTM_DFOLS_GATE_LABEL}"
ATTEMPT_DIR="${OUT_ROOT}/attempts"
DIAG_DIR="${OUT_ROOT}/dfols_diagnostics"
BOOT_LOG="${LOG_ROOT}/pbs_boot.log"
CONFIG_JSON="${TLTM_DFOLS_GATE_CONFIG_JSON}"
REPLAY_ROOT="${OUT_ROOT}/official_replay"
SUMMARY_TXT="${OUT_ROOT}/gate_summary.txt"

if [ -e "${OUT_ROOT}" ] || [ -e "${LOG_ROOT}" ]; then
  if [ "${TLTM_DFOLS_GATE_ALLOW_OVERWRITE}" != "1" ]; then
    echo "[ERROR] output/log path exists; set TLTM_DFOLS_GATE_ALLOW_OVERWRITE=1 to rerun" >&2
    echo "OUT_ROOT=${OUT_ROOT}" >&2
    echo "LOG_ROOT=${LOG_ROOT}" >&2
    exit 3
  fi
  rm -rf "${OUT_ROOT}" "${LOG_ROOT}"
fi

mkdir -p "${ATTEMPT_DIR}" "${DIAG_DIR}" "${REPLAY_ROOT}" "${LOG_ROOT}"
exec > "${BOOT_LOG}" 2>&1

date -Is
hostname
pwd
echo "branch=${CURRENT_BRANCH}"
echo "commit=${CURRENT_COMMIT}"
echo "config=${CONFIG_JSON}"
echo "out_root=${OUT_ROOT}"

PYTHON_FOR_DFOLS="${TLTM_DFOLS_PYTHON:-}"
if [ -z "${PYTHON_FOR_DFOLS}" ]; then
  if command -v python3.11 >/dev/null 2>&1; then
    PYTHON_FOR_DFOLS="$(command -v python3.11)"
  elif command -v python3.9 >/dev/null 2>&1; then
    PYTHON_FOR_DFOLS="$(command -v python3.9)"
  else
    echo "[ERROR] Need python3.9+ for official DFO-LS package." >&2
    exit 4
  fi
fi

PY_VERSION="$("${PYTHON_FOR_DFOLS}" - <<'PY'
import sys
print("{}.{}".format(sys.version_info[0], sys.version_info[1]))
PY
)"
PY_INCLUDE="$("${PYTHON_FOR_DFOLS}" - <<'PY'
import sysconfig
print(sysconfig.get_paths()["include"])
PY
)"
PY_LIBDIR="$("${PYTHON_FOR_DFOLS}" - <<'PY'
import sysconfig
print(sysconfig.get_config_var("LIBDIR") or "")
PY
)"
PY_LDLIBRARY="$("${PYTHON_FOR_DFOLS}" - <<'PY'
import sysconfig
print(sysconfig.get_config_var("LDLIBRARY") or "")
PY
)"
PY_EMBED_EXTRA_LDFLAGS="$("${PYTHON_FOR_DFOLS}" - <<'PY'
import sysconfig
print(" ".join(str(sysconfig.get_config_var(k) or "") for k in ("LIBS", "SYSLIBS", "LINKFORSHARED")))
PY
)"

if [ -n "${TLTM_PYTHON_INCLUDE_DIR:-}" ]; then
  if [ ! -f "${TLTM_PYTHON_INCLUDE_DIR}/Python.h" ]; then
    echo "[ERROR] TLTM_PYTHON_INCLUDE_DIR lacks Python.h: ${TLTM_PYTHON_INCLUDE_DIR}" >&2
    exit 4
  fi
  export PYTHON_EMBED_CFLAGS="-I${TLTM_PYTHON_INCLUDE_DIR}${PYTHON_EMBED_CFLAGS:+ ${PYTHON_EMBED_CFLAGS}}"
elif [ -f "${PY_INCLUDE}/Python.h" ]; then
  :
elif [ "${PY_VERSION}" = "3.11" ]; then
  : "${TLTM_PYTHON_DEVEL_ROOT:=${PWD}/.deps/python-devel-3.11}"
  : "${TLTM_PYTHON_DEVEL_RPM_URL:=https://rockylinux.t-2.net/8/Devel/x86_64/os/Packages/p/python3.11-devel-3.11.11-1.el8_10.x86_64.rpm}"
  RPM_DIR="${PWD}/.deps/rpms"
  RPM_FILE="${RPM_DIR}/${TLTM_PYTHON_DEVEL_RPM_URL##*/}"
  mkdir -p "${RPM_DIR}" "${TLTM_PYTHON_DEVEL_ROOT}"
  if [ ! -f "${RPM_FILE}" ]; then
    if ! command -v curl >/dev/null 2>&1; then
      echo "[ERROR] Python.h missing and curl is unavailable for python-devel RPM download" >&2
      exit 4
    fi
    curl -L --fail --retry 3 -o "${RPM_FILE}" "${TLTM_PYTHON_DEVEL_RPM_URL}"
  fi
  if [ ! -f "${TLTM_PYTHON_DEVEL_ROOT}/usr/include/python3.11/Python.h" ]; then
    if ! command -v rpm2cpio >/dev/null 2>&1 || ! command -v cpio >/dev/null 2>&1; then
      echo "[ERROR] Python.h missing and rpm2cpio/cpio is unavailable for local RPM extraction" >&2
      exit 4
    fi
    (cd "${TLTM_PYTHON_DEVEL_ROOT}" && rpm2cpio "${RPM_FILE}" | cpio -idm >/dev/null)
  fi
  PY_DEVEL_INCLUDE="${TLTM_PYTHON_DEVEL_ROOT}/usr/include/python3.11"
  PY_HEADER_CFLAGS="-I${PY_DEVEL_INCLUDE}"
  if grep -q 'pyconfig-' "${PY_DEVEL_INCLUDE}/pyconfig.h" && ! ls "${PY_DEVEL_INCLUDE}"/pyconfig-*.h >/dev/null 2>&1; then
    if ls "${PY_INCLUDE}"/pyconfig-*.h >/dev/null 2>&1; then
      PY_HEADER_CFLAGS="${PY_HEADER_CFLAGS} -I${PY_INCLUDE}"
    else
      echo "[ERROR] extracted Python headers require a pyconfig platform fragment; set TLTM_PYTHON_INCLUDE_DIR" >&2
      exit 4
    fi
  fi
  export PYTHON_EMBED_CFLAGS="${PY_HEADER_CFLAGS}${PYTHON_EMBED_CFLAGS:+ ${PYTHON_EMBED_CFLAGS}}"
else
  echo "[ERROR] Python.h missing for ${PYTHON_FOR_DFOLS} (${PY_VERSION}); set TLTM_PYTHON_INCLUDE_DIR" >&2
  exit 4
fi

if [ -z "${PYTHON_EMBED_LDFLAGS:-}" ] && [ -n "${PY_LIBDIR}" ] && [ -n "${PY_LDLIBRARY}" ] && [ ! -f "${PY_LIBDIR}/${PY_LDLIBRARY}" ]; then
  PY_VERSIONED_RUNTIME="${PY_LIBDIR}/${PY_LDLIBRARY}.1.0"
  if [ -f "${PY_VERSIONED_RUNTIME}" ]; then
    export PYTHON_EMBED_LDFLAGS="${PY_VERSIONED_RUNTIME} ${PY_EMBED_EXTRA_LDFLAGS}"
  else
    echo "[ERROR] cannot find ${PY_LIBDIR}/${PY_LDLIBRARY}; set PYTHON_EMBED_LDFLAGS" >&2
    exit 4
  fi
fi

if [ ! -x .venv-dfols/bin/python ]; then
  "${PYTHON_FOR_DFOLS}" -m venv .venv-dfols
fi
.venv-dfols/bin/python -m pip install -q -r requirements/external-dfols.txt
export TLTM_OFFICIAL_DFOLS_PYTHONPATH="$(
  .venv-dfols/bin/python - <<'PY'
import site
print(":".join(site.getsitepackages()))
PY
)"
.venv-dfols/bin/python - <<'PY'
import dfols, numpy
print("dfols_version={}".format(getattr(dfols, "__version__", "unknown")))
print("numpy_version={}".format(numpy.__version__))
PY

MAKE_ARGS=(
  -C build
  -j "${TLTM_BUILD_JOBS}"
  ENABLE_OFFICIAL_DFOLS=1
  PYTHON="${PYTHON_FOR_DFOLS}"
)
if [ -n "${PYTHON_EMBED_CFLAGS:-}" ]; then
  MAKE_ARGS+=(PYTHON_EMBED_CFLAGS="${PYTHON_EMBED_CFLAGS}")
fi
if [ -n "${PYTHON_EMBED_LDFLAGS:-}" ]; then
  MAKE_ARGS+=(PYTHON_EMBED_LDFLAGS="${PYTHON_EMBED_LDFLAGS}")
fi
make "${MAKE_ARGS[@]}" ../bin/run_tltm_stage2 ../bin/evaluate_expectations ../bin/evaluate_btn_residual_case

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OMP_PROC_BIND=true
export OMP_PLACES=cores
export CONSTRAINT_FAIL_CAPTURE_START_SAMPLE=2147483647

export TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE=1e-13
export QN_REVERSE_GATE_ENABLED=1
export QN_REVERSE_GATE_TOL=1e-8
export QN_S1_PROBE_MAX_ITER=28
export QN_S1_NEAR_RESCUE_ENABLED=0
export QN_S1_NONNEAR_RESCUE_ENABLED=0
export QN_QUASI_GLOBAL_FALLBACK_ENABLED=0
export QN_QUASI_TOL_OVERRIDE=1e-13

export QN_SOLVER_BACKEND=official_dfols
export QN_OFFICIAL_DFOLS_PRESET=stable_gate77
export QN_OFFICIAL_DFOLS_NPT=4
export QN_OFFICIAL_DFOLS_MAXFUN=250
export QN_OFFICIAL_DFOLS_OBJFUN_HAS_NOISE=1
export QN_OFFICIAL_DFOLS_RHOBEG=0.018
export QN_OFFICIAL_DFOLS_RHOEND=1e-16
export QN_OFFICIAL_DFOLS_MODEL_ABS_TOL=1e-30
export QN_OFFICIAL_DFOLS_MODEL_REL_TOL=0

unset QN_ATTEMPT_CAPTURE_DIR
export QN_ATTEMPT_CAPTURE_BASE_DIR="${ATTEMPT_DIR}"
export QN_ATTEMPT_CAPTURE_LIMIT="${TLTM_DFOLS_GATE_CAPTURE_LIMIT}"
export QN_ATTEMPT_CAPTURE_STRIDE="${TLTM_DFOLS_GATE_CAPTURE_STRIDE}"

{
  echo "job_tag=${TLTM_DFOLS_GATE_LABEL}"
  echo "submitted_for=fortran_modernization_official_dfols_backend_gate"
  echo "date_start=$(date -Is)"
  echo "hostname=$(hostname)"
  echo "pwd=$(pwd)"
  echo "git_branch=${CURRENT_BRANCH}"
  echo "git_commit=${CURRENT_COMMIT}"
  echo "pbs_script=codex/workspaces/fortran_modernization/tasks/pbs/official_dfols_backend_gate_20260511.pbs"
  echo "config=${CONFIG_JSON}"
  echo "method=fb_norefine"
  echo "backend=official_dfols"
  echo "embedded_capture=1"
  echo "max_seeds=${TLTM_DFOLS_GATE_MAX_SEEDS}"
  echo "cycles_per_seed=${TLTM_DFOLS_GATE_CYCLES_PER_SEED}"
  echo "capture_base_dir=${ATTEMPT_DIR}"
  echo "capture_limit=${QN_ATTEMPT_CAPTURE_LIMIT}"
  echo "capture_stride=${QN_ATTEMPT_CAPTURE_STRIDE}"
  echo "official_dfols_preset=stable_gate77"
  echo "official_dfols_maxfun=250"
  echo "official_dfols_objfun_has_noise=true"
  echo "official_dfols_npt=4"
  echo "official_dfols_rhobeg=0.018"
  echo "official_dfols_rhoend=1e-16"
  echo "official_dfols_model_abs_tol=1e-30"
  echo "official_dfols_model_rel_tol=0"
  echo "tltm_official_dfols_pythonpath=${TLTM_OFFICIAL_DFOLS_PYTHONPATH}"
  echo "python_for_dfols=${PYTHON_FOR_DFOLS}"
  echo "python_embed_cflags=${PYTHON_EMBED_CFLAGS:-}"
  echo "python_embed_ldflags=${PYTHON_EMBED_LDFLAGS:-}"
  echo "tltm_residual_success_tol=1e-13"
} > "${OUT_ROOT}/run_manifest.txt"

python3 scripts/run_stage3_3_multiseed.py \
  --repo-root . \
  --config "${CONFIG_JSON}" \
  --methods fb_norefine \
  --max-seeds "${TLTM_DFOLS_GATE_MAX_SEEDS}" \
  --output-subdir "${OUT_ROOT}/stage3" \
  --logs-subdir "${LOG_ROOT}/stage3" \
  --log-prefix "official_dfols_backend_gate" \
  --report-title "Official DFO-LS backend gate smoke" \
  --schedule task \
  --task-method-order fb_first \
  --jobs "${TLTM_DFOLS_GATE_STAGE3_JOBS}" \
  --stage2-threads 1 \
  --eval-threads 1 \
  --stage2-v1-sidecars on \
  --stage2-protocol-audit auto \
  --stage2-protocol-audit-fail-on error \
  --skip-build

mapfile -t CASE_DIRS < <(find "${ATTEMPT_DIR}" -mindepth 2 -maxdepth 2 -type f -name qn_attempt_meta.csv -print | sort | xargs -r -n1 dirname)
if [ "${#CASE_DIRS[@]}" -eq 0 ]; then
  echo "[ERROR] no per-seed QN attempt capture files found under ${ATTEMPT_DIR}" >&2
  exit 5
fi

REPLAY_INDEX="${REPLAY_ROOT}/replay_index.tsv"
: > "${REPLAY_INDEX}"
case_idx=0
for case_dir in "${CASE_DIRS[@]}"; do
  case_idx=$((case_idx + 1))
  rel_case="${case_dir#${ATTEMPT_DIR}/}"
  safe_case="${rel_case//\//__}"
  result_csv="${REPLAY_ROOT}/${safe_case}.csv"
  diagnostic_dir="${DIAG_DIR}/${safe_case}"
  mkdir -p "${diagnostic_dir}"
  echo "[REPLAY] case=${rel_case} out=${result_csv}"
  .venv-dfols/bin/python scripts/run_external_dfols_btn_compare.py \
    --case-dir "${case_dir}" \
    --capture-prefix qn_attempt \
    --seed-source capture \
    --sample-ids all \
    --max-cases "${TLTM_DFOLS_GATE_MAX_CASES}" \
    --maxfun 250 \
    --objfun-has-noise \
    --model-abs-tol 1e-30 \
    --model-rel-tol 0 \
    --npt 4 \
    --rhobeg 0.018 \
    --rhoend 1e-16 \
    --residual-success-tol 1e-13 \
    --out-csv "${result_csv}" \
    --diagnostic-dir "${diagnostic_dir}" \
    --print-progress
  printf '%s\t%s\t%s\n' "${rel_case}" "${case_dir}/qn_attempt_meta.csv" "${result_csv}" >> "${REPLAY_INDEX}"
done

.venv-dfols/bin/python - "${REPLAY_INDEX}" "${SUMMARY_TXT}" <<'PY'
import csv
import sys
from pathlib import Path

index_path = Path(sys.argv[1])
summary_path = Path(sys.argv[2])

case_count = 0
attempt_count = 0
official_result_count = 0
embedded_captured_converged_count = 0
official_residual_success_count = 0
float64_fail_count = 0
missing_result_count = 0
embedded_captured_converged_regression_count = 0
max_residual = float("nan")
missing_samples = []
float64_fail_samples = []
residual_fail_samples = []
regression_samples = []

with index_path.open() as f:
    index_rows = [line.rstrip("\n").split("\t") for line in f if line.strip()]

for rel_case, meta_text, result_text in index_rows:
    case_count += 1
    meta_path = Path(meta_text)
    result_path = Path(result_text)
    with meta_path.open(newline="") as f:
        meta_rows = list(csv.DictReader(f))
    with result_path.open(newline="") as f:
        result_rows = list(csv.DictReader(f))

    meta_by_sample = {int(row["sample_idx"]): row for row in meta_rows}
    result_by_sample = {int(row["sample_idx"]): row for row in result_rows}

    missing = sorted(set(meta_by_sample) - set(result_by_sample))
    float64_fail = [idx for idx, row in result_by_sample.items() if int(row.get("float64_contract", "0")) != 1]
    residual_fail = [idx for idx, row in result_by_sample.items() if int(row.get("residual_success", "0")) != 1]
    captured_converged = [
        idx for idx, row in meta_by_sample.items()
        if int(row.get("converged", "0")) == 1 and idx in result_by_sample
    ]
    captured_converged_regressions = [
        idx for idx in captured_converged
        if int(result_by_sample[idx].get("residual_success", "0")) != 1
    ]

    attempt_count += len(meta_rows)
    official_result_count += len(result_rows)
    embedded_captured_converged_count += len(captured_converged)
    official_residual_success_count += len(result_rows) - len(residual_fail)
    float64_fail_count += len(float64_fail)
    missing_result_count += len(missing)
    embedded_captured_converged_regression_count += len(captured_converged_regressions)
    case_max = max((float(row["final_residual_norm"]) for row in result_rows), default=float("nan"))
    if case_max == case_max and (max_residual != max_residual or case_max > max_residual):
        max_residual = case_max

    missing_samples.extend("{}:{}".format(rel_case, idx) for idx in missing)
    float64_fail_samples.extend("{}:{}".format(rel_case, idx) for idx in float64_fail)
    residual_fail_samples.extend("{}:{}".format(rel_case, idx) for idx in residual_fail)
    regression_samples.extend("{}:{}".format(rel_case, idx) for idx in captured_converged_regressions)

summary_lines = [
    "case_count={}".format(case_count),
    "attempt_count={}".format(attempt_count),
    "official_result_count={}".format(official_result_count),
    "embedded_captured_converged_count={}".format(embedded_captured_converged_count),
    "official_residual_success_count={}".format(official_residual_success_count),
    "float64_fail_count={}".format(float64_fail_count),
    "missing_result_count={}".format(missing_result_count),
    "embedded_captured_converged_regression_count={}".format(embedded_captured_converged_regression_count),
    "max_official_final_residual_norm={:.17e}".format(max_residual),
    "missing_samples={}".format(",".join(missing_samples)),
    "float64_fail_samples={}".format(",".join(float64_fail_samples)),
    "residual_fail_samples={}".format(",".join(residual_fail_samples)),
    "embedded_captured_converged_regression_samples={}".format(",".join(regression_samples)),
]
summary_path.write_text("\n".join(summary_lines) + "\n", encoding="utf-8")
print("\n".join(summary_lines))

if not index_rows:
    raise SystemExit("no QN attempt capture cases found")
if not attempt_count:
    raise SystemExit("no QN attempts captured")
if missing_result_count:
    raise SystemExit("official DFO-LS did not produce rows for all captured attempts")
if float64_fail_count:
    raise SystemExit("float64 contract failure")
if embedded_captured_converged_regression_count:
    raise SystemExit("official DFO-LS replay regressed an embedded-converged attempt")
PY

echo "date_end=$(date -Is)" >> "${OUT_ROOT}/run_manifest.txt"
date -Is
