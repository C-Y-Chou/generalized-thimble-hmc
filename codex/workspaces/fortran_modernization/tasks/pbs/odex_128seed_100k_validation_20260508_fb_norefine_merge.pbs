#!/bin/bash
#PBS -N odex128_merge
#PBS -q C8
#PBS -l select=1:ncpus=1:mpiprocs=1:mem=4gb
#PBS -l walltime=01:00:00
#PBS -o /lustre1/home/cychou/TLTM/output/logs/odex_validation/odex128seed100k_fb_norefine_merge.pbs.out
#PBS -e /lustre1/home/cychou/TLTM/output/logs/odex_validation/odex128seed100k_fb_norefine_merge.pbs.err

set -euo pipefail

cd /lustre1/home/cychou/TLTM

: "${SUBMIT_BRANCH:=unknown}"
: "${SUBMIT_COMMIT:=unknown}"
: "${SUBMIT_TREE_STATUS:=unknown}"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
CURRENT_COMMIT="$(git rev-parse HEAD)"
if [ "${SUBMIT_BRANCH}" != "unknown" ] && [ "${CURRENT_BRANCH}" != "${SUBMIT_BRANCH}" ]; then
  echo "[ERROR] expected branch ${SUBMIT_BRANCH}, got ${CURRENT_BRANCH}" >&2
  exit 2
fi
if [ "${SUBMIT_COMMIT}" != "unknown" ] && [ "${CURRENT_COMMIT}" != "${SUBMIT_COMMIT}" ]; then
  echo "[ERROR] expected commit ${SUBMIT_COMMIT}, got ${CURRENT_COMMIT}" >&2
  exit 2
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "[ERROR] working tree is dirty; refusing ODEX 128seed/100k merge" >&2
  git status --short >&2
  exit 2
fi

CONFIG_JSON="docs/stage_3_4_t035_paired_128seed_100k_rg_nofb_fbnorefine.json"
ROOT_SUBDIR="output/tests/odex_validation/20260508_128seed_100k_fb_norefine_ct1e13_qn1e13"
LOG_SUBDIR="output/logs/odex_validation/20260508_128seed_100k_fb_norefine_ct1e13_qn1e13/merge"
mkdir -p "${ROOT_SUBDIR}" "${LOG_SUBDIR}"

{
  echo "job_tag=odex128seed100k_20260508_fb_norefine_ct1e13_qn1e13_merge"
  echo "submitted_for=fortran_modernization_ODEX_128seed_100k_validation_merge"
  echo "date_start=$(date -Is)"
  echo "hostname=$(hostname)"
  echo "pwd=$(pwd)"
  echo "submit_branch=${SUBMIT_BRANCH}"
  echo "submit_commit=${SUBMIT_COMMIT}"
  echo "submit_tree_status=${SUBMIT_TREE_STATUS}"
  echo "runtime_branch=${CURRENT_BRANCH}"
  echo "runtime_commit=${CURRENT_COMMIT}"
  echo "pbs_script=codex/workspaces/fortran_modernization/tasks/pbs/odex_128seed_100k_validation_20260508_fb_norefine_merge.pbs"
  echo "config=${CONFIG_JSON}"
  echo "method=fb_norefine"
  echo "expected_rows=128"
  echo "chunk_glob=chunk_*"
  echo "output_subdir=${ROOT_SUBDIR}"
  echo "logs_subdir=${LOG_SUBDIR}"
} > "${LOG_SUBDIR}/run_manifest.txt"

python3 scripts/merge_stage3_multiseed_chunks.py \
  --repo-root . \
  --config "${CONFIG_JSON}" \
  --output-subdir "${ROOT_SUBDIR}" \
  --chunk-glob "chunk_*" \
  --log-prefix "odex128seed100k_fb_norefine_ct1e13_qn1e13" \
  --report-title "ODEX 128seed 100k validation fb_norefine ct1e-13 qn1e-13" \
  --expected-rows 128 \
  --jobs-label "8 chunks x 16 workers" \
  --requested-cpus 128

echo "date_end=$(date -Is)" >> "${LOG_SUBDIR}/run_manifest.txt"
