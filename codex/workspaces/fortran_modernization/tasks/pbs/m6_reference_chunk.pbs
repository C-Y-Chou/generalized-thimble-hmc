#!/bin/bash
#PBS -N m6refchunk
#PBS -j oe

set -euo pipefail

if [ -f /etc/profile.d/modules.sh ]; then
  . /etc/profile.d/modules.sh
fi
if [ -f /usr/share/Modules/init/bash ]; then
  . /usr/share/Modules/init/bash
fi
module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

: "${TLTM_WORKTREE:=/lustre1/home/cychou/TLTM}"
: "${TLTM_EXPECTED_GIT_BRANCH:?TLTM_EXPECTED_GIT_BRANCH is required}"
: "${TLTM_EXPECTED_GIT_COMMIT:?TLTM_EXPECTED_GIT_COMMIT is required}"
: "${TLTM_REF_LEVEL:?TLTM_REF_LEVEL is required}"
: "${TLTM_REF_LABEL:?TLTM_REF_LABEL is required}"
: "${TLTM_CONFIG_JSON:?TLTM_CONFIG_JSON is required}"
: "${TLTM_METHOD:?TLTM_METHOD is required}"
: "${TLTM_CHUNK_ID:?TLTM_CHUNK_ID is required}"
: "${TLTM_SEED_OFFSET:?TLTM_SEED_OFFSET is required}"
: "${TLTM_MAX_SEEDS:?TLTM_MAX_SEEDS is required}"
: "${TLTM_JOBS:?TLTM_JOBS is required}"
: "${TLTM_ROOT_SUBDIR:?TLTM_ROOT_SUBDIR is required}"
: "${TLTM_ROOT_LOG_SUBDIR:?TLTM_ROOT_LOG_SUBDIR is required}"
: "${TLTM_ALLOW_OVERWRITE:=0}"

cd "${TLTM_WORKTREE}"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
CURRENT_COMMIT="$(git rev-parse HEAD)"
if [ "${CURRENT_BRANCH}" != "${TLTM_EXPECTED_GIT_BRANCH}" ]; then
  echo "[ERROR] expected branch ${TLTM_EXPECTED_GIT_BRANCH}, got ${CURRENT_BRANCH}" >&2
  exit 2
fi
if [ "${CURRENT_COMMIT}" != "${TLTM_EXPECTED_GIT_COMMIT}" ]; then
  echo "[ERROR] expected commit ${TLTM_EXPECTED_GIT_COMMIT}, got ${CURRENT_COMMIT}" >&2
  exit 2
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "[ERROR] working tree is dirty; refusing M6 reference chunk" >&2
  git status --short >&2
  exit 2
fi
test -x bin/run_tltm_stage2
test -x bin/evaluate_expectations

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OMP_PROC_BIND=true
export OMP_PLACES=cores
export CONSTRAINT_FAIL_CAPTURE_START_SAMPLE=2147483647

export TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE=1e-13
export QN_REVERSE_GATE_ENABLED=1
export QN_REVERSE_GATE_TOL=1e-8
export QN_S1_PROBE_MAX_ITER=28
export QN_S1_NEAR_RESCUE_ENABLED=0
export QN_S1_NONNEAR_RESCUE_ENABLED=0
export QN_QUASI_GLOBAL_FALLBACK_ENABLED=0
export QN_QUASI_TOL_OVERRIDE=1e-13

OUT_SUBDIR="${TLTM_ROOT_SUBDIR}/${TLTM_METHOD}/chunk_${TLTM_CHUNK_ID}"
LOG_SUBDIR="${TLTM_ROOT_LOG_SUBDIR}/${TLTM_METHOD}/chunk_${TLTM_CHUNK_ID}"
BOOT_LOG="${LOG_SUBDIR}/pbs_boot.log"

if [ -e "${OUT_SUBDIR}" ] || [ -e "${LOG_SUBDIR}" ]; then
  if [ "${TLTM_ALLOW_OVERWRITE}" != "1" ]; then
    echo "[ERROR] output/log path already exists; set TLTM_ALLOW_OVERWRITE=1 to rerun this chunk" >&2
    echo "OUT_SUBDIR=${OUT_SUBDIR}" >&2
    echo "LOG_SUBDIR=${LOG_SUBDIR}" >&2
    exit 3
  fi
  rm -rf "${OUT_SUBDIR}" "${LOG_SUBDIR}"
fi

mkdir -p "${OUT_SUBDIR}" "${LOG_SUBDIR}"
exec > "${BOOT_LOG}" 2>&1

date -Is
hostname
pwd

TASK_METHOD_ORDER="no_fb_first"
if [ "${TLTM_METHOD}" = "fb_norefine" ] || [ "${TLTM_METHOD}" = "fb" ]; then
  TASK_METHOD_ORDER="fb_first"
fi

{
  echo "job_tag=m6_reference_${TLTM_REF_LEVEL}_${TLTM_METHOD}_chunk_${TLTM_CHUNK_ID}"
  echo "submitted_for=fortran_modernization_m6_reference_dataset"
  echo "date_start=$(date -Is)"
  echo "hostname=$(hostname)"
  echo "pwd=$(pwd)"
  echo "git_branch=${CURRENT_BRANCH}"
  echo "git_commit=${CURRENT_COMMIT}"
  echo "ref_level=${TLTM_REF_LEVEL}"
  echo "ref_label=${TLTM_REF_LABEL}"
  echo "config=${TLTM_CONFIG_JSON}"
  echo "method=${TLTM_METHOD}"
  echo "chunk_id=${TLTM_CHUNK_ID}"
  echo "seed_offset=${TLTM_SEED_OFFSET}"
  echo "max_seeds=${TLTM_MAX_SEEDS}"
  echo "jobs=${TLTM_JOBS}"
  echo "constraint_tol_override=${TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE}"
  echo "qn_quasi_tol_override=${QN_QUASI_TOL_OVERRIDE}"
  echo "reverse_gate_enabled=${QN_REVERSE_GATE_ENABLED}"
  echo "reverse_gate_tol=${QN_REVERSE_GATE_TOL}"
  echo "qn_s1_probe_max_iter=${QN_S1_PROBE_MAX_ITER}"
  echo "stage2_v1_sidecars=on"
  echo "stage2_protocol_audit=auto"
  echo "stage2_protocol_audit_fail_on=error"
  echo "output_subdir=${OUT_SUBDIR}"
  echo "logs_subdir=${LOG_SUBDIR}"
} > "${LOG_SUBDIR}/run_manifest.txt"

python3 scripts/run_stage3_3_multiseed.py \
  --repo-root . \
  --config "${TLTM_CONFIG_JSON}" \
  --methods "${TLTM_METHOD}" \
  --seed-offset "${TLTM_SEED_OFFSET}" \
  --max-seeds "${TLTM_MAX_SEEDS}" \
  --output-subdir "${OUT_SUBDIR}" \
  --logs-subdir "${LOG_SUBDIR}" \
  --log-prefix "m6_reference_${TLTM_REF_LEVEL}_${TLTM_METHOD}_chunk_${TLTM_CHUNK_ID}" \
  --report-title "M6 modernization reference ${TLTM_REF_LEVEL} ${TLTM_METHOD} chunk ${TLTM_CHUNK_ID}" \
  --schedule task \
  --task-method-order "${TASK_METHOD_ORDER}" \
  --jobs "${TLTM_JOBS}" \
  --stage2-threads 1 \
  --eval-threads 1 \
  --stage2-v1-sidecars on \
  --stage2-protocol-audit auto \
  --stage2-protocol-audit-fail-on error \
  --skip-build

echo "date_end=$(date -Is)" >> "${LOG_SUBDIR}/run_manifest.txt"
date -Is
