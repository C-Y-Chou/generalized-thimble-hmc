#!/bin/bash
#PBS -N odex100k_fbnr
#PBS -q C12
#PBS -l select=1:ncpus=20:mpiprocs=20:mem=8gb
#PBS -l walltime=08:00:00
#PBS -o /lustre1/home/cychou/TLTM/output/logs/odex_validation/odex100k_fb_norefine_ct1e13_qn1e13.pbs.out
#PBS -e /lustre1/home/cychou/TLTM/output/logs/odex_validation/odex100k_fb_norefine_ct1e13_qn1e13.pbs.err

set -euo pipefail
module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OMP_PROC_BIND=true
export OMP_PLACES=cores
export CONSTRAINT_FAIL_CAPTURE_START_SAMPLE=2147483647

export TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE=1e-13
export QN_REVERSE_GATE_ENABLED=1
export QN_REVERSE_GATE_TOL=1e-8
export QN_S1_PROBE_MAX_ITER=28
export QN_S1_NEAR_RESCUE_ENABLED=0
export QN_S1_NONNEAR_RESCUE_ENABLED=0
export QN_QUASI_GLOBAL_FALLBACK_ENABLED=0
export QN_QUASI_TOL_OVERRIDE=1e-13

: "${SUBMIT_BRANCH:=unknown}"
: "${SUBMIT_COMMIT:=unknown}"
: "${SUBMIT_TREE_STATUS:=unknown}"

cd /lustre1/home/cychou/TLTM

OUT_SUBDIR="output/tests/odex_validation/20260508_10seed_100k_fb_norefine_ct1e13_qn1e13"
LOG_SUBDIR="output/logs/odex_validation/20260508_10seed_100k_fb_norefine_ct1e13_qn1e13"
rm -rf "${OUT_SUBDIR}" "${LOG_SUBDIR}"
mkdir -p "${LOG_SUBDIR}"

{
  echo "job_tag=odex100k_20260508_fb_norefine_ct1e13_qn1e13"
  echo "submitted_for=fortran_modernization_ODEX_100k_validation"
  echo "date_start=$(date -Is)"
  echo "hostname=$(hostname)"
  echo "pwd=$(pwd)"
  echo "submit_branch=${SUBMIT_BRANCH}"
  echo "submit_commit=${SUBMIT_COMMIT}"
  echo "submit_tree_status=${SUBMIT_TREE_STATUS}"
  echo "pbs_script=codex/workspaces/fortran_modernization/tasks/pbs/odex_100k_validation_20260508_fb_norefine.pbs"
  echo "config=docs/stage_3_4_t035_paired_10seed_100k_rg.json"
  echo "method=fb_norefine"
  echo "max_seeds=10"
  echo "cycles_per_seed=100000"
  echo "constraint_tol_override=${TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE}"
  echo "qn_quasi_tol_override=${QN_QUASI_TOL_OVERRIDE}"
  echo "reverse_gate_enabled=${QN_REVERSE_GATE_ENABLED}"
  echo "reverse_gate_tol=${QN_REVERSE_GATE_TOL}"
  echo "qn_s1_probe_max_iter=${QN_S1_PROBE_MAX_ITER}"
  echo "output_subdir=${OUT_SUBDIR}"
  echo "logs_subdir=${LOG_SUBDIR}"
} > "${LOG_SUBDIR}/run_manifest.txt"

python3 scripts/run_stage3_3_multiseed.py \
  --repo-root . \
  --config docs/stage_3_4_t035_paired_10seed_100k_rg.json \
  --methods fb_norefine \
  --max-seeds 10 \
  --output-subdir "${OUT_SUBDIR}" \
  --logs-subdir "${LOG_SUBDIR}" \
  --log-prefix "odex100k_fb_norefine_ct1e13_qn1e13" \
  --report-title "ODEX 100k validation fb_norefine ct1e-13 qn1e-13" \
  --schedule task \
  --task-method-order fb_first \
  --jobs 20 \
  --stage2-threads 1 \
  --eval-threads 1 \
  --skip-build

echo "date_end=$(date -Is)" >> "${LOG_SUBDIR}/run_manifest.txt"
