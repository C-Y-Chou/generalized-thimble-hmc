#!/bin/bash
#PBS -N wvweight
#PBS -q C17
#PBS -l select=1:ncpus=4:mpiprocs=4:mem=16gb
#PBS -l walltime=01:00:00
#PBS -j oe

set -euo pipefail

: "${TLTM_WORKTREE:?TLTM_WORKTREE is required}"
: "${TLTM_REMOTE_ROOT:?TLTM_REMOTE_ROOT is required}"
: "${TLTM_ANALYSIS_OUT:?TLTM_ANALYSIS_OUT is required}"
: "${TLTM_CYCLE_END:=0}"

cd "${TLTM_WORKTREE}"
mkdir -p "${TLTM_ANALYSIS_OUT}"
exec > "${TLTM_ANALYSIS_OUT}/pbs_boot_${PBS_JOBID:-manual}.log" 2>&1

echo "RUN_DATE=$(date -Is)"
echo "HOSTNAME=$(hostname)"
echo "PBS_JOBID=${PBS_JOBID:-manual}"
echo "TLTM_WORKTREE=${TLTM_WORKTREE}"
echo "TLTM_REMOTE_ROOT=${TLTM_REMOTE_ROOT}"
echo "TLTM_ANALYSIS_OUT=${TLTM_ANALYSIS_OUT}"
echo "TLTM_CYCLE_END=${TLTM_CYCLE_END}"

python3 codex/workspaces/fortran_modernization/tasks/scripts/analyze_wv_hmc_weight_variants_20260601.py \
  --root "${TLTM_REMOTE_ROOT}" \
  --out "${TLTM_ANALYSIS_OUT}/weight_variants_cycle${TLTM_CYCLE_END}.csv" \
  --cycle-end "${TLTM_CYCLE_END}"

echo "WV_HMC_WEIGHT_VARIANT_ANALYSIS_COMPLETE"
