#!/bin/bash
#PBS -N wvbank
#PBS -q C8
#PBS -l select=1:ncpus=8:mpiprocs=8:mem=16gb
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail

if [ -f /etc/profile.d/modules.sh ]; then
  # shellcheck source=/dev/null
  . /etc/profile.d/modules.sh
fi
if [ -f /usr/share/Modules/init/bash ]; then
  # shellcheck source=/dev/null
  . /usr/share/Modules/init/bash
fi
module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

: "${TLTM_WORKTREE:=/lustre1/home/cychou/TLTM_worktrees/fortran_modernization_wv_pilot_01f58ba}"
: "${TLTM_EXPECTED_GIT_BRANCH:=HEAD}"
: "${TLTM_EXPECTED_GIT_COMMIT:?TLTM_EXPECTED_GIT_COMMIT is required}"
: "${TLTM_RUN_NAME:=stephanov_n2_wv_hmc_t0_initial_bank_20260530}"
: "${TLTM_OUTPUT_ROOT:=/lustre1/home/cychou/TLTM_worktrees/fortran_modernization/output/wv_hmc_initial_banks_20260530}"
: "${TLTM_LOG_ROOT:=/lustre1/home/cychou/TLTM_worktrees/fortran_modernization/output/logs/wv_hmc_initial_banks_20260530/${TLTM_RUN_NAME}}"
: "${TLTM_PARAMETERS_FILE:=data/parameters_stephanov_n2_smoke.dat}"
: "${WV_BANK_CHAINS:=8}"
: "${WV_BANK_CYCLES:=2000}"
: "${WV_BANK_HISTORY_STRIDE:=5}"
: "${WV_BANK_BURN_RECORDS:=50}"
: "${WV_BANK_SEED_BASE:=8720000}"
: "${WV_BANK_INIT_SIGMA:=0.1}"
: "${WV_BANK_TARGET_FLOW_TIME:=0.005}"
: "${WV_BANK_VALIDATE_RECORDS:=1024}"
: "${TLTM_ODE_BACKEND:=dop853}"
: "${TLTM_DOP853_HINIT_ENABLED:=1}"
: "${TLTM_DOP853_STIFFNESS_CHECK_ENABLED:=1}"
: "${TLTM_DOP853_STIFFNESS_CHECK_INTERVAL:=1000}"
: "${TLTM_DOP853_STIFFNESS_MAX_HITS:=15}"
: "${TLTM_DOP853_STIFFNESS_THRESHOLD:=6.1}"
export TLTM_ODE_BACKEND
export TLTM_DOP853_HINIT_ENABLED
export TLTM_DOP853_STIFFNESS_CHECK_ENABLED
export TLTM_DOP853_STIFFNESS_CHECK_INTERVAL
export TLTM_DOP853_STIFFNESS_MAX_HITS
export TLTM_DOP853_STIFFNESS_THRESHOLD

cd "${TLTM_WORKTREE}"
mkdir -p "${TLTM_LOG_ROOT}"
exec > "${TLTM_LOG_ROOT}/pbs_boot_${PBS_JOBID:-manual}.log" 2>&1

echo "RUN_DATE=$(date -Is)"
echo "HOSTNAME=$(hostname)"
echo "PBS_JOBID=${PBS_JOBID:-manual}"
echo "PBS_QUEUE=${PBS_QUEUE:-unknown}"
echo "TLTM_WORKTREE=${TLTM_WORKTREE}"
echo "TLTM_RUN_NAME=${TLTM_RUN_NAME}"
echo "TLTM_PARAMETERS_FILE=${TLTM_PARAMETERS_FILE}"
echo "WV_BANK_CHAINS=${WV_BANK_CHAINS}"
echo "WV_BANK_CYCLES=${WV_BANK_CYCLES}"
echo "WV_BANK_HISTORY_STRIDE=${WV_BANK_HISTORY_STRIDE}"
echo "WV_BANK_BURN_RECORDS=${WV_BANK_BURN_RECORDS}"
echo "WV_BANK_SEED_BASE=${WV_BANK_SEED_BASE}"
echo "WV_BANK_INIT_SIGMA=${WV_BANK_INIT_SIGMA}"
echo "WV_BANK_TARGET_FLOW_TIME=${WV_BANK_TARGET_FLOW_TIME}"
echo "WV_BANK_VALIDATE_RECORDS=${WV_BANK_VALIDATE_RECORDS}"
echo "TLTM_ODE_BACKEND=${TLTM_ODE_BACKEND}"
echo "TLTM_DOP853_HINIT_ENABLED=${TLTM_DOP853_HINIT_ENABLED}"
echo "TLTM_DOP853_STIFFNESS_CHECK_ENABLED=${TLTM_DOP853_STIFFNESS_CHECK_ENABLED}"
echo "TLTM_DOP853_STIFFNESS_CHECK_INTERVAL=${TLTM_DOP853_STIFFNESS_CHECK_INTERVAL}"
echo "TLTM_DOP853_STIFFNESS_MAX_HITS=${TLTM_DOP853_STIFFNESS_MAX_HITS}"
echo "TLTM_DOP853_STIFFNESS_THRESHOLD=${TLTM_DOP853_STIFFNESS_THRESHOLD}"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
CURRENT_COMMIT="$(git rev-parse HEAD)"
echo "GIT_BRANCH=${CURRENT_BRANCH}"
echo "GIT_COMMIT=${CURRENT_COMMIT}"
echo "EXPECTED_GIT_COMMIT=${TLTM_EXPECTED_GIT_COMMIT}"
if [ "${TLTM_EXPECTED_GIT_BRANCH}" != "HEAD" ] && [ "${CURRENT_BRANCH}" != "${TLTM_EXPECTED_GIT_BRANCH}" ]; then
  echo "[ERROR] expected branch ${TLTM_EXPECTED_GIT_BRANCH}, got ${CURRENT_BRANCH}" >&2
  exit 2
fi
if [ "${CURRENT_COMMIT}" != "${TLTM_EXPECTED_GIT_COMMIT}" ]; then
  echo "[ERROR] expected commit ${TLTM_EXPECTED_GIT_COMMIT}, got ${CURRENT_COMMIT}" >&2
  exit 2
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "[ERROR] working tree is dirty; refusing WV-HMC initial-bank build" >&2
  git status --short >&2
  exit 2
fi

if [ -x .venv-dfols/bin/python ]; then
  DFOLS_SITE_PACKAGES="$(.venv-dfols/bin/python - <<'PY'
import sysconfig
print(sysconfig.get_paths()["purelib"])
PY
)"
  export TLTM_OFFICIAL_DFOLS_PYTHONPATH="${DFOLS_SITE_PACKAGES}${TLTM_OFFICIAL_DFOLS_PYTHONPATH:+:${TLTM_OFFICIAL_DFOLS_PYTHONPATH}}"
fi

# shellcheck source=/dev/null
. codex/workspaces/fortran_modernization/tasks/scripts/python_embed_env.sh

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export OMP_DYNAMIC=FALSE
export MKL_DYNAMIC=FALSE

make -C build clean
make -C build OMP=1 PYTHON="${PYTHON}" PYTHON_EMBED_CFLAGS="${PYTHON_EMBED_CFLAGS}" \
  PYTHON_EMBED_LDFLAGS="${PYTHON_EMBED_LDFLAGS}" ../bin/run_tltm_stage2 ../bin/build_flow_bank_dense

RUN_ROOT="${TLTM_OUTPUT_ROOT}/${TLTM_RUN_NAME}_${PBS_JOBID:-manual}"
mkdir -p "${RUN_ROOT}"

/usr/bin/time -p python3 codex/workspaces/fortran_modernization/tasks/scripts/build_stephanov_t0_checkpoint_bank.py \
  --repo-root "${TLTM_WORKTREE}" \
  --base-parameters "${TLTM_PARAMETERS_FILE}" \
  --output-root "${RUN_ROOT}" \
  --run-name t0_bank \
  --chains "${WV_BANK_CHAINS}" \
  --cycles "${WV_BANK_CYCLES}" \
  --history-stride "${WV_BANK_HISTORY_STRIDE}" \
  --burn-records "${WV_BANK_BURN_RECORDS}" \
  --seed-base "${WV_BANK_SEED_BASE}" \
  --init-sigma "${WV_BANK_INIT_SIGMA}" \
  --skip-build

BANK_DIR="${RUN_ROOT}/t0_bank/bank"
X_BANK="${BANK_DIR}/x_bank.dat"
COVERAGE_JSON="${BANK_DIR}/coverage_summary.json"
STATE_SIZE="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["n_state"])' "${COVERAGE_JSON}")"
SELECTED_RECORDS="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["selected_checkpoints"])' "${COVERAGE_JSON}")"
VALIDATE_RECORDS="${WV_BANK_VALIDATE_RECORDS}"
if [ "${VALIDATE_RECORDS}" -gt "${SELECTED_RECORDS}" ]; then
  VALIDATE_RECORDS="${SELECTED_RECORDS}"
fi

CACHE_DIR="${RUN_ROOT}/flow_prevalidation_t${WV_BANK_TARGET_FLOW_TIME//./p}"
SAFE_DIR="${RUN_ROOT}/safe_bank_t${WV_BANK_TARGET_FLOW_TIME//./p}"
mkdir -p "${CACHE_DIR}" "${SAFE_DIR}"

TLTM_PARAMETERS_FILE="${TLTM_PARAMETERS_FILE}" /usr/bin/time -p bin/build_flow_bank_dense \
  "${X_BANK}" \
  "${CACHE_DIR}" \
  "${WV_BANK_TARGET_FLOW_TIME}" \
  0 \
  "${VALIDATE_RECORDS}"

python3 codex/workspaces/fortran_modernization/tasks/scripts/filter_x_bank_by_flow_diagnostics_20260530.py \
  --input-x-bank "${X_BANK}" \
  --diagnostics "${CACHE_DIR}/diagnostics.csv" \
  --output-x-bank "${SAFE_DIR}/x_bank.dat" \
  --state-size "${STATE_SIZE}" \
  --output-index "${SAFE_DIR}/x_bank_index.csv" \
  --output-json "${SAFE_DIR}/coverage_summary.json"

echo "RUN_ROOT=${RUN_ROOT}"
echo "SOURCE_X_BANK=${X_BANK}"
echo "FLOW_CACHE=${CACHE_DIR}"
echo "SAFE_X_BANK=${SAFE_DIR}/x_bank.dat"
echo "SAFE_INDEX=${SAFE_DIR}/x_bank_index.csv"
echo "SAFE_COVERAGE=${SAFE_DIR}/coverage_summary.json"
cat "${SAFE_DIR}/coverage_summary.json"
