#!/bin/bash
#PBS -N n55a0
#PBS -q C12
#PBS -l select=1:ncpus=10:mpiprocs=10:mem=16gb
#PBS -l walltime=03:00:00
#PBS -j oe

set -euo pipefail

if [ -f /etc/profile.d/modules.sh ]; then
  # shellcheck source=/dev/null
  . /etc/profile.d/modules.sh
fi
if [ -f /usr/share/Modules/init/bash ]; then
  # shellcheck source=/dev/null
  . /usr/share/Modules/init/bash
fi
module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

: "${TLTM_WORKTREE:=/lustre1/home/cychou/TLTM_worktrees/fortran_modernization}"
: "${TLTM_EXPECTED_GIT_BRANCH:=codex/fortran-modernization}"
: "${TLTM_BASELINE_EVIDENCE_GIT_COMMIT:=e83892f7744ca197505c283ceaf0db47ff566531}"
: "${TLTM_BASELINE_EVIDENCE_CAMPAIGN:=observable_regression_true_rngv2_assistoff_dfols_npt5_r0055_10seed_10k_20260515_e83892f}"
: "${TLTM_CONFIG_JSON:=docs/production_comparison_official_dfols_20260511_10seed_10k_nofb_withfb.json}"
: "${TLTM_METHOD:=no_fb}"
: "${TLTM_MAX_SEEDS:=10}"
: "${TLTM_SEED_OFFSET:=0}"
: "${TLTM_RUN_JOBS:=10}"
: "${TLTM_CYCLES_PER_SEED_LABEL:=10000}"

if [ -z "${TLTM_CANONICAL_METHOD:-}" ]; then
  case "${TLTM_METHOD}" in
    no_fb) TLTM_CANONICAL_METHOD=nofb ;;
    fb_norefine) TLTM_CANONICAL_METHOD=withfb ;;
    *)
      echo "[ERROR] unsupported TLTM_METHOD=${TLTM_METHOD}; expected no_fb or fb_norefine" >&2
      exit 2
      ;;
  esac
fi

cd "${TLTM_WORKTREE}"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
CURRENT_COMMIT="$(git rev-parse HEAD)"
CURRENT_SHORT="$(git rev-parse --short=12 HEAD)"
: "${TLTM_EXPECTED_GIT_COMMIT:?TLTM_EXPECTED_GIT_COMMIT is required; pass the submitted git rev-parse HEAD explicitly}"
if [ "${CURRENT_BRANCH}" != "${TLTM_EXPECTED_GIT_BRANCH}" ]; then
  echo "[ERROR] expected branch ${TLTM_EXPECTED_GIT_BRANCH}, got ${CURRENT_BRANCH}" >&2
  exit 2
fi
if [ "${CURRENT_COMMIT}" != "${TLTM_EXPECTED_GIT_COMMIT}" ]; then
  echo "[ERROR] expected commit ${TLTM_EXPECTED_GIT_COMMIT}, got ${CURRENT_COMMIT}" >&2
  exit 2
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "[ERROR] working tree is dirty; refusing npt5 assist-off baseline run" >&2
  git status --short >&2
  exit 2
fi
if [ ! -x bin/run_tltm_stage2 ] || [ ! -x bin/evaluate_expectations ]; then
  echo "[ERROR] missing production binaries; build official DFO-LS binaries first" >&2
  exit 4
fi
if [ ! -x .venv-dfols/bin/python ]; then
  echo "[ERROR] missing .venv-dfols" >&2
  exit 4
fi

BASELINE_RUNTIME_SOURCE_RELATION="baseline_evidence_commit_not_found"
if git cat-file -e "${TLTM_BASELINE_EVIDENCE_GIT_COMMIT}^{commit}" 2>/dev/null; then
  if git diff --quiet "${TLTM_BASELINE_EVIDENCE_GIT_COMMIT}" "${CURRENT_COMMIT}" -- src scripts build tests docs; then
    BASELINE_RUNTIME_SOURCE_RELATION="runtime_source_matches_baseline_evidence"
  else
    BASELINE_RUNTIME_SOURCE_RELATION="runtime_source_differs_from_baseline_evidence"
  fi
fi

case "${TLTM_METHOD}:${TLTM_CANONICAL_METHOD}" in
  no_fb:nofb) TLTM_TASK_METHOD_ORDER="no_fb_first" ;;
  fb_norefine:withfb) TLTM_TASK_METHOD_ORDER="fb_first" ;;
  *)
    echo "[ERROR] unsupported method mapping: ${TLTM_METHOD}:${TLTM_CANONICAL_METHOD}" >&2
    exit 2
    ;;
esac

DFOLS_SITE_PACKAGES="$(.venv-dfols/bin/python - <<'PY'
import sysconfig
print(sysconfig.get_paths()["purelib"])
PY
)"
export TLTM_OFFICIAL_DFOLS_PYTHONPATH="${DFOLS_SITE_PACKAGES}${TLTM_OFFICIAL_DFOLS_PYTHONPATH:+:${TLTM_OFFICIAL_DFOLS_PYTHONPATH}}"

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OMP_PROC_BIND=true
export OMP_PLACES=cores
export CONSTRAINT_FAIL_CAPTURE_START_SAMPLE=2147483647

export TLTM_STAGE2_RNG_STREAM_CONTRACT=stage2_kernel_rng_v2
export TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE=1e-13
export TLTM_ODE_BACKEND="${TLTM_ODE_BACKEND:-dop853}"
: "${TLTM_ODE_TOLERANCE_SOURCE:=parameters_abs_rel_tol_3e-14}"
: "${TLTM_SUNDIALS_PREFIX:=}"
export QN_REVERSE_GATE_ENABLED=1
export QN_REVERSE_GATE_TOL=1e-8
export QN_S1_PROBE_MAX_ITER=28
export QN_S1_NEAR_RESCUE_ENABLED=0
export QN_S1_NONNEAR_RESCUE_ENABLED=0
export QN_QUASI_GLOBAL_FALLBACK_ENABLED=0
export QN_QUASI_TOL_OVERRIDE=1e-13
export QN_SOLVER_BACKEND=official_dfols
export QN_OFFICIAL_DFOLS_PRESET=stable_gate77
export QN_OFFICIAL_DFOLS_NPT=5
export QN_OFFICIAL_DFOLS_MAXFUN=500
export QN_OFFICIAL_DFOLS_OBJFUN_HAS_NOISE=1
export QN_OFFICIAL_DFOLS_RHOBEG=0.055
export QN_OFFICIAL_DFOLS_RHOEND=1e-16
export QN_OFFICIAL_DFOLS_MODEL_ABS_TOL=1e-30
export QN_OFFICIAL_DFOLS_MODEL_REL_TOL=0

unset INTODE_SOLVER_ASSIST_ENABLED || true
export INTODE_SOLVER_ASSIST_POLICY=off
export TLTM_STAGE3_METHOD_ASSIST_POLICY=off
unset TLTM_STAGE3_METHOD_ASSIST_ENABLED || true
ASSIST_LABEL="INTODE_SOLVER_ASSIST_POLICY=off"

if [ "${TLTM_ODE_BACKEND}" = "sundials_cvode" ]; then
  if [ ! -x bin/test_sundials_cvode_backend_contract ]; then
    echo "[ERROR] missing SUNDIALS CVODE contract test binary" >&2
    exit 4
  fi
  TLTM_EXPECT_SUNDIALS_CVODE=1 bin/test_sundials_cvode_backend_contract
fi

RUN_STAMP="${TLTM_RUN_STAMP:-$(date +%Y%m%dT%H%M%S)}"
: "${TLTM_CAMPAIGN:=observable_regression_true_rngv2_assistoff_dfols_npt5_r0055_10seed_10k_${RUN_STAMP}_${CURRENT_SHORT}}"

ROOT_SUBDIR="output/production_comparison/observable_regression/${TLTM_CAMPAIGN}"
ROOT_LOG_SUBDIR="output/logs/production_comparison/observable_regression/${TLTM_CAMPAIGN}"
OUT_SUBDIR="${ROOT_SUBDIR}/npt5_r0055/${TLTM_METHOD}"
LOG_SUBDIR="${ROOT_LOG_SUBDIR}/npt5_r0055/${TLTM_METHOD}"

if [ -e "${OUT_SUBDIR}" ] || [ -e "${LOG_SUBDIR}" ]; then
  echo "[ERROR] output/log subdir already exists; set a unique TLTM_RUN_STAMP or TLTM_CAMPAIGN" >&2
  echo "[ERROR] OUT_SUBDIR=${OUT_SUBDIR}" >&2
  echo "[ERROR] LOG_SUBDIR=${LOG_SUBDIR}" >&2
  exit 2
fi
mkdir -p "${OUT_SUBDIR}" "${LOG_SUBDIR}"
exec > "${LOG_SUBDIR}/pbs_boot.log" 2>&1

{
  echo "RUN_DATE=$(date -Is)"
  echo "RUNNER=codex"
  echo "GIT_BRANCH=${CURRENT_BRANCH}"
  echo "GIT_COMMIT=${CURRENT_COMMIT}"
  echo "EXPECTED_GIT_COMMIT=${TLTM_EXPECTED_GIT_COMMIT}"
  echo "BASELINE_EVIDENCE_GIT_COMMIT=${TLTM_BASELINE_EVIDENCE_GIT_COMMIT}"
  echo "BASELINE_EVIDENCE_CAMPAIGN=${TLTM_BASELINE_EVIDENCE_CAMPAIGN}"
  echo "BASELINE_RUNTIME_SOURCE_RELATION=${BASELINE_RUNTIME_SOURCE_RELATION}"
  echo "CONFIG_JSON=${TLTM_CONFIG_JSON}"
  echo "CAMPAIGN=${TLTM_CAMPAIGN}"
  echo "DFOLS_CANDIDATE=npt5_r0055"
  echo "RAW_METHOD=${TLTM_METHOD}"
  echo "CANONICAL_METHOD=${TLTM_CANONICAL_METHOD}"
  echo "SEED_OFFSET=${TLTM_SEED_OFFSET}"
  echo "N_SEEDS=${TLTM_MAX_SEEDS}"
  echo "CYCLES_PER_SEED=${TLTM_CYCLES_PER_SEED_LABEL}"
  echo "OUTPUT_SUBDIR=${OUT_SUBDIR}"
  echo "LOG_SUBDIR=${LOG_SUBDIR}"
  echo "ASSIST_POLICY=${ASSIST_LABEL}"
  echo "TLTM_STAGE3_METHOD_ASSIST_POLICY=${TLTM_STAGE3_METHOD_ASSIST_POLICY:-}"
  echo "TLTM_STAGE3_METHOD_ASSIST_ENABLED=${TLTM_STAGE3_METHOD_ASSIST_ENABLED:-}"
  echo "TLTM_STAGE2_RNG_STREAM_CONTRACT=${TLTM_STAGE2_RNG_STREAM_CONTRACT}"
  echo "TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE=${TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE}"
  echo "TLTM_ODE_BACKEND=${TLTM_ODE_BACKEND}"
  echo "TLTM_ODE_TOLERANCE_SOURCE=${TLTM_ODE_TOLERANCE_SOURCE}"
  echo "TLTM_SUNDIALS_PREFIX=${TLTM_SUNDIALS_PREFIX}"
  echo "QN_SOLVER_BACKEND=${QN_SOLVER_BACKEND}"
  echo "QN_REVERSE_GATE_ENABLED=${QN_REVERSE_GATE_ENABLED}"
  echo "QN_REVERSE_GATE_TOL=${QN_REVERSE_GATE_TOL}"
  echo "QN_S1_PROBE_MAX_ITER=${QN_S1_PROBE_MAX_ITER}"
  echo "QN_QUASI_TOL_OVERRIDE=${QN_QUASI_TOL_OVERRIDE}"
  echo "QN_OFFICIAL_DFOLS_PRESET=${QN_OFFICIAL_DFOLS_PRESET}"
  echo "QN_OFFICIAL_DFOLS_NPT=${QN_OFFICIAL_DFOLS_NPT}"
  echo "QN_OFFICIAL_DFOLS_MAXFUN=${QN_OFFICIAL_DFOLS_MAXFUN}"
  echo "QN_OFFICIAL_DFOLS_OBJFUN_HAS_NOISE=${QN_OFFICIAL_DFOLS_OBJFUN_HAS_NOISE}"
  echo "QN_OFFICIAL_DFOLS_RHOBEG=${QN_OFFICIAL_DFOLS_RHOBEG}"
  echo "QN_OFFICIAL_DFOLS_RHOEND=${QN_OFFICIAL_DFOLS_RHOEND}"
  echo "QN_OFFICIAL_DFOLS_MODEL_ABS_TOL=${QN_OFFICIAL_DFOLS_MODEL_ABS_TOL}"
  echo "QN_OFFICIAL_DFOLS_MODEL_REL_TOL=${QN_OFFICIAL_DFOLS_MODEL_REL_TOL}"
  echo "TLTM_OFFICIAL_DFOLS_PYTHONPATH=${TLTM_OFFICIAL_DFOLS_PYTHONPATH:-}"
} > "${OUT_SUBDIR}/method_manifest.env"

python3 scripts/run_stage3_3_multiseed.py \
  --repo-root . \
  --config "${TLTM_CONFIG_JSON}" \
  --methods "${TLTM_METHOD}" \
  --max-seeds "${TLTM_MAX_SEEDS}" \
  --seed-offset "${TLTM_SEED_OFFSET}" \
  --output-subdir "${OUT_SUBDIR}" \
  --logs-subdir "${LOG_SUBDIR}" \
  --log-prefix "obs10_truev2_assistoff_dfols_npt5_r0055_${TLTM_METHOD}" \
  --report-title "True RNG v2 assist-off official DFO-LS npt5_r0055 ${TLTM_METHOD}" \
  --schedule task \
  --task-method-order "${TLTM_TASK_METHOD_ORDER}" \
  --jobs "${TLTM_RUN_JOBS}" \
  --stage2-threads 1 \
  --eval-threads 1 \
  --skip-build \
  --allow-oversubscribe

echo "[DONE] true RNG v2 assist-off official DFO-LS npt5_r0055 complete: ${TLTM_METHOD}"
