#!/bin/bash
set -euo pipefail

: "${TLTM_WORKTREE:=/lustre1/home/cychou/TLTM_worktrees/tltm_production_comparison}"
: "${TLTM_EXPECTED_GIT_BRANCH:=codex/tltm-production-comparison-official-dfols}"
: "${TLTM_EXPECTED_GIT_COMMIT:?TLTM_EXPECTED_GIT_COMMIT is required}"

cd "${TLTM_WORKTREE}"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
CURRENT_COMMIT="$(git rev-parse HEAD)"
if [ "${CURRENT_BRANCH}" != "${TLTM_EXPECTED_GIT_BRANCH}" ]; then
  echo "[ERROR] expected branch ${TLTM_EXPECTED_GIT_BRANCH}, got ${CURRENT_BRANCH}" >&2
  exit 2
fi
if [ "${CURRENT_COMMIT}" != "${TLTM_EXPECTED_GIT_COMMIT}" ]; then
  echo "[ERROR] expected commit ${TLTM_EXPECTED_GIT_COMMIT}, got ${CURRENT_COMMIT}" >&2
  exit 2
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "[ERROR] working tree is dirty; refusing official DFO-LS 128seed/100k merge" >&2
  git status --short >&2
  exit 2
fi

CONFIG_JSON="docs/production_comparison_official_dfols_20260511_128seed_100k_withfb_r4.json"
ROOT="output/production_comparison/provisional/official_dfols_gate_20260511_128seed_100k_p28_rg_withfb_r4"
METHOD_ROOT="${ROOT}/fb_norefine"
mkdir -p "${ROOT}"

python3 scripts/merge_stage3_multiseed_chunks.py \
  --repo-root . \
  --config "${CONFIG_JSON}" \
  --output-subdir "${METHOD_ROOT}" \
  --chunk-glob "chunk_*" \
  --log-prefix "pc_official_dfols_20260511_128seed_100k_fb_norefine" \
  --report-title "TLTM official DFO-LS 128seed 100k fb_norefine" \
  --expected-rows 128 \
  --jobs-label "16 chunks x 8 workers" \
  --requested-cpus 128

python3 - <<'PY'
import csv
from pathlib import Path

root = Path("output/production_comparison/provisional/official_dfols_gate_20260511_128seed_100k_p28_rg_withfb_r4")
method_root = root / "fb_norefine"
agg_path = method_root / "aggregated_summary_table.csv"
per_seed_path = method_root / "per_seed_summary_table.csv"

if not agg_path.exists():
    raise SystemExit("missing aggregate: {0}".format(agg_path))
if not per_seed_path.exists():
    raise SystemExit("missing per-seed table: {0}".format(per_seed_path))

with agg_path.open(newline="") as handle:
    rows = list(csv.DictReader(handle))
if len(rows) != 1:
    raise SystemExit("expected one aggregate row in {0}, got {1}".format(agg_path, len(rows)))

row = dict(rows[0])
row["canonical_method"] = "withfb"
row["raw_method"] = "fb_norefine"

preferred = [
    "canonical_method",
    "raw_method",
    "method",
    "n_seeds",
    "P68_re",
    "P95_re",
    "P68_im",
    "P95_im",
    "mean_Ohat_re",
    "mean_Ohat_im",
    "std_Ohat_re",
    "std_Ohat_im",
    "Zmean_re",
    "Zmean_im",
    "total_unresolved_failure_count",
    "total_reverse_gate_total_reject_count",
    "mean_runtime_total",
    "total_post_refine_skip_count",
    "total_post_refine_success_count",
    "total_post_refine_attempt_count",
]
columns = preferred + sorted(set(row) - set(preferred))
with (root / "official_withfb_summary_table.csv").open("w", newline="") as handle:
    writer = csv.DictWriter(handle, fieldnames=columns, extrasaction="ignore")
    writer.writeheader()
    writer.writerow(row)

with per_seed_path.open(newline="") as handle:
    per_seed_count = sum(1 for _ in csv.DictReader(handle))

baseline = {
    "m6_r4_nofb_mean_re": 0.0067843097,
    "m6_r4_nofb_mean_im": -0.0026896585,
    "m6_r4_nofb_failures": 962417,
    "m6_r4_nofb_rg_rejects": 152279,
    "m6_r4_nofb_pair0_accept": 0.438617,
    "m6_r4_nofb_runtime": 7689.963103,
    "m6_r4_withfb_mean_re": -0.0011736472,
    "m6_r4_withfb_mean_im": -0.0012498974,
    "m6_r4_withfb_failures": 224580,
    "m6_r4_withfb_rg_rejects": 200530,
    "m6_r4_withfb_pair0_accept": 0.438762,
    "m6_r4_withfb_runtime": 8486.587849,
}

def num(key):
    return float(row[key])

def integer(key):
    return int(float(row[key]))

official = {
    "mean_re": num("mean_Ohat_re"),
    "mean_im": num("mean_Ohat_im"),
    "zmean_re": num("Zmean_re"),
    "zmean_im": num("Zmean_im"),
    "failures": integer("total_unresolved_failure_count"),
    "rg_rejects": integer("total_reverse_gate_total_reject_count"),
    "pair0_accept": num("mean_pair0_accept_rate"),
    "runtime": num("mean_runtime_total"),
}

lines = [
    "# Official DFO-LS 128seed/100k Withfb R4 Gate",
    "",
    "Campaign: `official_dfols_gate_20260511_128seed_100k_p28_rg_withfb_r4`",
    "",
    "Setup:",
    "- physical point: `t=0.35,L=2,nstep=20`",
    "- scale: `128 seeds x 100000 cycles`",
    "- method: `fb_norefine -> withfb` only",
    "- baseline: accepted M6 R4 `nofb` and `withfb/fb_norefine` reference rows",
    "- backend: `QN_SOLVER_BACKEND=official_dfols`, `QN_OFFICIAL_DFOLS_PRESET=stable_gate77`",
    "- gate: RG on, p28, `cttol=1e-13`, `QN_QUASI_TOL_OVERRIDE=1e-13`",
    "",
    "Official DFO-LS result:",
    "",
    "| canonical | raw | n_seeds | P68 Re | P95 Re | P68 Im | P95 Im | mean Re<O> | mean Im<O> | std Re<O> | std Im<O> | Zmean Re<O> | Zmean Im<O> | failure | rev_rej | runtime | post-refine |",
    "|---|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|",
]
post = "{0}/{1}".format(row.get("total_post_refine_success_count", "0"), row.get("total_post_refine_attempt_count", "0"))
lines.append(
    "| {canonical_method} | {raw_method} | {n_seeds} | {P68_re} | {P95_re} | {P68_im} | {P95_im} | {mean_Ohat_re} | {mean_Ohat_im} | {std_Ohat_re} | {std_Ohat_im} | {Zmean_re} | {Zmean_im} | {total_unresolved_failure_count} | {total_reverse_gate_total_reject_count} | {mean_runtime_total} | {post} |".format(post=post, **row)
)

lines.extend([
    "",
    "Comparison to M6 R4 reference:",
    "",
    "| metric | M6 R4 nofb | M6 R4 withfb | official DFO-LS withfb | official withfb - M6 R4 withfb | official withfb - M6 R4 nofb |",
    "|---|---:|---:|---:|---:|---:|",
    "| mean Re<O> | {m6_r4_nofb_mean_re} | {m6_r4_withfb_mean_re} | {official:.10g} | {d_with:+.6g} | {d_nofb:+.6g} |".format(
        official=official["mean_re"],
        d_with=official["mean_re"] - baseline["m6_r4_withfb_mean_re"],
        d_nofb=official["mean_re"] - baseline["m6_r4_nofb_mean_re"],
        **baseline
    ),
    "| mean Im<O> | {m6_r4_nofb_mean_im} | {m6_r4_withfb_mean_im} | {official:.10g} | {d_with:+.6g} | {d_nofb:+.6g} |".format(
        official=official["mean_im"],
        d_with=official["mean_im"] - baseline["m6_r4_withfb_mean_im"],
        d_nofb=official["mean_im"] - baseline["m6_r4_nofb_mean_im"],
        **baseline
    ),
    "| unresolved failures | {m6_r4_nofb_failures} | {m6_r4_withfb_failures} | {official} | {d_with:+d} | {d_nofb:+d} |".format(
        official=official["failures"],
        d_with=official["failures"] - baseline["m6_r4_withfb_failures"],
        d_nofb=official["failures"] - baseline["m6_r4_nofb_failures"],
        **baseline
    ),
    "| RG rejects | {m6_r4_nofb_rg_rejects} | {m6_r4_withfb_rg_rejects} | {official} | {d_with:+d} | {d_nofb:+d} |".format(
        official=official["rg_rejects"],
        d_with=official["rg_rejects"] - baseline["m6_r4_withfb_rg_rejects"],
        d_nofb=official["rg_rejects"] - baseline["m6_r4_nofb_rg_rejects"],
        **baseline
    ),
    "| pair0 accept | {m6_r4_nofb_pair0_accept} | {m6_r4_withfb_pair0_accept} | {official:.10g} | {d_with:+.6g} | {d_nofb:+.6g} |".format(
        official=official["pair0_accept"],
        d_with=official["pair0_accept"] - baseline["m6_r4_withfb_pair0_accept"],
        d_nofb=official["pair0_accept"] - baseline["m6_r4_nofb_pair0_accept"],
        **baseline
    ),
    "| mean runtime s | {m6_r4_nofb_runtime} | {m6_r4_withfb_runtime} | {official:.10g} | {d_with:+.6g} | {d_nofb:+.6g} |".format(
        official=official["runtime"],
        d_with=official["runtime"] - baseline["m6_r4_withfb_runtime"],
        d_nofb=official["runtime"] - baseline["m6_r4_nofb_runtime"],
        **baseline
    ),
    "",
    "Per-seed row count: `{0}`".format(per_seed_count),
    "",
    "Artifacts:",
    "- `official_withfb_summary_table.csv`",
    "- `fb_norefine/aggregated_summary_table.csv`",
    "- `fb_norefine/per_seed_summary_table.csv`",
])

(root / "REPORT.md").write_text("\n".join(lines) + "\n")
print("[combined] wrote {0}".format(root / "official_withfb_summary_table.csv"))
print("[combined] wrote {0}".format(root / "REPORT.md"))
PY

echo "[DONE] official DFO-LS 128seed/100k withfb merge complete"
