#!/bin/bash
#PBS -N dfols_dch
#PBS -q C8
#PBS -l select=1:ncpus=8:mpiprocs=8:mem=16gb
#PBS -l walltime=04:00:00
#PBS -j oe

set -euo pipefail

if [ -f /etc/profile.d/modules.sh ]; then
  # shellcheck source=/dev/null
  . /etc/profile.d/modules.sh
fi
if [ -f /usr/share/Modules/init/bash ]; then
  # shellcheck source=/dev/null
  . /usr/share/Modules/init/bash
fi
module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

: "${TLTM_WORKTREE:=/lustre1/home/cychou/TLTM_worktrees/tltm_production_comparison}"
: "${TLTM_EXPECTED_GIT_BRANCH:=codex/tltm-production-comparison-official-dfols}"
: "${TLTM_EXPECTED_GIT_COMMIT:?TLTM_EXPECTED_GIT_COMMIT is required}"
: "${TLTM_DFOLS_PHASED_LABEL:?TLTM_DFOLS_PHASED_LABEL is required}"
: "${TLTM_DFOLS_PHASED_CONFIG:=docs/production_comparison_official_dfols_20260511_32seed_50k_nofb_withfb.json}"
: "${TLTM_DFOLS_PHASED_CANDIDATE:=rho050_m500}"
: "${TLTM_METHOD:?TLTM_METHOD is required: no_fb or fb_norefine}"
: "${TLTM_CANONICAL_METHOD:?TLTM_CANONICAL_METHOD is required: nofb or withfb}"
: "${TLTM_CHUNK_ID:?TLTM_CHUNK_ID is required}"
: "${TLTM_SEED_OFFSET:?TLTM_SEED_OFFSET is required}"
: "${TLTM_MAX_SEEDS:=8}"
: "${TLTM_RUN_JOBS:=8}"
: "${TLTM_ALLOW_OVERWRITE:=0}"
: "${QN_OFFICIAL_DFOLS_NPT:=4}"
: "${QN_OFFICIAL_DFOLS_MAXFUN:=500}"
: "${QN_OFFICIAL_DFOLS_OBJFUN_HAS_NOISE:=1}"
: "${QN_OFFICIAL_DFOLS_RHOBEG:=0.050}"
: "${QN_OFFICIAL_DFOLS_RHOEND:=1e-16}"
: "${QN_OFFICIAL_DFOLS_MODEL_ABS_TOL:=1e-30}"
: "${QN_OFFICIAL_DFOLS_MODEL_REL_TOL:=0}"

cd "${TLTM_WORKTREE}"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
CURRENT_COMMIT="$(git rev-parse HEAD)"
if [ "${CURRENT_BRANCH}" != "${TLTM_EXPECTED_GIT_BRANCH}" ]; then
  echo "[ERROR] expected branch ${TLTM_EXPECTED_GIT_BRANCH}, got ${CURRENT_BRANCH}" >&2
  exit 2
fi
if [ "${CURRENT_COMMIT}" != "${TLTM_EXPECTED_GIT_COMMIT}" ]; then
  echo "[ERROR] expected commit ${TLTM_EXPECTED_GIT_COMMIT}, got ${CURRENT_COMMIT}" >&2
  exit 2
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "[ERROR] working tree is dirty; refusing DFO-LS assist-off Phase D chunk" >&2
  git status --short >&2
  exit 2
fi
if [ ! -x bin/run_tltm_stage2 ] || [ ! -x bin/evaluate_expectations ]; then
  echo "[ERROR] missing production binaries; run official_dfols_preflight_build.pbs first" >&2
  exit 4
fi
if [ ! -x .venv-dfols/bin/python ]; then
  echo "[ERROR] missing .venv-dfols; run official_dfols_preflight_build.pbs first" >&2
  exit 4
fi

case "${TLTM_METHOD}" in
  no_fb|fb_norefine) ;;
  *) echo "[ERROR] unsupported TLTM_METHOD=${TLTM_METHOD}" >&2; exit 2 ;;
esac

DFOLS_SITE_PACKAGES="$(.venv-dfols/bin/python - <<'PY'
import sysconfig
print(sysconfig.get_paths()["purelib"])
PY
)"
export TLTM_OFFICIAL_DFOLS_PYTHONPATH="${DFOLS_SITE_PACKAGES}${TLTM_OFFICIAL_DFOLS_PYTHONPATH:+:${TLTM_OFFICIAL_DFOLS_PYTHONPATH}}"

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OMP_PROC_BIND=true
export OMP_PLACES=cores
export CONSTRAINT_FAIL_CAPTURE_START_SAMPLE=2147483647

export TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE=1e-13
export QN_REVERSE_GATE_ENABLED=1
export QN_REVERSE_GATE_TOL=1e-8
export QN_S1_PROBE_MAX_ITER=28
export QN_S1_NEAR_RESCUE_ENABLED=0
export QN_S1_NONNEAR_RESCUE_ENABLED=0
export QN_QUASI_GLOBAL_FALLBACK_ENABLED=0
export QN_QUASI_TOL_OVERRIDE=1e-13
export QN_SOLVER_BACKEND=official_dfols
export QN_OFFICIAL_DFOLS_PRESET=stable_gate77
export QN_OFFICIAL_DFOLS_NPT
export QN_OFFICIAL_DFOLS_MAXFUN
export QN_OFFICIAL_DFOLS_OBJFUN_HAS_NOISE
export QN_OFFICIAL_DFOLS_RHOBEG
export QN_OFFICIAL_DFOLS_RHOEND
export QN_OFFICIAL_DFOLS_MODEL_ABS_TOL
export QN_OFFICIAL_DFOLS_MODEL_REL_TOL
export INTODE_SOLVER_ASSIST_ENABLED=0

ROOT_SUBDIR="output/tests/dfols_assist_off_tuning/${TLTM_DFOLS_PHASED_LABEL}"
ROOT_LOG_SUBDIR="output/logs/dfols_assist_off_tuning/${TLTM_DFOLS_PHASED_LABEL}"
OUT_SUBDIR="${ROOT_SUBDIR}/stage/${TLTM_METHOD}/chunk_${TLTM_CHUNK_ID}"
LOG_SUBDIR="${ROOT_LOG_SUBDIR}/stage/${TLTM_METHOD}/chunk_${TLTM_CHUNK_ID}"

if [ -e "${OUT_SUBDIR}" ] || [ -e "${LOG_SUBDIR}" ]; then
  if [ "${TLTM_ALLOW_OVERWRITE}" != "1" ]; then
    echo "[ERROR] output/log path exists; set TLTM_ALLOW_OVERWRITE=1 to rerun" >&2
    echo "OUT_SUBDIR=${OUT_SUBDIR}" >&2
    echo "LOG_SUBDIR=${LOG_SUBDIR}" >&2
    exit 3
  fi
  rm -rf "${OUT_SUBDIR}" "${LOG_SUBDIR}"
fi
mkdir -p "${OUT_SUBDIR}" "${LOG_SUBDIR}" "${ROOT_SUBDIR}" "${ROOT_LOG_SUBDIR}"

{
  echo "label=${TLTM_DFOLS_PHASED_LABEL}"
  echo "candidate=${TLTM_DFOLS_PHASED_CANDIDATE}"
  echo "date_start=$(date -Is)"
  echo "hostname=$(hostname)"
  echo "git_branch=${CURRENT_BRANCH}"
  echo "git_commit=${CURRENT_COMMIT}"
  echo "config=${TLTM_DFOLS_PHASED_CONFIG}"
  echo "canonical_method=${TLTM_CANONICAL_METHOD}"
  echo "raw_method=${TLTM_METHOD}"
  echo "chunk_id=${TLTM_CHUNK_ID}"
  echo "seed_offset=${TLTM_SEED_OFFSET}"
  echo "max_seeds=${TLTM_MAX_SEEDS}"
  echo "cycles_per_seed=50000"
  echo "assist_policy=INTODE_SOLVER_ASSIST_ENABLED=0"
  echo "QN_SOLVER_BACKEND=${QN_SOLVER_BACKEND}"
  echo "QN_OFFICIAL_DFOLS_PRESET=${QN_OFFICIAL_DFOLS_PRESET}"
  echo "QN_OFFICIAL_DFOLS_NPT=${QN_OFFICIAL_DFOLS_NPT}"
  echo "QN_OFFICIAL_DFOLS_MAXFUN=${QN_OFFICIAL_DFOLS_MAXFUN}"
  echo "QN_OFFICIAL_DFOLS_OBJFUN_HAS_NOISE=${QN_OFFICIAL_DFOLS_OBJFUN_HAS_NOISE}"
  echo "QN_OFFICIAL_DFOLS_RHOBEG=${QN_OFFICIAL_DFOLS_RHOBEG}"
  echo "QN_OFFICIAL_DFOLS_RHOEND=${QN_OFFICIAL_DFOLS_RHOEND}"
  echo "QN_OFFICIAL_DFOLS_MODEL_ABS_TOL=${QN_OFFICIAL_DFOLS_MODEL_ABS_TOL}"
  echo "QN_OFFICIAL_DFOLS_MODEL_REL_TOL=${QN_OFFICIAL_DFOLS_MODEL_REL_TOL}"
  echo "output_subdir=${OUT_SUBDIR}"
  echo "log_subdir=${LOG_SUBDIR}"
  echo "tltm_official_dfols_pythonpath=${TLTM_OFFICIAL_DFOLS_PYTHONPATH}"
} > "${OUT_SUBDIR}/chunk_manifest.env"

python3 scripts/run_stage3_3_multiseed.py \
  --repo-root . \
  --config "${TLTM_DFOLS_PHASED_CONFIG}" \
  --methods "${TLTM_METHOD}" \
  --seed-offset "${TLTM_SEED_OFFSET}" \
  --max-seeds "${TLTM_MAX_SEEDS}" \
  --output-subdir "${OUT_SUBDIR}" \
  --logs-subdir "${LOG_SUBDIR}" \
  --log-prefix "dfols_assist_off_${TLTM_DFOLS_PHASED_CANDIDATE}_32s50k_${TLTM_METHOD}_chunk_${TLTM_CHUNK_ID}" \
  --report-title "DFO-LS assist-off ${TLTM_DFOLS_PHASED_CANDIDATE} 32seed 50k ${TLTM_METHOD} chunk ${TLTM_CHUNK_ID}" \
  --schedule task \
  --task-method-order no_fb_first \
  --jobs "${TLTM_RUN_JOBS}" \
  --stage2-threads 1 \
  --eval-threads 1 \
  --skip-build

echo "[DONE] DFO-LS assist-off Phase D chunk complete: ${TLTM_METHOD} chunk ${TLTM_CHUNK_ID}"
