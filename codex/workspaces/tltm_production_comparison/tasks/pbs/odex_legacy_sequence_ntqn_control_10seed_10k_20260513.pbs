#!/bin/bash
#PBS -N odexseq10
#PBS -q C8
#PBS -l select=1:ncpus=10:mpiprocs=10:mem=20gb
#PBS -l walltime=04:00:00
#PBS -j oe

set -euo pipefail

if [ -f /etc/profile.d/modules.sh ]; then
  # shellcheck source=/dev/null
  . /etc/profile.d/modules.sh
fi
if [ -f /usr/share/Modules/init/bash ]; then
  # shellcheck source=/dev/null
  . /usr/share/Modules/init/bash
fi
module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

: "${TLTM_WORKTREE:=/lustre1/home/cychou/TLTM_worktrees/tltm_odex_legacy_sequence_control}"
: "${TLTM_EXPECTED_GIT_BRANCH:=codex/odex-legacy-sequence-control}"
: "${TLTM_EXPECTED_GIT_COMMIT:?TLTM_EXPECTED_GIT_COMMIT is required}"
: "${TLTM_ODEX_LEGACY_SEQ_LABEL:=odex_legacy_sequence_ntqn_control_20260513_10s10k_v1}"
: "${TLTM_ODEX_LEGACY_SEQ_CONFIG:=docs/production_comparison_official_dfols_20260511_10seed_10k_nofb_withfb.json}"
: "${TLTM_ODEX_LEGACY_SEQ_MAX_SEEDS:=10}"
: "${TLTM_ODEX_LEGACY_SEQ_JOBS:=10}"
: "${TLTM_ODEX_LEGACY_SEQ_ALLOW_OVERWRITE:=0}"
: "${TLTM_ODEX_LEGACY_SEQ_CYCLES_LABEL:=10000}"
export TLTM_ODEX_LEGACY_SEQ_CONFIG
export TLTM_ODEX_LEGACY_SEQ_MAX_SEEDS
export TLTM_ODEX_LEGACY_SEQ_JOBS
export TLTM_ODEX_LEGACY_SEQ_CYCLES_LABEL

candidate="stable_gate77_legacy_nt_qn_assist_legacy_odex_sequence"
export TLTM_ODEX_LEGACY_SEQ_CANDIDATE="${candidate}"

cd "${TLTM_WORKTREE}"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
CURRENT_COMMIT="$(git rev-parse HEAD)"
if [ "${CURRENT_BRANCH}" != "${TLTM_EXPECTED_GIT_BRANCH}" ]; then
  echo "[ERROR] expected branch ${TLTM_EXPECTED_GIT_BRANCH}, got ${CURRENT_BRANCH}" >&2
  exit 2
fi
if [ "${CURRENT_COMMIT}" != "${TLTM_EXPECTED_GIT_COMMIT}" ]; then
  echo "[ERROR] expected commit ${TLTM_EXPECTED_GIT_COMMIT}, got ${CURRENT_COMMIT}" >&2
  exit 2
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "[ERROR] working tree is dirty; refusing ODEX legacy-sequence control run" >&2
  git status --short >&2
  exit 2
fi
if [ ! -x bin/run_tltm_stage2 ] || [ ! -x bin/evaluate_expectations ]; then
  echo "[ERROR] missing production binaries; run official_dfols_preflight_build.pbs first" >&2
  exit 4
fi
if [ ! -x .venv-dfols/bin/python ]; then
  echo "[ERROR] missing .venv-dfols; run official_dfols_preflight_build.pbs first" >&2
  exit 4
fi

OUT_ROOT="output/tests/odex_legacy_sequence_control/${TLTM_ODEX_LEGACY_SEQ_LABEL}"
LOG_ROOT="output/logs/odex_legacy_sequence_control/${TLTM_ODEX_LEGACY_SEQ_LABEL}"
export OUT_ROOT
export LOG_ROOT

if [ "${TLTM_ODEX_LEGACY_SEQ_ALLOW_OVERWRITE}" = "1" ]; then
  rm -rf "${OUT_ROOT}" "${LOG_ROOT}"
fi
if [ -e "${OUT_ROOT}/aggregated_summary_table.csv" ] || [ -e "${OUT_ROOT}/per_seed_summary_table.csv" ] || \
   [ -e "${LOG_ROOT}/pbs_boot.log" ]; then
  if [ "${TLTM_ODEX_LEGACY_SEQ_ALLOW_OVERWRITE}" != "1" ]; then
    echo "[ERROR] result output/log path exists; set TLTM_ODEX_LEGACY_SEQ_ALLOW_OVERWRITE=1 to rerun" >&2
    echo "OUT_ROOT=${OUT_ROOT}" >&2
    echo "LOG_ROOT=${LOG_ROOT}" >&2
    exit 3
  fi
fi
mkdir -p "${OUT_ROOT}" "${LOG_ROOT}"
exec > "${LOG_ROOT}/pbs_boot.log" 2>&1

DFOLS_SITE_PACKAGES="$(
  .venv-dfols/bin/python - <<'PY'
import sysconfig
print(sysconfig.get_paths()["purelib"])
PY
)"
export TLTM_OFFICIAL_DFOLS_PYTHONPATH="${DFOLS_SITE_PACKAGES}${TLTM_OFFICIAL_DFOLS_PYTHONPATH:+:${TLTM_OFFICIAL_DFOLS_PYTHONPATH}}"

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OMP_PROC_BIND=true
export OMP_PLACES=cores
export CONSTRAINT_FAIL_CAPTURE_START_SAMPLE=2147483647

export TLTM_ODEX_STEP_SEQUENCE=legacy
export TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE=1e-13
export QN_REVERSE_GATE_ENABLED=1
export QN_REVERSE_GATE_TOL=1e-8
export QN_S1_PROBE_MAX_ITER=28
export QN_S1_NEAR_RESCUE_ENABLED=0
export QN_S1_NONNEAR_RESCUE_ENABLED=0
export QN_QUASI_GLOBAL_FALLBACK_ENABLED=0
export QN_QUASI_TOL_OVERRIDE=1e-13
export QN_SOLVER_BACKEND=official_dfols
export QN_OFFICIAL_DFOLS_PRESET=stable_gate77
export QN_OFFICIAL_DFOLS_NPT=4
export QN_OFFICIAL_DFOLS_MAXFUN=250
export QN_OFFICIAL_DFOLS_OBJFUN_HAS_NOISE=1
export QN_OFFICIAL_DFOLS_RHOBEG=0.018
export QN_OFFICIAL_DFOLS_RHOEND=1e-16
export QN_OFFICIAL_DFOLS_MODEL_ABS_TOL=1e-30
export QN_OFFICIAL_DFOLS_MODEL_REL_TOL=0
export INTODE_SOLVER_ASSIST_POLICY=all_navigation_diagnostic
export INTODE_SOLVER_ASSIST_ENABLED=1

{
  echo "label=${TLTM_ODEX_LEGACY_SEQ_LABEL}"
  echo "candidate=${candidate}"
  echo "date_start=$(date -Is)"
  echo "hostname=$(hostname)"
  echo "git_branch=${CURRENT_BRANCH}"
  echo "git_commit=${CURRENT_COMMIT}"
  echo "config=${TLTM_ODEX_LEGACY_SEQ_CONFIG}"
  echo "methods=fb_norefine"
  echo "max_seeds=${TLTM_ODEX_LEGACY_SEQ_MAX_SEEDS}"
  echo "cycles_per_seed=${TLTM_ODEX_LEGACY_SEQ_CYCLES_LABEL}"
  echo "odex_sequence=TLTM_ODEX_STEP_SEQUENCE=${TLTM_ODEX_STEP_SEQUENCE}"
  echo "odex_sequence_values=2,4,6,12,18,36,..."
  echo "assist_policy=INTODE_SOLVER_ASSIST_POLICY=${INTODE_SOLVER_ASSIST_POLICY}"
  echo "legacy_assist_enabled=INTODE_SOLVER_ASSIST_ENABLED=${INTODE_SOLVER_ASSIST_ENABLED}"
  echo "control_intent=legacy ODEX nstep/ak sequence with legacy NT+QN navigation assist; certification/final/RG/Metropolis remain current code paths"
  echo "QN_SOLVER_BACKEND=${QN_SOLVER_BACKEND}"
  echo "QN_OFFICIAL_DFOLS_PRESET=${QN_OFFICIAL_DFOLS_PRESET}"
  echo "QN_OFFICIAL_DFOLS_NPT=${QN_OFFICIAL_DFOLS_NPT}"
  echo "QN_OFFICIAL_DFOLS_MAXFUN=${QN_OFFICIAL_DFOLS_MAXFUN}"
  echo "QN_OFFICIAL_DFOLS_OBJFUN_HAS_NOISE=${QN_OFFICIAL_DFOLS_OBJFUN_HAS_NOISE}"
  echo "QN_OFFICIAL_DFOLS_RHOBEG=${QN_OFFICIAL_DFOLS_RHOBEG}"
  echo "QN_OFFICIAL_DFOLS_RHOEND=${QN_OFFICIAL_DFOLS_RHOEND}"
  echo "QN_OFFICIAL_DFOLS_MODEL_ABS_TOL=${QN_OFFICIAL_DFOLS_MODEL_ABS_TOL}"
  echo "QN_OFFICIAL_DFOLS_MODEL_REL_TOL=${QN_OFFICIAL_DFOLS_MODEL_REL_TOL}"
  echo "TLTM_OFFICIAL_DFOLS_PYTHONPATH=${TLTM_OFFICIAL_DFOLS_PYTHONPATH}"
} > "${OUT_ROOT}/candidate_manifest.env"

python3 - <<'PY'
import os
import sys

sys.path.insert(0, "scripts")
import run_stage3_3_multiseed as stage3

stage3.METHOD_SPECS["fb_norefine"]["env_overrides"] = {
    "INTODE_SOLVER_ASSIST_POLICY": "all_navigation_diagnostic",
    "INTODE_SOLVER_ASSIST_ENABLED": "1",
    "TLTM_ODEX_STEP_SEQUENCE": "legacy",
}

sys.argv = [
    "run_stage3_3_multiseed.py",
    "--repo-root", ".",
    "--config", os.environ["TLTM_ODEX_LEGACY_SEQ_CONFIG"],
    "--methods", "fb_norefine",
    "--max-seeds", os.environ["TLTM_ODEX_LEGACY_SEQ_MAX_SEEDS"],
    "--output-subdir", os.environ["OUT_ROOT"],
    "--logs-subdir", os.environ["LOG_ROOT"],
    "--log-prefix", "odex_legacy_sequence_control_{0}".format(os.environ["TLTM_ODEX_LEGACY_SEQ_CANDIDATE"]),
    "--report-title", "ODEX legacy sequence NT+QN assist control {0} seeds x {1} cycles".format(
        os.environ["TLTM_ODEX_LEGACY_SEQ_MAX_SEEDS"],
        os.environ["TLTM_ODEX_LEGACY_SEQ_CYCLES_LABEL"],
    ),
    "--schedule", "task",
    "--task-method-order", "fb_first",
    "--jobs", os.environ["TLTM_ODEX_LEGACY_SEQ_JOBS"],
    "--stage2-threads", "1",
    "--eval-threads", "1",
    "--skip-build",
    "--allow-oversubscribe",
]
stage3.main()
PY

echo "date_end=$(date -Is)" >> "${OUT_ROOT}/candidate_manifest.env"
echo "[DONE] ODEX legacy-sequence NT+QN control complete: ${TLTM_ODEX_LEGACY_SEQ_LABEL}"
