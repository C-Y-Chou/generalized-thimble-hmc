#!/bin/bash
#PBS -N qnast_ref
#PBS -q C8
#PBS -l select=1:ncpus=10:mpiprocs=10:mem=20gb
#PBS -l walltime=06:00:00
#PBS -J 0-11
#PBS -j oe

set -euo pipefail

if [ -f /etc/profile.d/modules.sh ]; then
  # shellcheck source=/dev/null
  . /etc/profile.d/modules.sh
fi
if [ -f /usr/share/Modules/init/bash ]; then
  # shellcheck source=/dev/null
  . /usr/share/Modules/init/bash
fi
module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

: "${TLTM_WORKTREE:=/lustre1/home/cychou/TLTM_worktrees/tltm_production_comparison}"
: "${TLTM_EXPECTED_GIT_BRANCH:=codex/tltm-production-comparison-official-dfols}"
: "${TLTM_EXPECTED_GIT_COMMIT:?TLTM_EXPECTED_GIT_COMMIT is required}"
: "${TLTM_QN_ASSIST_REFINE_LABEL:=qn_assist_npt5_refine_20260513_6f98b5b_10s10k_v1}"
: "${TLTM_QN_ASSIST_REFINE_CONFIG:=docs/production_comparison_official_dfols_20260511_10seed_10k_nofb_withfb.json}"
: "${TLTM_QN_ASSIST_REFINE_MAX_SEEDS:=10}"
: "${TLTM_QN_ASSIST_REFINE_JOBS:=10}"
: "${TLTM_QN_ASSIST_REFINE_ALLOW_OVERWRITE:=0}"
: "${TLTM_QN_ASSIST_REFINE_CYCLES_LABEL:=10000}"

ARRAY_INDEX="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-${TLTM_QN_ASSIST_REFINE_INDEX:-}}}"
if [ -z "${ARRAY_INDEX}" ]; then
  echo "[ERROR] missing PBS_ARRAY_INDEX/PBS_ARRAYID/TLTM_QN_ASSIST_REFINE_INDEX" >&2
  exit 2
fi

case "${ARRAY_INDEX}" in
  0)  candidate="npt5_r0040_m500";        npt=5; maxfun=500;  noise=1; rhobeg=0.040 ;;
  1)  candidate="npt5_r0045_m500";        npt=5; maxfun=500;  noise=1; rhobeg=0.045 ;;
  2)  candidate="npt5_r0050_m500_anchor"; npt=5; maxfun=500;  noise=1; rhobeg=0.050 ;;
  3)  candidate="npt5_r0055_m500";        npt=5; maxfun=500;  noise=1; rhobeg=0.055 ;;
  4)  candidate="npt5_r0060_m500";        npt=5; maxfun=500;  noise=1; rhobeg=0.060 ;;
  5)  candidate="npt5_r0070_m500";        npt=5; maxfun=500;  noise=1; rhobeg=0.070 ;;
  6)  candidate="npt5_r0080_m500";        npt=5; maxfun=500;  noise=1; rhobeg=0.080 ;;
  7)  candidate="npt3_r0050_m500";        npt=3; maxfun=500;  noise=1; rhobeg=0.050 ;;
  8)  candidate="npt7_r0050_m500";        npt=7; maxfun=500;  noise=1; rhobeg=0.050 ;;
  9)  candidate="npt5_r0050_m750";        npt=5; maxfun=750;  noise=1; rhobeg=0.050 ;;
  10) candidate="npt5_r0050_m1000";       npt=5; maxfun=1000; noise=1; rhobeg=0.050 ;;
  11) candidate="npt5_r0060_m750";        npt=5; maxfun=750;  noise=1; rhobeg=0.060 ;;
  *) echo "[ERROR] unsupported refinement index ${ARRAY_INDEX}" >&2; exit 2 ;;
esac

cd "${TLTM_WORKTREE}"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
CURRENT_COMMIT="$(git rev-parse HEAD)"
if [ "${CURRENT_BRANCH}" != "${TLTM_EXPECTED_GIT_BRANCH}" ]; then
  echo "[ERROR] expected branch ${TLTM_EXPECTED_GIT_BRANCH}, got ${CURRENT_BRANCH}" >&2
  exit 2
fi
if [ "${CURRENT_COMMIT}" != "${TLTM_EXPECTED_GIT_COMMIT}" ]; then
  echo "[ERROR] expected commit ${TLTM_EXPECTED_GIT_COMMIT}, got ${CURRENT_COMMIT}" >&2
  exit 2
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "[ERROR] working tree is dirty; refusing QN-assist refinement run" >&2
  git status --short >&2
  exit 2
fi
if [ ! -x bin/run_tltm_stage2 ] || [ ! -x bin/evaluate_expectations ]; then
  echo "[ERROR] missing production binaries; run official_dfols_preflight_build.pbs first" >&2
  exit 4
fi
if [ ! -x .venv-dfols/bin/python ]; then
  echo "[ERROR] missing .venv-dfols; run official_dfols_preflight_build.pbs first" >&2
  exit 4
fi

OUT_ROOT="output/tests/qn_assist_npt5_refine/${TLTM_QN_ASSIST_REFINE_LABEL}"
LOG_ROOT="output/logs/qn_assist_npt5_refine/${TLTM_QN_ASSIST_REFINE_LABEL}"
CAND_OUT="${OUT_ROOT}/candidates/${candidate}"
CAND_LOG="${LOG_ROOT}/candidates/${candidate}"

if [ -e "${CAND_OUT}" ] || [ -e "${CAND_LOG}" ]; then
  if [ "${TLTM_QN_ASSIST_REFINE_ALLOW_OVERWRITE}" != "1" ]; then
    echo "[ERROR] candidate output/log path exists; set TLTM_QN_ASSIST_REFINE_ALLOW_OVERWRITE=1 to rerun" >&2
    echo "CAND_OUT=${CAND_OUT}" >&2
    echo "CAND_LOG=${CAND_LOG}" >&2
    exit 3
  fi
  rm -rf "${CAND_OUT}" "${CAND_LOG}"
fi
mkdir -p "${CAND_OUT}" "${CAND_LOG}" "${OUT_ROOT}/candidates" "${LOG_ROOT}/candidates"
exec > "${CAND_LOG}/pbs_boot.log" 2>&1

DFOLS_SITE_PACKAGES="$(
  .venv-dfols/bin/python - <<'PY'
import sysconfig
print(sysconfig.get_paths()["purelib"])
PY
)"
export TLTM_OFFICIAL_DFOLS_PYTHONPATH="${DFOLS_SITE_PACKAGES}${TLTM_OFFICIAL_DFOLS_PYTHONPATH:+:${TLTM_OFFICIAL_DFOLS_PYTHONPATH}}"

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OMP_PROC_BIND=true
export OMP_PLACES=cores
export CONSTRAINT_FAIL_CAPTURE_START_SAMPLE=2147483647

export TLTM_STAGE2_CONSTRAINT_TOL_OVERRIDE=1e-13
export QN_REVERSE_GATE_ENABLED=1
export QN_REVERSE_GATE_TOL=1e-8
export QN_S1_PROBE_MAX_ITER=28
export QN_S1_NEAR_RESCUE_ENABLED=0
export QN_S1_NONNEAR_RESCUE_ENABLED=0
export QN_QUASI_GLOBAL_FALLBACK_ENABLED=0
export QN_QUASI_TOL_OVERRIDE=1e-13
export QN_SOLVER_BACKEND=official_dfols
export QN_OFFICIAL_DFOLS_PRESET=stable_gate77
export QN_OFFICIAL_DFOLS_NPT="${npt}"
export QN_OFFICIAL_DFOLS_MAXFUN="${maxfun}"
export QN_OFFICIAL_DFOLS_OBJFUN_HAS_NOISE="${noise}"
export QN_OFFICIAL_DFOLS_RHOBEG="${rhobeg}"
export QN_OFFICIAL_DFOLS_RHOEND=1e-16
export QN_OFFICIAL_DFOLS_MODEL_ABS_TOL=1e-30
export QN_OFFICIAL_DFOLS_MODEL_REL_TOL=0
unset INTODE_SOLVER_ASSIST_ENABLED || true
export INTODE_SOLVER_ASSIST_POLICY=nt_strict_qn_navassist_cert_strict_rg_metropolis_v1

{
  echo "label=${TLTM_QN_ASSIST_REFINE_LABEL}"
  echo "candidate=${candidate}"
  echo "array_index=${ARRAY_INDEX}"
  echo "date_start=$(date -Is)"
  echo "hostname=$(hostname)"
  echo "git_branch=${CURRENT_BRANCH}"
  echo "git_commit=${CURRENT_COMMIT}"
  echo "config=${TLTM_QN_ASSIST_REFINE_CONFIG}"
  echo "methods=fb_norefine"
  echo "max_seeds=${TLTM_QN_ASSIST_REFINE_MAX_SEEDS}"
  echo "cycles_per_seed=${TLTM_QN_ASSIST_REFINE_CYCLES_LABEL}"
  echo "assist_policy=INTODE_SOLVER_ASSIST_POLICY=${INTODE_SOLVER_ASSIST_POLICY}"
  echo "legacy_assist_enabled=unset"
  echo "certification_residual=unassisted"
  echo "final_flow=unassisted"
  echo "reverse_gate=unassisted"
  echo "metropolis_gate=unassisted"
  echo "QN_SOLVER_BACKEND=${QN_SOLVER_BACKEND}"
  echo "QN_OFFICIAL_DFOLS_PRESET=${QN_OFFICIAL_DFOLS_PRESET}"
  echo "QN_OFFICIAL_DFOLS_NPT=${QN_OFFICIAL_DFOLS_NPT}"
  echo "QN_OFFICIAL_DFOLS_MAXFUN=${QN_OFFICIAL_DFOLS_MAXFUN}"
  echo "QN_OFFICIAL_DFOLS_OBJFUN_HAS_NOISE=${QN_OFFICIAL_DFOLS_OBJFUN_HAS_NOISE}"
  echo "QN_OFFICIAL_DFOLS_RHOBEG=${QN_OFFICIAL_DFOLS_RHOBEG}"
  echo "QN_OFFICIAL_DFOLS_RHOEND=${QN_OFFICIAL_DFOLS_RHOEND}"
  echo "QN_OFFICIAL_DFOLS_MODEL_ABS_TOL=${QN_OFFICIAL_DFOLS_MODEL_ABS_TOL}"
  echo "QN_OFFICIAL_DFOLS_MODEL_REL_TOL=${QN_OFFICIAL_DFOLS_MODEL_REL_TOL}"
  echo "TLTM_OFFICIAL_DFOLS_PYTHONPATH=${TLTM_OFFICIAL_DFOLS_PYTHONPATH}"
} > "${CAND_OUT}/candidate_manifest.env"

python3 scripts/run_stage3_3_multiseed.py \
  --repo-root . \
  --config "${TLTM_QN_ASSIST_REFINE_CONFIG}" \
  --methods fb_norefine \
  --max-seeds "${TLTM_QN_ASSIST_REFINE_MAX_SEEDS}" \
  --output-subdir "${CAND_OUT}" \
  --logs-subdir "${CAND_LOG}" \
  --log-prefix "qn_assist_refine_${candidate}" \
  --report-title "QN assist npt5 refinement ${candidate} ${TLTM_QN_ASSIST_REFINE_MAX_SEEDS} seeds x ${TLTM_QN_ASSIST_REFINE_CYCLES_LABEL} cycles" \
  --schedule task \
  --task-method-order fb_first \
  --jobs "${TLTM_QN_ASSIST_REFINE_JOBS}" \
  --stage2-threads 1 \
  --eval-threads 1 \
  --skip-build \
  --allow-oversubscribe

echo "date_end=$(date -Is)" >> "${CAND_OUT}/candidate_manifest.env"
echo "[DONE] QN assist npt5 refinement candidate complete: ${candidate}"
