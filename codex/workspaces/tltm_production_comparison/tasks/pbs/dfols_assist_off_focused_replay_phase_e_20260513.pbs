#!/bin/bash
#PBS -N dfols_pe
#PBS -q C12
#PBS -l select=1:ncpus=8:mpiprocs=8:mem=24gb
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail

if [ -f /etc/profile.d/modules.sh ]; then
  # shellcheck source=/dev/null
  . /etc/profile.d/modules.sh
fi
if [ -f /usr/share/Modules/init/bash ]; then
  # shellcheck source=/dev/null
  . /usr/share/Modules/init/bash
fi
module purge
module load compiler/2025.3.0
module load mpi/2021.17
module load mkl/2025.3

: "${TLTM_WORKTREE:=/lustre1/home/cychou/TLTM_worktrees/tltm_production_comparison}"
: "${TLTM_EXPECTED_GIT_BRANCH:=codex/tltm-production-comparison-official-dfols}"
: "${TLTM_EXPECTED_GIT_COMMIT:?TLTM_EXPECTED_GIT_COMMIT is required}"
: "${TLTM_DFOLS_PHASEE_LABEL:?TLTM_DFOLS_PHASEE_LABEL is required}"
: "${TLTM_DFOLS_PHASEE_ALLOW_OVERWRITE:=0}"
: "${TLTM_DFOLS_PHASEE_SOURCE_LABEL:=dfols_assist_off_tuning_20260512_a22de1c_phaseAB_10s10k_c200s10_m5}"
: "${TLTM_DFOLS_PHASEE_JOBS:=8}"

cd "${TLTM_WORKTREE}"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
CURRENT_COMMIT="$(git rev-parse HEAD)"
if [ "${CURRENT_BRANCH}" != "${TLTM_EXPECTED_GIT_BRANCH}" ]; then
  echo "[ERROR] expected branch ${TLTM_EXPECTED_GIT_BRANCH}, got ${CURRENT_BRANCH}" >&2
  exit 2
fi
if [ "${CURRENT_COMMIT}" != "${TLTM_EXPECTED_GIT_COMMIT}" ]; then
  echo "[ERROR] expected commit ${TLTM_EXPECTED_GIT_COMMIT}, got ${CURRENT_COMMIT}" >&2
  exit 2
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "[ERROR] working tree is dirty; refusing Phase E focused replay" >&2
  git status --short >&2
  exit 2
fi
if [ ! -x bin/evaluate_btn_residual_case ]; then
  echo "[ERROR] missing bin/evaluate_btn_residual_case; run preflight build first" >&2
  exit 4
fi
if [ ! -x .venv-dfols/bin/python ]; then
  echo "[ERROR] missing .venv-dfols; run official DFO-LS preflight first" >&2
  exit 4
fi

SOURCE_ROOT="${TLTM_WORKTREE}/output/tests/dfols_assist_off_tuning/${TLTM_DFOLS_PHASEE_SOURCE_LABEL}"
SOURCE_ATTEMPTS="${SOURCE_ROOT}/attempts"
if [ ! -d "${SOURCE_ATTEMPTS}" ]; then
  echo "[ERROR] missing source attempt capture: ${SOURCE_ATTEMPTS}" >&2
  exit 4
fi

OUT_ROOT="${TLTM_WORKTREE}/output/tests/dfols_assist_off_tuning/${TLTM_DFOLS_PHASEE_LABEL}"
LOG_ROOT="${TLTM_WORKTREE}/output/logs/dfols_assist_off_tuning/${TLTM_DFOLS_PHASEE_LABEL}"
REPLAY_ROOT="${OUT_ROOT}/official_replay"
TASK_LOG_ROOT="${LOG_ROOT}/task_logs"
SUMMARY_CSV="${OUT_ROOT}/focused_summary.csv"
REPORT_MD="${OUT_ROOT}/REPORT.md"

if [ -e "${OUT_ROOT}" ] || [ -e "${LOG_ROOT}" ]; then
  if [ "${TLTM_DFOLS_PHASEE_ALLOW_OVERWRITE}" != "1" ]; then
    echo "[ERROR] output/log path exists; set TLTM_DFOLS_PHASEE_ALLOW_OVERWRITE=1 to rerun" >&2
    echo "OUT_ROOT=${OUT_ROOT}" >&2
    echo "LOG_ROOT=${LOG_ROOT}" >&2
    exit 3
  fi
  rm -rf "${OUT_ROOT}" "${LOG_ROOT}"
fi
mkdir -p "${OUT_ROOT}" "${LOG_ROOT}" "${REPLAY_ROOT}" "${TASK_LOG_ROOT}"
exec > "${LOG_ROOT}/pbs_boot.log" 2>&1

date -Is
hostname
pwd
echo "branch=${CURRENT_BRANCH}"
echo "commit=${CURRENT_COMMIT}"
echo "label=${TLTM_DFOLS_PHASEE_LABEL}"
echo "source_label=${TLTM_DFOLS_PHASEE_SOURCE_LABEL}"

DFOLS_SITE_PACKAGES="$(
  .venv-dfols/bin/python - <<'PY'
import sysconfig
print(sysconfig.get_paths()["purelib"])
PY
)"
export TLTM_OFFICIAL_DFOLS_PYTHONPATH="${DFOLS_SITE_PACKAGES}${TLTM_OFFICIAL_DFOLS_PYTHONPATH:+:${TLTM_OFFICIAL_DFOLS_PYTHONPATH}}"
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OMP_PROC_BIND=true
export OMP_PLACES=cores

cat > "${OUT_ROOT}/candidates.tsv" <<'TSV'
label	npt	maxfun	noise	rhobeg	rhoend	model_abs_tol	model_rel_tol
stable_gate77	4	250	true	0.018	1e-16	1e-30	0
rho050_m500	4	500	true	0.050	1e-16	1e-30	0
rho040_m500	4	500	true	0.040	1e-16	1e-30	0
rho065_m500	4	500	true	0.065	1e-16	1e-30	0
rho080_m500	4	500	true	0.080	1e-16	1e-30	0
rho100_m500	4	500	true	0.100	1e-16	1e-30	0
rho050_m750	4	750	true	0.050	1e-16	1e-30	0
rho065_m750	4	750	true	0.065	1e-16	1e-30	0
rho080_m750	4	750	true	0.080	1e-16	1e-30	0
rho100_m750	4	750	true	0.100	1e-16	1e-30	0
rho125_m750	4	750	true	0.125	1e-16	1e-30	0
rho050_m1000	4	1000	true	0.050	1e-16	1e-30	0
rho065_m1000	4	1000	true	0.065	1e-16	1e-30	0
rho080_m1000	4	1000	true	0.080	1e-16	1e-30	0
rho100_m1000	4	1000	true	0.100	1e-16	1e-30	0
rho125_m1000	4	1000	true	0.125	1e-16	1e-30	0
rho150_m1000	4	1000	true	0.150	1e-16	1e-30	0
npt5_rho065_m750	5	750	true	0.065	1e-16	1e-30	0
npt5_rho080_m750	5	750	true	0.080	1e-16	1e-30	0
npt6_rho050_m750	6	750	true	0.050	1e-16	1e-30	0
npt6_rho065_m750	6	750	true	0.065	1e-16	1e-30	0
npt6_rho080_m750	6	750	true	0.080	1e-16	1e-30	0
npt6_rho100_m750	6	750	true	0.100	1e-16	1e-30	0
npt0_rho065_m750	0	750	true	0.065	1e-16	1e-30	0
TSV

{
  echo "label=${TLTM_DFOLS_PHASEE_LABEL}"
  echo "date_start=$(date -Is)"
  echo "hostname=$(hostname)"
  echo "git_branch=${CURRENT_BRANCH}"
  echo "git_commit=${CURRENT_COMMIT}"
  echo "source_label=${TLTM_DFOLS_PHASEE_SOURCE_LABEL}"
  echo "source_attempts=${SOURCE_ATTEMPTS}"
  echo "assist_policy=INTODE_SOLVER_ASSIST_ENABLED=0"
  echo "replay_scope=all captured attempts"
  echo "jobs=${TLTM_DFOLS_PHASEE_JOBS}"
  echo "tltm_residual_success_tol=1e-13"
  echo "assist_on_failure_reference_32seed_50k=19579"
  echo "rho050_m500_failure_reference_32seed_50k=33872"
  echo "stable_assist_off_failure_reference_32seed_50k=67061"
  echo "tltm_official_dfols_pythonpath=${TLTM_OFFICIAL_DFOLS_PYTHONPATH}"
} > "${OUT_ROOT}/run_manifest.txt"

.venv-dfols/bin/python - "${SOURCE_ATTEMPTS}" "${OUT_ROOT}" <<'PY'
import csv
import sys
from pathlib import Path

attempt_root = Path(sys.argv[1])
out_root = Path(sys.argv[2])
rows = []
for meta_path in sorted(attempt_root.glob("*/*/qn_attempt_meta.csv")):
    case_dir = meta_path.parent
    rel = case_dir.relative_to(attempt_root)
    method = rel.parts[0]
    seed = rel.parts[1].replace("seed_", "")
    case_key = "__".join(rel.parts)
    rows.append({
        "case_key": case_key,
        "method": method,
        "seed": seed,
        "case_dir": str(case_dir),
        "meta_path": str(meta_path),
    })
if not rows:
    raise SystemExit("no qn_attempt_meta.csv files found")
with (out_root / "case_index.tsv").open("w", newline="") as handle:
    writer = csv.DictWriter(handle, fieldnames=["case_key", "method", "seed", "case_dir", "meta_path"], delimiter="\t")
    writer.writeheader()
    writer.writerows(rows)
print("[case_index] wrote {} cases".format(len(rows)))
PY

.venv-dfols/bin/python - "${OUT_ROOT}" "${REPLAY_ROOT}" "${TASK_LOG_ROOT}" "${TLTM_DFOLS_PHASEE_JOBS}" <<'PY'
import csv
import concurrent.futures
import subprocess
import sys
from pathlib import Path

out_root = Path(sys.argv[1])
replay_root = Path(sys.argv[2])
task_log_root = Path(sys.argv[3])
jobs = int(sys.argv[4])

with (out_root / "case_index.tsv").open(newline="") as handle:
    cases = list(csv.DictReader(handle, delimiter="\t"))
with (out_root / "candidates.tsv").open(newline="") as handle:
    candidates = list(csv.DictReader(handle, delimiter="\t"))

tasks = []
for candidate in candidates:
    label = candidate["label"]
    label_dir = replay_root / label
    label_dir.mkdir(parents=True, exist_ok=True)
    for case in cases:
        out_csv = label_dir / (case["case_key"] + ".csv")
        log_path = task_log_root / (label + "__" + case["case_key"] + ".log")
        tasks.append((candidate, case, out_csv, log_path))

with (out_root / "task_index.tsv").open("w", newline="") as handle:
    fieldnames = [
        "label", "case_key", "method", "seed", "npt", "maxfun", "noise",
        "rhobeg", "rhoend", "model_abs_tol", "model_rel_tol", "out_csv", "log_path",
    ]
    writer = csv.DictWriter(handle, fieldnames=fieldnames, delimiter="\t")
    writer.writeheader()
    for candidate, case, out_csv, log_path in tasks:
        row = {key: candidate[key] for key in ["label", "npt", "maxfun", "noise", "rhobeg", "rhoend", "model_abs_tol", "model_rel_tol"]}
        row.update({"case_key": case["case_key"], "method": case["method"], "seed": case["seed"], "out_csv": str(out_csv), "log_path": str(log_path)})
        writer.writerow(row)

def run_task(item):
    candidate, case, out_csv, log_path = item
    cmd = [
        sys.executable,
        "scripts/run_external_dfols_btn_compare.py",
        "--case-dir", case["case_dir"],
        "--capture-prefix", "qn_attempt",
        "--seed-source", "capture",
        "--sample-ids", "all",
        "--max-cases", "0",
        "--maxfun", candidate["maxfun"],
        "--rhobeg", candidate["rhobeg"],
        "--rhoend", candidate["rhoend"],
        "--model-abs-tol", candidate["model_abs_tol"],
        "--model-rel-tol", candidate["model_rel_tol"],
        "--residual-success-tol", "1e-13",
        "--out-csv", str(out_csv),
    ]
    if candidate["npt"] != "0":
        cmd.extend(["--npt", candidate["npt"]])
    if candidate["noise"].lower() == "true":
        cmd.append("--objfun-has-noise")
    log_path.parent.mkdir(parents=True, exist_ok=True)
    with log_path.open("w") as log:
        log.write("[CMD] {}\n".format(" ".join(cmd)))
        proc = subprocess.run(cmd, stdout=log, stderr=subprocess.STDOUT, text=True, check=False)
    if proc.returncode != 0:
        return False, candidate["label"], case["case_key"], proc.returncode
    return True, candidate["label"], case["case_key"], 0

print("[replay] candidates={} cases={} tasks={} jobs={}".format(len(candidates), len(cases), len(tasks), jobs))
failures = []
done = 0
with concurrent.futures.ThreadPoolExecutor(max_workers=jobs) as pool:
    futures = [pool.submit(run_task, task) for task in tasks]
    for future in concurrent.futures.as_completed(futures):
        ok, label, case_key, rc = future.result()
        done += 1
        if not ok:
            failures.append((label, case_key, rc))
        if done % 10 == 0 or done == len(tasks):
            print("[replay] done {}/{} failures={}".format(done, len(tasks), len(failures)), flush=True)
if failures:
    for label, case_key, rc in failures[:20]:
        print("[ERROR] task failed label={} case={} rc={}".format(label, case_key, rc))
    raise SystemExit("focused replay task failures: {}".format(len(failures)))
PY

.venv-dfols/bin/python - "${OUT_ROOT}" "${SUMMARY_CSV}" "${REPORT_MD}" <<'PY'
import csv
import math
import statistics
import sys
from pathlib import Path

out_root = Path(sys.argv[1])
summary_csv = Path(sys.argv[2])
report_md = Path(sys.argv[3])
replay_root = out_root / "official_replay"

def read_tsv(path):
    with path.open(newline="") as handle:
        return list(csv.DictReader(handle, delimiter="\t"))

cases = read_tsv(out_root / "case_index.tsv")
candidates = read_tsv(out_root / "candidates.tsv")

def safe_int(value, default=0):
    if value is None:
        return default
    text = str(value).strip()
    if not text:
        return default
    try:
        return int(text)
    except ValueError:
        try:
            return int(float(text))
        except ValueError:
            return default

def safe_float(value):
    if value is None:
        return float("nan")
    text = str(value).strip()
    if not text:
        return float("nan")
    try:
        return float(text)
    except ValueError:
        return float("nan")

def quantile(values, q):
    values = [x for x in values if math.isfinite(x)]
    if not values:
        return float("nan")
    xs = sorted(values)
    if len(xs) == 1:
        return xs[0]
    pos = (len(xs) - 1) * q
    lo = int(math.floor(pos))
    hi = int(math.ceil(pos))
    if lo == hi:
        return xs[lo]
    return xs[lo] * (hi - pos) + xs[hi] * (pos - lo)

summary_rows = []
for candidate in candidates:
    label = candidate["label"]
    attempts = 0
    successes = 0
    errors = 0
    residual_eval_errors = 0
    regressions = 0
    hard_success = 0
    embedded_converged = 0
    embedded_nonconverged = 0
    nfs = []
    finals = []
    by_seed = {}
    for case in cases:
        result_path = replay_root / label / (case["case_key"] + ".csv")
        meta_path = Path(case["meta_path"])
        with meta_path.open(newline="") as handle:
            meta_rows = {int(row["sample_idx"]): row for row in csv.DictReader(handle)}
        with result_path.open(newline="") as handle:
            result_rows = list(csv.DictReader(handle))
        seed_bucket = by_seed.setdefault(case["seed"], {"attempts": 0, "successes": 0, "errors": 0})
        for result in result_rows:
            sample_idx = int(result["sample_idx"])
            meta = meta_rows.get(sample_idx, {})
            attempts += 1
            seed_bucket["attempts"] += 1
            success = safe_int(result.get("residual_success"), 0)
            successes += success
            seed_bucket["successes"] += success
            error_text = str(result.get("error", "") or "").strip()
            if error_text:
                errors += 1
                seed_bucket["errors"] += 1
                if "residual_eval_failed" in error_text or "Bridge evaluation failed" in error_text:
                    residual_eval_errors += 1
            converged = safe_int(meta.get("converged"), 0)
            if converged == 1:
                embedded_converged += 1
                if not error_text and success != 1:
                    regressions += 1
            else:
                embedded_nonconverged += 1
                if success == 1:
                    hard_success += 1
            nf = safe_float(result.get("dfols_nf"))
            if math.isfinite(nf):
                nfs.append(nf)
            final = safe_float(result.get("final_residual_norm"))
            if math.isfinite(final):
                finals.append(final)
    seed_rates = [
        bucket["successes"] / bucket["attempts"]
        for bucket in by_seed.values()
        if bucket["attempts"]
    ]
    row = dict(candidate)
    row.update({
        "attempts": attempts,
        "residual_success": successes,
        "success_rate": "{:.8f}".format(successes / attempts if attempts else float("nan")),
        "error_count": errors,
        "residual_eval_error_count": residual_eval_errors,
        "embedded_converged": embedded_converged,
        "embedded_nonconverged": embedded_nonconverged,
        "embedded_converged_regressions": regressions,
        "hard_success": hard_success,
        "nf_mean": "{:.6g}".format(statistics.fmean(nfs) if nfs else float("nan")),
        "nf_p50": "{:.6g}".format(quantile(nfs, 0.50)),
        "nf_p90": "{:.6g}".format(quantile(nfs, 0.90)),
        "nf_p95": "{:.6g}".format(quantile(nfs, 0.95)),
        "nf_max": "{:.6g}".format(max(nfs) if nfs else float("nan")),
        "final_residual_p50": "{:.6e}".format(quantile(finals, 0.50)),
        "final_residual_p90": "{:.6e}".format(quantile(finals, 0.90)),
        "final_residual_p95": "{:.6e}".format(quantile(finals, 0.95)),
        "final_residual_max": "{:.6e}".format(max(finals) if finals else float("nan")),
        "seed_success_rate_min": "{:.8f}".format(min(seed_rates) if seed_rates else float("nan")),
        "seed_success_rate_p50": "{:.8f}".format(quantile(seed_rates, 0.50)),
        "seed_success_rate_max": "{:.8f}".format(max(seed_rates) if seed_rates else float("nan")),
    })
    summary_rows.append(row)

preferred = [
    "label", "npt", "maxfun", "noise", "rhobeg", "rhoend", "model_abs_tol", "model_rel_tol",
    "attempts", "residual_success", "success_rate", "embedded_converged_regressions",
    "error_count", "residual_eval_error_count", "hard_success", "nf_mean", "nf_p95", "nf_max",
    "final_residual_p95", "final_residual_max", "seed_success_rate_min", "seed_success_rate_p50", "seed_success_rate_max",
]
columns = preferred + sorted(set().union(*(set(row) for row in summary_rows)) - set(preferred))
with summary_csv.open("w", newline="") as handle:
    writer = csv.DictWriter(handle, fieldnames=columns)
    writer.writeheader()
    writer.writerows(summary_rows)

by_label = {row["label"]: row for row in summary_rows}
stable = by_label.get("stable_gate77")
current = by_label.get("rho050_m500")
ranked = sorted(
    summary_rows,
    key=lambda row: (
        -safe_int(row["residual_success"]),
        safe_int(row["embedded_converged_regressions"]),
        safe_int(row["error_count"]),
        float(row["nf_mean"]),
        row["label"],
    ),
)

def delta(row, ref, key):
    if not row or not ref:
        return "NA"
    return str(safe_int(row[key]) - safe_int(ref[key]))

lines = [
    "# DFO-LS Assist-Off Focused Replay Phase E",
    "",
    "Readback class: `focused_full_replay_existing_captures`",
    "",
    "Protocol:",
    "- source captures: `dfols_assist_off_tuning_20260512_a22de1c_phaseAB_10s10k_c200s10_m5`",
    "- replay scope: all captured `fb_norefine` QN attempts from 10 seeds",
    "- success gate: TLTM residual norm `<= 1e-13`",
    "- assist policy: `INTODE_SOLVER_ASSIST_ENABLED=0`",
    "- no external wrapper, rescue, multistart, or backtracking logic",
    "",
    "Hard target:",
    "- same-scale assist-on 32seed/50k `fb_norefine` failures: `19579`",
    "- current tuned `rho050_m500` 32seed/50k failures: `33872`",
    "- next embedded candidate must plausibly move toward `<= 20k` failures and preserve mean Re/Im.",
    "",
]
if stable:
    lines.extend([
        "Stable replay baseline:",
        "- successes: `{}` / `{}` (`{}`)".format(stable["residual_success"], stable["attempts"], stable["success_rate"]),
        "- errors: `{}`".format(stable["error_count"]),
        "- nf mean/p95/max: `{}` / `{}` / `{}`".format(stable["nf_mean"], stable["nf_p95"], stable["nf_max"]),
        "",
    ])
if current:
    lines.extend([
        "Current tuned replay anchor:",
        "- label: `rho050_m500`",
        "- successes: `{}` / `{}` (`{}`), delta vs stable `{}`".format(current["residual_success"], current["attempts"], current["success_rate"], delta(current, stable, "residual_success")),
        "- errors: `{}`".format(current["error_count"]),
        "- nf mean/p95/max: `{}` / `{}` / `{}`".format(current["nf_mean"], current["nf_p95"], current["nf_max"]),
        "",
    ])
best = ranked[0] if ranked else None
if best:
    lines.extend([
        "Best focused replay candidate:",
        "- label: `{}`".format(best["label"]),
        "- successes: `{}` / `{}` (`{}`), delta vs stable `{}`, delta vs rho050_m500 `{}`".format(
            best["residual_success"], best["attempts"], best["success_rate"], delta(best, stable, "residual_success"), delta(best, current, "residual_success")
        ),
        "- regressions/errors: `{}` / `{}`".format(best["embedded_converged_regressions"], best["error_count"]),
        "- hard successes: `{}`".format(best["hard_success"]),
        "- nf mean/p95/max: `{}` / `{}` / `{}`".format(best["nf_mean"], best["nf_p95"], best["nf_max"]),
        "",
    ])

lines.extend([
    "| label | success | rate | delta vs stable | delta vs rho050 | regressions | errors | hard_success | nf_mean | nf_p95 | nf_max | seed min/p50/max |",
    "|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|",
])
for row in ranked:
    lines.append(
        "| {label} | {residual_success}/{attempts} | {success_rate} | {d_stable} | {d_current} | {embedded_converged_regressions} | {error_count} | {hard_success} | {nf_mean} | {nf_p95} | {nf_max} | {seed_success_rate_min}/{seed_success_rate_p50}/{seed_success_rate_max} |".format(
            d_stable=delta(row, stable, "residual_success"),
            d_current=delta(row, current, "residual_success"),
            **row
        )
    )
report_md.write_text("\n".join(lines) + "\n")
print("[SUMMARY] wrote {}".format(summary_csv))
print("[SUMMARY] wrote {}".format(report_md))
PY

date -Is
echo "[DONE] DFO-LS assist-off focused replay Phase E complete: ${TLTM_DFOLS_PHASEE_LABEL}"
