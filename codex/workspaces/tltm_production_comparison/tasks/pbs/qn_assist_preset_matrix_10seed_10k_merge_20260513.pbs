#!/bin/bash
#PBS -N qnast_mrg
#PBS -q C12
#PBS -l select=1:ncpus=1:mpiprocs=1:mem=4gb
#PBS -l walltime=00:20:00
#PBS -j oe

set -euo pipefail

: "${TLTM_WORKTREE:=/lustre1/home/cychou/TLTM_worktrees/tltm_production_comparison}"
: "${TLTM_EXPECTED_GIT_BRANCH:=codex/tltm-production-comparison-official-dfols}"
: "${TLTM_EXPECTED_GIT_COMMIT:?TLTM_EXPECTED_GIT_COMMIT is required}"
: "${TLTM_QN_ASSIST_MATRIX_LABEL:=qn_assist_preset_matrix_20260513_6f98b5b_10s10k_v1}"
: "${TLTM_QN_ASSIST_MATRIX_EXPECTED:=28}"

cd "${TLTM_WORKTREE}"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
CURRENT_COMMIT="$(git rev-parse HEAD)"
if [ "${CURRENT_BRANCH}" != "${TLTM_EXPECTED_GIT_BRANCH}" ]; then
  echo "[ERROR] expected branch ${TLTM_EXPECTED_GIT_BRANCH}, got ${CURRENT_BRANCH}" >&2
  exit 2
fi
if [ "${CURRENT_COMMIT}" != "${TLTM_EXPECTED_GIT_COMMIT}" ]; then
  echo "[ERROR] expected commit ${TLTM_EXPECTED_GIT_COMMIT}, got ${CURRENT_COMMIT}" >&2
  exit 2
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "[ERROR] working tree is dirty; refusing QN-assist preset matrix merge" >&2
  git status --short >&2
  exit 2
fi

OUT_ROOT="output/tests/qn_assist_preset_matrix/${TLTM_QN_ASSIST_MATRIX_LABEL}"
LOG_ROOT="output/logs/qn_assist_preset_matrix/${TLTM_QN_ASSIST_MATRIX_LABEL}"
mkdir -p "${OUT_ROOT}" "${LOG_ROOT}"
exec > "${LOG_ROOT}/merge.pbs.log" 2>&1

python3 - <<'PY'
import csv
import os
from pathlib import Path

label = os.environ["TLTM_QN_ASSIST_MATRIX_LABEL"]
expected = int(os.environ.get("TLTM_QN_ASSIST_MATRIX_EXPECTED", "28"))
root = Path("output/tests/qn_assist_preset_matrix") / label
candidates_root = root / "candidates"

def read_env(path):
    data = {}
    if not path.exists():
        return data
    for line in path.read_text().splitlines():
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        data[key.strip()] = value.strip()
    return data

rows = []
missing = []
for cand_dir in sorted(candidates_root.glob("*")):
    if not cand_dir.is_dir():
        continue
    manifest = read_env(cand_dir / "candidate_manifest.env")
    candidate = manifest.get("candidate", cand_dir.name)
    agg_path = cand_dir / "aggregated_summary_table.csv"
    per_seed_path = cand_dir / "per_seed_summary_table.csv"
    if not agg_path.exists():
        legacy_agg = cand_dir / "fb_norefine" / "aggregated_summary_table.csv"
        legacy_per_seed = cand_dir / "fb_norefine" / "per_seed_summary_table.csv"
        if legacy_agg.exists():
            agg_path = legacy_agg
            per_seed_path = legacy_per_seed
    if not agg_path.exists():
        missing.append(candidate)
        continue
    with agg_path.open(newline="") as handle:
        agg_rows = list(csv.DictReader(handle))
    if len(agg_rows) != 1:
        raise SystemExit("expected one aggregate row in {0}, got {1}".format(agg_path, len(agg_rows)))
    row = dict(agg_rows[0])
    row.update({
        "candidate": candidate,
        "array_index": manifest.get("array_index", ""),
        "npt": manifest.get("QN_OFFICIAL_DFOLS_NPT", ""),
        "maxfun": manifest.get("QN_OFFICIAL_DFOLS_MAXFUN", ""),
        "objfun_has_noise": manifest.get("QN_OFFICIAL_DFOLS_OBJFUN_HAS_NOISE", ""),
        "rhobeg": manifest.get("QN_OFFICIAL_DFOLS_RHOBEG", ""),
        "rhoend": manifest.get("QN_OFFICIAL_DFOLS_RHOEND", ""),
        "model_abs_tol": manifest.get("QN_OFFICIAL_DFOLS_MODEL_ABS_TOL", ""),
        "model_rel_tol": manifest.get("QN_OFFICIAL_DFOLS_MODEL_REL_TOL", ""),
        "assist_policy": manifest.get("assist_policy", ""),
        "legacy_assist_enabled": manifest.get("legacy_assist_enabled", ""),
        "candidate_manifest": str(cand_dir / "candidate_manifest.env"),
        "aggregate_path": str(agg_path),
        "per_seed_path": str(per_seed_path),
    })
    if per_seed_path.exists():
        with per_seed_path.open(newline="") as handle:
            row["per_seed_rows"] = str(sum(1 for _ in csv.DictReader(handle)))
    else:
        row["per_seed_rows"] = "0"
    rows.append(row)

if len(rows) != expected:
    print("[WARN] expected {0} candidate rows, found {1}".format(expected, len(rows)))
if missing:
    print("[WARN] missing aggregate for candidates: {0}".format(",".join(missing)))

def fnum(row, key, default=0.0):
    try:
        return float(row.get(key, default))
    except (TypeError, ValueError):
        return default

rows.sort(key=lambda r: (
    fnum(r, "total_unresolved_failure_count", 1e99),
    abs(fnum(r, "mean_Ohat_re", 1e99)) + abs(fnum(r, "mean_Ohat_im", 1e99)),
    fnum(r, "mean_runtime_total", 1e99),
))

preferred = [
    "candidate",
    "array_index",
    "npt",
    "rhobeg",
    "maxfun",
    "objfun_has_noise",
    "n_seeds",
    "per_seed_rows",
    "mean_Ohat_re",
    "mean_Ohat_im",
    "Zmean_re",
    "Zmean_im",
    "total_unresolved_failure_count",
    "total_reverse_gate_total_reject_count",
    "P68_re",
    "P95_re",
    "P68_im",
    "P95_im",
    "mean_runtime_total",
    "total_quasi_success_count",
    "total_quasi_attempt_count",
    "total_qn_eval_flow_solver_assist_count",
    "total_newton_eval_flow_solver_assist_count",
    "assist_policy",
    "legacy_assist_enabled",
    "aggregate_path",
    "per_seed_path",
]
columns = preferred + sorted(set().union(*(set(r) for r in rows)) - set(preferred)) if rows else preferred

summary_path = root / "matrix_summary.csv"
with summary_path.open("w", newline="") as handle:
    writer = csv.DictWriter(handle, fieldnames=columns, extrasaction="ignore")
    writer.writeheader()
    writer.writerows(rows)

top = rows[:10]
lines = [
    "# QN Assist Preset Matrix 10seed/10k Readback",
    "",
    "Label: `{0}`".format(label),
    "",
    "Purpose:",
    "- test QN+assist preset ranking without assuming assist-off tuning winners transfer;",
    "- screen `npt`, `rhobeg`, `maxfun`, and `objfun_has_noise` under the formalized QN navigation-assist contract;",
    "- run `fb_norefine` only because `no_fb` is not informative for QN fallback preset ranking.",
    "",
    "Fixed contract:",
    "- `NT strict -> QN navigation assist -> unassisted certification -> strict final flow -> RG -> Metropolis`",
    "- `t=0.35,L=2,nstep=20`, 10 seeds x 10000 cycles",
    "- RG on, p28, `cttol=1e-13`, `QN_QUASI_TOL_OVERRIDE=1e-13`",
    "",
    "Rows found: `{0}` / expected `{1}`.".format(len(rows), expected),
    "",
    "Top candidates by unresolved failures, then mean magnitude, then runtime:",
    "",
    "| rank | candidate | npt | rhobeg | maxfun | noise | failures | RG rejects | mean Re | mean Im | Zmean Re | Zmean Im | runtime |",
    "|---:|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|",
]
for idx, row in enumerate(top, 1):
    lines.append(
        "| {idx} | {candidate} | {npt} | {rhobeg} | {maxfun} | {noise} | {failures} | {rg} | {mean_re} | {mean_im} | {zre} | {zim} | {runtime} |".format(
            idx=idx,
            candidate=row.get("candidate", ""),
            npt=row.get("npt", ""),
            rhobeg=row.get("rhobeg", ""),
            maxfun=row.get("maxfun", ""),
            noise=row.get("objfun_has_noise", ""),
            failures=row.get("total_unresolved_failure_count", ""),
            rg=row.get("total_reverse_gate_total_reject_count", ""),
            mean_re=row.get("mean_Ohat_re", ""),
            mean_im=row.get("mean_Ohat_im", ""),
            zre=row.get("Zmean_re", ""),
            zim=row.get("Zmean_im", ""),
            runtime=row.get("mean_runtime_total", ""),
        )
    )

lines.extend([
    "",
    "Artifacts:",
    "- `matrix_summary.csv`",
    "- per-candidate `candidate_manifest.env`",
    "- per-candidate `aggregated_summary_table.csv` and `per_seed_summary_table.csv`",
])
if missing:
    lines.extend(["", "Missing aggregate candidates:", "- `{0}`".format("`, `".join(missing))])

report_path = root / "REPORT.md"
report_path.write_text("\n".join(lines) + "\n")
print("[matrix] wrote {0}".format(summary_path))
print("[matrix] wrote {0}".format(report_path))

if len(rows) != expected or missing:
    raise SystemExit(5)
PY

echo "[DONE] QN assist preset matrix merge complete: ${TLTM_QN_ASSIST_MATRIX_LABEL}"
