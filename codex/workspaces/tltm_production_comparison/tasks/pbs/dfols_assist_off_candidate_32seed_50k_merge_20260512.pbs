#!/bin/bash
#PBS -N dfols_dmg
#PBS -q C8
#PBS -l select=1:ncpus=1:mpiprocs=1:mem=4gb
#PBS -l walltime=00:30:00
#PBS -j oe

set -euo pipefail

: "${TLTM_WORKTREE:=/lustre1/home/cychou/TLTM_worktrees/tltm_production_comparison}"
: "${TLTM_EXPECTED_GIT_BRANCH:=codex/tltm-production-comparison-official-dfols}"
: "${TLTM_EXPECTED_GIT_COMMIT:?TLTM_EXPECTED_GIT_COMMIT is required}"
: "${TLTM_DFOLS_PHASED_LABEL:?TLTM_DFOLS_PHASED_LABEL is required}"
: "${TLTM_DFOLS_PHASED_CONFIG:=docs/production_comparison_official_dfols_20260511_32seed_50k_nofb_withfb.json}"
: "${TLTM_DFOLS_PHASED_CANDIDATE:=rho050_m500}"
: "${TLTM_DFOLS_PHASED_CHUNKS_PER_METHOD:=4}"
: "${TLTM_DFOLS_PHASED_EXPECTED_ROWS:=32}"
: "${QN_OFFICIAL_DFOLS_NPT:=4}"
: "${QN_OFFICIAL_DFOLS_MAXFUN:=500}"
: "${QN_OFFICIAL_DFOLS_OBJFUN_HAS_NOISE:=1}"
: "${QN_OFFICIAL_DFOLS_RHOBEG:=0.050}"
: "${QN_OFFICIAL_DFOLS_RHOEND:=1e-16}"
: "${QN_OFFICIAL_DFOLS_MODEL_ABS_TOL:=1e-30}"
: "${QN_OFFICIAL_DFOLS_MODEL_REL_TOL:=0}"

cd "${TLTM_WORKTREE}"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
CURRENT_COMMIT="$(git rev-parse HEAD)"
if [ "${CURRENT_BRANCH}" != "${TLTM_EXPECTED_GIT_BRANCH}" ]; then
  echo "[ERROR] expected branch ${TLTM_EXPECTED_GIT_BRANCH}, got ${CURRENT_BRANCH}" >&2
  exit 2
fi
if [ "${CURRENT_COMMIT}" != "${TLTM_EXPECTED_GIT_COMMIT}" ]; then
  echo "[ERROR] expected commit ${TLTM_EXPECTED_GIT_COMMIT}, got ${CURRENT_COMMIT}" >&2
  exit 2
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "[ERROR] working tree is dirty; refusing DFO-LS assist-off Phase D merge" >&2
  git status --short >&2
  exit 2
fi

ROOT="output/tests/dfols_assist_off_tuning/${TLTM_DFOLS_PHASED_LABEL}"
STAGE_ROOT="${ROOT}/stage"
mkdir -p "${ROOT}"

python3 scripts/merge_stage3_multiseed_chunks.py \
  --repo-root . \
  --config "${TLTM_DFOLS_PHASED_CONFIG}" \
  --output-subdir "${STAGE_ROOT}/no_fb" \
  --chunk-glob "chunk_*" \
  --log-prefix "dfols_assist_off_${TLTM_DFOLS_PHASED_CANDIDATE}_32s50k_no_fb" \
  --report-title "DFO-LS assist-off ${TLTM_DFOLS_PHASED_CANDIDATE} 32seed 50k no_fb" \
  --expected-rows "${TLTM_DFOLS_PHASED_EXPECTED_ROWS}" \
  --jobs-label "${TLTM_DFOLS_PHASED_CHUNKS_PER_METHOD} chunks x 8 workers" \
  --requested-cpus 32

python3 scripts/merge_stage3_multiseed_chunks.py \
  --repo-root . \
  --config "${TLTM_DFOLS_PHASED_CONFIG}" \
  --output-subdir "${STAGE_ROOT}/fb_norefine" \
  --chunk-glob "chunk_*" \
  --log-prefix "dfols_assist_off_${TLTM_DFOLS_PHASED_CANDIDATE}_32s50k_fb_norefine" \
  --report-title "DFO-LS assist-off ${TLTM_DFOLS_PHASED_CANDIDATE} 32seed 50k fb_norefine" \
  --expected-rows "${TLTM_DFOLS_PHASED_EXPECTED_ROWS}" \
  --jobs-label "${TLTM_DFOLS_PHASED_CHUNKS_PER_METHOD} chunks x 8 workers" \
  --requested-cpus 32

export TLTM_DFOLS_PHASED_LABEL
export TLTM_DFOLS_PHASED_CANDIDATE
export TLTM_DFOLS_PHASED_CONFIG
export QN_OFFICIAL_DFOLS_NPT
export QN_OFFICIAL_DFOLS_MAXFUN
export QN_OFFICIAL_DFOLS_OBJFUN_HAS_NOISE
export QN_OFFICIAL_DFOLS_RHOBEG
export QN_OFFICIAL_DFOLS_RHOEND
export QN_OFFICIAL_DFOLS_MODEL_ABS_TOL
export QN_OFFICIAL_DFOLS_MODEL_REL_TOL
python3 - <<'PY'
import csv
import os
from pathlib import Path

label = os.environ["TLTM_DFOLS_PHASED_LABEL"]
candidate = os.environ["TLTM_DFOLS_PHASED_CANDIDATE"]
config = os.environ["TLTM_DFOLS_PHASED_CONFIG"]
root = Path("output/tests/dfols_assist_off_tuning") / label
stage_root = root / "stage"
sets = [
    ("nofb", "no_fb", stage_root / "no_fb"),
    ("withfb", "fb_norefine", stage_root / "fb_norefine"),
]

rows = []
per_seed_counts = {}
for canonical, raw, subroot in sets:
    agg_path = subroot / "aggregated_summary_table.csv"
    per_seed_path = subroot / "per_seed_summary_table.csv"
    if not agg_path.exists():
        raise SystemExit("missing aggregate: {0}".format(agg_path))
    if not per_seed_path.exists():
        raise SystemExit("missing per-seed table: {0}".format(per_seed_path))
    with agg_path.open(newline="") as handle:
        agg_rows = list(csv.DictReader(handle))
    if len(agg_rows) != 1:
        raise SystemExit("expected one aggregate row in {0}, got {1}".format(agg_path, len(agg_rows)))
    row = dict(agg_rows[0])
    row["canonical_method"] = canonical
    row["raw_method"] = raw
    rows.append(row)
    with per_seed_path.open(newline="") as handle:
        per_seed_counts[canonical] = sum(1 for _ in csv.DictReader(handle))

preferred = [
    "canonical_method",
    "raw_method",
    "method",
    "n_seeds",
    "P68_re",
    "P95_re",
    "P68_im",
    "P95_im",
    "mean_Ohat_re",
    "mean_Ohat_im",
    "std_Ohat_re",
    "std_Ohat_im",
    "Zmean_re",
    "Zmean_im",
    "total_unresolved_failure_count",
    "total_reverse_gate_total_reject_count",
    "mean_runtime_total",
    "total_post_refine_skip_count",
    "total_post_refine_success_count",
    "total_post_refine_attempt_count",
]
columns = preferred + sorted(set().union(*(set(r) for r in rows)) - set(preferred))
with (root / "combined_summary_table.csv").open("w", newline="") as handle:
    writer = csv.DictWriter(handle, fieldnames=columns, extrasaction="ignore")
    writer.writeheader()
    writer.writerows(rows)

by = {row["canonical_method"]: row for row in rows}
nofb = by["nofb"]
withfb = by["withfb"]

def f(row, key, default=""):
    return row.get(key, default)

def num(row, key):
    return float(row[key])

def integer_delta(key):
    return int(float(withfb[key])) - int(float(nofb[key]))

lines = [
    "# DFO-LS Assist-Off Candidate 32seed/50k Confirmation",
    "",
    "Campaign: `{0}`".format(label),
    "",
    "Candidate: `{0}`".format(candidate),
    "",
    "Setup:",
    "- physical point: `t=0.35,L=2,nstep=20`",
    "- scale: `32 seeds x 50000 cycles` per method",
    "- config: `{0}`".format(config),
    "- backend: `QN_SOLVER_BACKEND=official_dfols`, `QN_OFFICIAL_DFOLS_PRESET=stable_gate77`",
    "- assist policy: `INTODE_SOLVER_ASSIST_ENABLED=0`",
    "- candidate params: `npt={0}`, `maxfun={1}`, `noise={2}`, `rhobeg={3}`, `rhoend={4}`, `model.abs_tol={5}`, `model.rel_tol={6}`".format(
        os.environ["QN_OFFICIAL_DFOLS_NPT"],
        os.environ["QN_OFFICIAL_DFOLS_MAXFUN"],
        os.environ["QN_OFFICIAL_DFOLS_OBJFUN_HAS_NOISE"],
        os.environ["QN_OFFICIAL_DFOLS_RHOBEG"],
        os.environ["QN_OFFICIAL_DFOLS_RHOEND"],
        os.environ["QN_OFFICIAL_DFOLS_MODEL_ABS_TOL"],
        os.environ["QN_OFFICIAL_DFOLS_MODEL_REL_TOL"],
    ),
    "- raw/canonical mapping: `no_fb -> nofb`, `fb_norefine -> withfb`",
    "",
    "| canonical | raw | n_seeds | P68 Re | P95 Re | P68 Im | P95 Im | mean Re<O> | mean Im<O> | std Re<O> | std Im<O> | Zmean Re<O> | Zmean Im<O> | failure | rev_rej | runtime | post-refine |",
    "|---|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|",
]
for row in rows:
    post = "{0}/{1}".format(f(row, "total_post_refine_success_count", "0"), f(row, "total_post_refine_attempt_count", "0"))
    lines.append(
        "| {canonical_method} | {raw_method} | {n_seeds} | {P68_re} | {P95_re} | {P68_im} | {P95_im} | {mean_Ohat_re} | {mean_Ohat_im} | {std_Ohat_re} | {std_Ohat_im} | {Zmean_re} | {Zmean_im} | {total_unresolved_failure_count} | {total_reverse_gate_total_reject_count} | {mean_runtime_total} | {post} |".format(post=post, **row)
    )

lines.extend([
    "",
    "Direct comparison `withfb - nofb`:",
    "- mean shift: Re `{0:+.6g}`, Im `{1:+.6g}`".format(num(withfb, "mean_Ohat_re") - num(nofb, "mean_Ohat_re"), num(withfb, "mean_Ohat_im") - num(nofb, "mean_Ohat_im")),
    "- Zmean shift: Re `{0:+.6g}`, Im `{1:+.6g}`".format(num(withfb, "Zmean_re") - num(nofb, "Zmean_re"), num(withfb, "Zmean_im") - num(nofb, "Zmean_im")),
    "- unresolved failures: `{0}`".format(integer_delta("total_unresolved_failure_count")),
    "- reverse-gate rejects: `{0}`".format(integer_delta("total_reverse_gate_total_reject_count")),
    "- mean runtime: `{0:+.6g}` seconds".format(num(withfb, "mean_runtime_total") - num(nofb, "mean_runtime_total")),
    "",
    "Per-seed row counts:",
    "- `nofb`: `{0}`".format(per_seed_counts["nofb"]),
    "- `withfb`: `{0}`".format(per_seed_counts["withfb"]),
    "",
    "Artifacts:",
    "- `combined_summary_table.csv`",
    "- per-method `aggregated_summary_table.csv`, `per_seed_summary_table.csv`, and method report files under `stage/`",
])

(root / "REPORT.md").write_text("\n".join(lines) + "\n")
print("[combined] wrote {0}".format(root / "combined_summary_table.csv"))
print("[combined] wrote {0}".format(root / "REPORT.md"))
PY

echo "[DONE] DFO-LS assist-off Phase D merge complete: ${TLTM_DFOLS_PHASED_LABEL}"
