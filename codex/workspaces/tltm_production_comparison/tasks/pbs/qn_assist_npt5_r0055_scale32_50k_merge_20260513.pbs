#!/bin/bash
#PBS -N qn55_32m
#PBS -q C8
#PBS -l select=1:ncpus=1:mpiprocs=1:mem=4gb
#PBS -l walltime=01:00:00
#PBS -j oe

set -euo pipefail

: "${TLTM_WORKTREE:=/lustre1/home/cychou/TLTM_worktrees/tltm_production_comparison}"
: "${TLTM_EXPECTED_GIT_BRANCH:=codex/tltm-production-comparison-official-dfols}"
: "${TLTM_EXPECTED_GIT_COMMIT:?TLTM_EXPECTED_GIT_COMMIT is required}"
: "${TLTM_CAMPAIGN:=qn_assist_npt5_r0055_scale32_20260513_6f98b5b_32seed_50000cyc_t035_L2_nstep20_v3}"
: "${TLTM_CONFIG_JSON:=docs/production_comparison_official_dfols_20260511_32seed_50k_nofb_withfb.json}"

cd "${TLTM_WORKTREE}"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
CURRENT_COMMIT="$(git rev-parse HEAD)"
if [ "${CURRENT_BRANCH}" != "${TLTM_EXPECTED_GIT_BRANCH}" ]; then
  echo "[ERROR] expected branch ${TLTM_EXPECTED_GIT_BRANCH}, got ${CURRENT_BRANCH}" >&2
  exit 2
fi
if [ "${CURRENT_COMMIT}" != "${TLTM_EXPECTED_GIT_COMMIT}" ]; then
  echo "[ERROR] expected commit ${TLTM_EXPECTED_GIT_COMMIT}, got ${CURRENT_COMMIT}" >&2
  exit 2
fi
if [ -n "$(git status --porcelain)" ]; then
  echo "[ERROR] working tree is dirty; refusing npt5_r0055_m500 scale-up merge" >&2
  git status --short >&2
  exit 2
fi

ROOT="output/production_comparison/qn_assist_npt5_r0055_scale32/${TLTM_CAMPAIGN}"
LOG_ROOT="output/logs/production_comparison/qn_assist_npt5_r0055_scale32/${TLTM_CAMPAIGN}/merge"
mkdir -p "${ROOT}" "${LOG_ROOT}"
exec > "${LOG_ROOT}/pbs_boot.log" 2>&1

python3 scripts/merge_stage3_multiseed_chunks.py \
  --repo-root . \
  --config "${TLTM_CONFIG_JSON}" \
  --output-subdir "${ROOT}/fb_norefine" \
  --chunk-glob "chunk_*" \
  --log-prefix "pc_qn_npt5_r0055_m500_32seed_50k" \
  --report-title "QN assist npt5_r0055_m500 32seed 50k fb_norefine" \
  --expected-rows 32 \
  --jobs-label "4 chunks x 8 workers" \
  --requested-cpus 32

python3 - <<'PY'
import csv
import os
from pathlib import Path

campaign = os.environ["TLTM_CAMPAIGN"]
root = Path("output/production_comparison/qn_assist_npt5_r0055_scale32") / campaign
agg_path = root / "fb_norefine" / "aggregated_summary_table.csv"
per_seed_path = root / "fb_norefine" / "per_seed_summary_table.csv"
if not agg_path.exists():
    raise SystemExit("missing aggregate: {0}".format(agg_path))
with agg_path.open(newline="") as handle:
    rows = list(csv.DictReader(handle))
if len(rows) != 1:
    raise SystemExit("expected one aggregate row, got {0}".format(len(rows)))
row = rows[0]
with per_seed_path.open(newline="") as handle:
    per_seed_count = sum(1 for _ in csv.DictReader(handle))

preferred = [
    "canonical_method",
    "raw_method",
    "method",
    "n_seeds",
    "P68_re",
    "P95_re",
    "P68_im",
    "P95_im",
    "mean_Ohat_re",
    "mean_Ohat_im",
    "std_Ohat_re",
    "std_Ohat_im",
    "Zmean_re",
    "Zmean_im",
    "total_unresolved_failure_count",
    "total_reverse_gate_total_reject_count",
    "mean_runtime_total",
]
row["canonical_method"] = "withfb"
row["raw_method"] = "fb_norefine"
columns = preferred + sorted(set(row) - set(preferred))
with (root / "combined_summary_table.csv").open("w", newline="") as handle:
    writer = csv.DictWriter(handle, fieldnames=columns, extrasaction="ignore")
    writer.writeheader()
    writer.writerow(row)

failures = int(float(row["total_unresolved_failure_count"]))
old_assist = 19579
assist_off_tuned = 33872
lines = [
    "# QN Assist npt5_r0055_m500 Scale-Up Readback",
    "",
    "Campaign: `{0}`".format(campaign),
    "",
    "Setup:",
    "- method: `fb_norefine` / canonical `withfb` only",
    "- scale: `32 seeds x 50000 cycles`",
    "- QN preset: `stable_gate77` with `npt=5`, `rhobeg=0.055`, `maxfun=500`, `objfun_has_noise=1`",
    "- assist policy: `nt_strict_qn_navassist_cert_strict_rg_metropolis_v1`",
    "- ODEX sequence: default current IWORK3",
    "",
    "| canonical | raw | n_seeds | mean Re<O> | mean Im<O> | Zmean Re<O> | Zmean Im<O> | failures | RG rejects | runtime |",
    "|---|---|---:|---:|---:|---:|---:|---:|---:|---:|",
    "| {canonical_method} | {raw_method} | {n_seeds} | {mean_Ohat_re} | {mean_Ohat_im} | {Zmean_re} | {Zmean_im} | {total_unresolved_failure_count} | {total_reverse_gate_total_reject_count} | {mean_runtime_total} |".format(**row),
    "",
    "Failure references:",
    "- old assist-on same-scale reference: `{0}`; candidate minus reference: `{1:+d}`".format(old_assist, failures - old_assist),
    "- assist-off tuned same-scale reference: `{0}`; candidate minus reference: `{1:+d}`".format(assist_off_tuned, failures - assist_off_tuned),
    "",
    "Per-seed row count: `{0}`".format(per_seed_count),
    "",
    "Artifacts:",
    "- `combined_summary_table.csv`",
    "- `fb_norefine/aggregated_summary_table.csv`",
    "- `fb_norefine/per_seed_summary_table.csv`",
]
(root / "REPORT.md").write_text("\n".join(lines) + "\n")
print("[combined] wrote {0}".format(root / "combined_summary_table.csv"))
print("[combined] wrote {0}".format(root / "REPORT.md"))
PY

echo "[DONE] npt5_r0055_m500 scale-up merge complete: ${TLTM_CAMPAIGN}"
