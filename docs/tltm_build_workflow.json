    "exchange_probability_spec": {
      "recommended_log_form": {
        "effective_energy": "E_t(x) = ReS(z_t(x)) - log|detJ_t(x)|",
        "delta": "Delta = E_ta(y) + E_tb(x) - E_ta(x) - E_tb(y)",
        "accept": "acc = min(1, exp(-Delta))"
      },
      "hard_reject_conditions": [
        "flow failure in any required swapped evaluation",
        "log_determinant failure in any required Jacobian"
      ]
    },
