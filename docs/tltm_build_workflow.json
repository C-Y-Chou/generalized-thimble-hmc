          "stage-2.5 uses stage-2 mechanism as-is",
          "stage-2.5 does not re-implement swap/label/round-trip core"
        ]
      },
      "handoff_contract": {
        "stage_2_outputs_required_by_stage_2p5": [
          "per-pair proposal/accept/reject/accept_rate",
          "per-label current_slot",
          "per-label farthest_slot_reached",
          "round_trip_count",
          "swap-enabled and swap-disabled run modes"
        ],
        "status": "ready"
      }
