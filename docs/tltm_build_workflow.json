        "fix one global local-update parameter set",
        "run candidate ladders near low-flow bottleneck",
        "compare pairwise acceptance and label transport"
      ],
      "stage2p5_long_check": [
        "extend cycles on 1-2 promising ladders",
        "check hot-end reachability and round-trip emergence",
