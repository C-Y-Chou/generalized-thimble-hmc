      "task_method_order": "fb_first",
      "array_chunks": "2 methods x 32 chunks",
      "seeds_per_chunk": 32,
      "jobs_per_chunk": 32,
      "stage2_threads": 1,
      "eval_threads": 1,
      "output_subdir": "output/tests/stage3_4/probe_only_1024seed_200k_t035",
